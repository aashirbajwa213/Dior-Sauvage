    <script is:inline define:vars={{ AI_PROVIDERS, providerConfigs }}>
        document.addEventListener("DOMContentLoaded", () => {
            // Main page elements
            const providerCards = document.querySelectorAll(".ai-provider-card");
            const activeProviderInput = document.getElementById("active_llm_provider");
            const activeProviderLabel = document.getElementById("active_provider_label");
            const openActiveConfigBtn = document.getElementById("open_active_config_btn");
            const tempSlider = document.getElementById("temp_slider");
            const tempDisplay = document.getElementById("temp_display");

            // Modal elements
            const modal = document.getElementById("provider_config_modal");
            const modalCloseBtn = document.getElementById("modal_close_btn");
            const modalCancelBtn = document.getElementById("modal_cancel_btn");
            const modalProviderId = document.getElementById("modal_provider_id");
            const modalTitle = document.getElementById("modal_provider_title");
            const modalBadge = document.getElementById("modal_provider_badge");
            const modalIcon = document.getElementById("modal_provider_icon");
            const modalApiKey = document.getElementById("modal_api_key");
            const modalKeyStatus = document.getElementById("modal_key_status");
            const modalToggleKeyBtn = document.getElementById("modal_toggle_key_btn");
            const modalEndpointContainer = document.getElementById("modal_endpoint_container");
            const modalEndpoint = document.getElementById("modal_endpoint");
            const modalModel = document.getElementById("modal_model");
            const modalFreeFilterContainer = document.getElementById("modal_free_filter_container");
            const modalFreeOnlyToggle = document.getElementById("modal_free_only_toggle");
            const modalQuickPresets = document.getElementById("modal_quick_presets");
            const modalFetchBtn = document.getElementById("modal_fetch_models_btn");
            const modalFetchIcon = document.getElementById("modal_fetch_icon");
            const modalFetchSpinner = document.getElementById("modal_fetch_spinner");
            const modalFetchedContainer = document.getElementById("modal_fetched_models_container");
            const modalFetchedDropdown = document.getElementById("modal_models_dropdown");
            const modalModelsCount = document.getElementById("modal_models_count");
            const modalTestBtn = document.getElementById("modal_test_conn_btn");
            const modalTestIcon = document.getElementById("modal_test_icon");
            const modalTestSpinner = document.getElementById("modal_test_spinner");
            const modalTestResult = document.getElementById("modal_test_result");
            const modalTestIndicator = document.getElementById("modal_test_indicator");
            const modalMakeActive = document.getElementById("modal_make_active");

            // Fallback Priority Sequence Elements
            const fallbackPrimaryName = document.getElementById("fallback_primary_name");
            const fallbackItemsList = document.getElementById("fallback_items_list");
            const fallbackJsonInput = document.getElementById("chatbot_fallback_providers_json");

            let currentModalProviderId = "openrouter";
            let rawFetchedModels = [];

            // Provider Icon SVGs
            const PROVIDER_ICONS = {
                openrouter: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z" /></svg>`,
                gemini: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
                groq: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
                openai: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 1v3m6-3v3m-6 17v3m6-3v3M1 9h3m-3 6h3m17-6h3m-3 6h3" /></svg>`,
                custom: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" /><rect x="2" y="14" width="20" height="8" rx="2" /><line x1="6" y1="6" x2="6.01" y2="6" stroke-width="3" /><line x1="6" y1="18" x2="6.01" y2="18" stroke-width="3" /></svg>`
            };

            // Fallback Priority Sequence State
            let savedEnabledFallbacks = null;
            try {
                if (fallbackJsonInput && fallbackJsonInput.value) {
                    const parsed = JSON.parse(fallbackJsonInput.value);
                    if (Array.isArray(parsed)) {
                        savedEnabledFallbacks = parsed;
                    }
                }
            } catch (_) {}

            let activeP = activeProviderInput ? activeProviderInput.value : "openrouter";
            let lastActiveProvider = activeP;

            // Track enabled fallback providers
            const enabledSet = new Set();
            if (savedEnabledFallbacks !== null) {
                savedEnabledFallbacks.forEach(id => {
                    if (id !== activeP) enabledSet.add(id);
                });
            } else {
                // Default: all other providers enabled
                AI_PROVIDERS.forEach(p => {
                    if (p.id !== activeP) enabledSet.add(p.id);
                });
            }

            // Visual order: start with saved enabled ones, then add any remaining providers
            const allOtherPids = AI_PROVIDERS.map(p => p.id).filter(id => id !== activeP);
            let fallbackOrder = (savedEnabledFallbacks && savedEnabledFallbacks.length > 0)
                ? savedEnabledFallbacks.filter(id => allOtherPids.includes(id))
                : ["groq", "custom", "gemini", "openai"].filter(id => allOtherPids.includes(id));

            allOtherPids.forEach(id => {
                if (!fallbackOrder.includes(id)) {
                    fallbackOrder.push(id);
                }
            });

            function syncFallbackJson() {
                if (!fallbackJsonInput) return;
                const currentActive = activeProviderInput ? activeProviderInput.value : "openrouter";
                // Only include enabled items in the order they appear in DOM rows
                const enabledItems = [];
                const rows = fallbackItemsList ? fallbackItemsList.querySelectorAll(".fallback-item-row") : [];
                rows.forEach(row => {
                    const pid = row.getAttribute("data-fallback-id");
                    const chk = row.querySelector(".fallback-toggle-chk");
                    if (pid && pid !== currentActive && chk && chk.checked) {
                        enabledItems.push(pid);
                    }
                });
                fallbackJsonInput.value = JSON.stringify(enabledItems);
            }

            function renderFallbackSequence() {
                if (!fallbackItemsList) return;
                const currentActive = activeProviderInput ? activeProviderInput.value : "openrouter";

                // If active provider changed
                if (currentActive !== lastActiveProvider) {
                    enabledSet.delete(currentActive);
                    if (!fallbackOrder.includes(lastActiveProvider)) {
                        fallbackOrder.unshift(lastActiveProvider);
                    }
                    enabledSet.add(lastActiveProvider);
                    lastActiveProvider = currentActive;
                }

                // Update primary slot name
                const primaryObj = AI_PROVIDERS.find(p => p.id === currentActive);
                if (fallbackPrimaryName && primaryObj) {
                    fallbackPrimaryName.textContent = primaryObj.name;
                }

                // Make sure fallbackOrder has all providers except active provider
                const candidatePids = AI_PROVIDERS.map(p => p.id).filter(id => id !== currentActive);
                const currentFiltered = fallbackOrder.filter(id => id !== currentActive && candidatePids.includes(id));
                candidatePids.forEach(id => {
                    if (!currentFiltered.includes(id)) {
                        currentFiltered.push(id);
                    }
                });
                fallbackOrder = currentFiltered;

                fallbackItemsList.innerHTML = "";

                fallbackOrder.forEach((pid, idx) => {
                    const pObj = AI_PROVIDERS.find(p => p.id === pid);
                    if (!pObj) return;
                    const pConf = (providerConfigs && providerConfigs[pid]) || {};
                    const isConfigured = Boolean(pConf.hasKey || (pid === "custom" && pConf.endpoint));
                    const isError = pConf.status === "error";
                    const isEnabled = enabledSet.has(pid);

                    const row = document.createElement("div");
                    row.className = `fallback-item-row flex items-center justify-between p-3 rounded-xl border shadow-2xs transition-all ${
                        isEnabled
                            ? "bg-white border-gray-200 hover:border-gray-300"
                            : "bg-gray-50/70 border-dashed border-gray-200 opacity-60"
                    }`;
                    row.setAttribute("data-fallback-id", pid);

                    const statusBadgeHtml = isError
                        ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-50 text-red-700 border border-red-200">Error</span>`
                        : isConfigured
                        ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Ready</span>`
                        : `<span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-500">Needs Key</span>`;

                    row.innerHTML = `
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full ${isEnabled ? 'bg-gray-100 text-gray-700 border border-gray-300' : 'bg-gray-200 text-gray-400 border border-gray-200'} font-bold text-xs flex items-center justify-center shrink-0">
                                ${idx + 2}
                            </span>
                            <div class="w-8 h-8 rounded-lg bg-gray-50 text-gray-700 flex items-center justify-center border border-gray-200 shrink-0">
                                ${PROVIDER_ICONS[pid] || PROVIDER_ICONS.custom}
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <strong class="text-xs ${isEnabled ? 'text-gray-900' : 'text-gray-500'} font-bold">${pObj.name}</strong>
                                    <span class="text-[10px] text-gray-400 font-medium">${pObj.badge}</span>
                                    ${statusBadgeHtml}
                                </div>
                                <span class="text-[10px] text-gray-400 font-mono block">Model: ${pConf.model || pObj.defaultModel}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1 bg-gray-50 p-1 rounded-lg border border-gray-200">
                                <button type="button" class="fallback-move-up p-1 rounded hover:bg-white text-gray-600 hover:text-brand-orange disabled:opacity-30 disabled:cursor-not-allowed transition-colors" title="Move Up in Priority" ${idx === 0 ? "disabled" : ""}>
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                                </button>
                                <button type="button" class="fallback-move-down p-1 rounded hover:bg-white text-gray-600 hover:text-brand-orange disabled:opacity-30 disabled:cursor-not-allowed transition-colors" title="Move Down in Priority" ${idx === fallbackOrder.length - 1 ? "disabled" : ""}>
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                </button>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer shrink-0 ml-1" title="Enable/Disable Fallback Slot">
                                <input type="checkbox" class="fallback-toggle-chk sr-only peer" ${isEnabled ? "checked" : ""} />
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:bg-brand-orange transition-colors"></div>
                                <span class="absolute top-0.5 left-0.5 bg-white border border-gray-300 rounded-full h-5 w-5 transition-transform duration-200 ease-in-out peer-checked:translate-x-5 peer-checked:border-white shadow-xs pointer-events-none"></span>
                            </label>
                        </div>
                    `;

                    const moveUpBtn = row.querySelector(".fallback-move-up");
                    const moveDownBtn = row.querySelector(".fallback-move-down");
                    const toggleChk = row.querySelector(".fallback-toggle-chk");

                    if (moveUpBtn) {
                        moveUpBtn.addEventListener("click", () => {
                            if (idx > 0) {
                                const temp = fallbackOrder[idx];
                                fallbackOrder[idx] = fallbackOrder[idx - 1];
                                fallbackOrder[idx - 1] = temp;
                                renderFallbackSequence();
                                syncFallbackJson();
                            }
                        });
                    }

                    if (moveDownBtn) {
                        moveDownBtn.addEventListener("click", () => {
                            if (idx < fallbackOrder.length - 1) {
                                const temp = fallbackOrder[idx];
                                fallbackOrder[idx] = fallbackOrder[idx + 1];
                                fallbackOrder[idx + 1] = temp;
                                renderFallbackSequence();
                                syncFallbackJson();
                            }
                        });
                    }

                    if (toggleChk) {
                        toggleChk.addEventListener("change", () => {
                            if (toggleChk.checked) {
                                enabledSet.add(pid);
                                row.className = "fallback-item-row flex items-center justify-between p-3 rounded-xl border shadow-2xs transition-all bg-white border-gray-200 hover:border-gray-300";
                            } else {
                                enabledSet.delete(pid);
                                row.className = "fallback-item-row flex items-center justify-between p-3 rounded-xl border shadow-2xs transition-all bg-gray-50/70 border-dashed border-gray-200 opacity-60";
                            }
                            syncFallbackJson();
                        });
                    }

                    fallbackItemsList.appendChild(row);
                });

                syncFallbackJson();
            }

            function setActiveProvider(pid) {
                if (!pid) return;
                if (activeProviderInput) activeProviderInput.value = pid;
                const pObj = AI_PROVIDERS.find(p => p.id === pid);
                if (activeProviderLabel && pObj) {
                    activeProviderLabel.textContent = pObj.name;
                }
                const summaryProviderName = document.getElementById("summary_provider_name");
                const summaryModelName = document.getElementById("summary_model_name");
                if (summaryProviderName && pObj) summaryProviderName.textContent = pObj.name;
                if (summaryModelName && providerConfigs && providerConfigs[pid]) {
                    summaryModelName.textContent = providerConfigs[pid].model || pObj.defaultModel;
                }

                // Update styling across cards
                providerCards.forEach(c => {
                    const cardPid = c.getAttribute("data-provider-id");
                    const isMatch = cardPid === pid;
                    const selectBtn = c.querySelector(".card-select-btn");

                    if (isMatch) {
                        c.className = "ai-provider-card relative border rounded-2xl p-5 cursor-pointer transition-all flex flex-col justify-between border-brand-orange bg-orange-50/25 ring-2 ring-brand-orange/30 shadow-xs";
                        if (selectBtn) {
                            selectBtn.className = "card-select-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer bg-brand-orange text-white shadow-2xs";
                            selectBtn.textContent = "✓ Primary Active";
                        }
                    } else {
                        c.className = "ai-provider-card relative border rounded-2xl p-5 cursor-pointer transition-all flex flex-col justify-between border-gray-200 hover:border-gray-300 bg-white hover:shadow-xs";
                        if (selectBtn) {
                            selectBtn.className = "card-select-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer bg-gray-100 hover:bg-orange-50 text-gray-700 hover:text-brand-orange border border-gray-200";
                            selectBtn.textContent = "Set as Primary";
                        }
                    }
                });

                renderFallbackSequence();
            }

            // 1. Open Provider Modal
            function openProviderModal(providerId) {
                currentModalProviderId = providerId;
                const pObj = AI_PROVIDERS.find(p => p.id === providerId);
                const pConf = (providerConfigs && providerConfigs[providerId]) || {};

                if (!pObj || !modal) return;

                // Set header
                if (modalProviderId) modalProviderId.value = providerId;
                if (modalTitle) modalTitle.textContent = `${pObj.name} Configuration`;
                if (modalBadge) modalBadge.textContent = pObj.badge;
                if (modalIcon) modalIcon.innerHTML = PROVIDER_ICONS[providerId] || PROVIDER_ICONS.custom;

                // Set API Key field
                if (modalApiKey) {
                    modalApiKey.value = "";
                    modalApiKey.type = "password";
                    modalApiKey.placeholder = pObj.keyPlaceholder || "Paste API Key";
                }
                if (modalToggleKeyBtn) modalToggleKeyBtn.textContent = "Show";

                if (modalKeyStatus) {
                    if (pConf.hasKey) {
                        modalKeyStatus.textContent = "Key configured in database";
                        modalKeyStatus.className = "text-[11px] font-semibold text-emerald-600";
                    } else {
                        modalKeyStatus.textContent = "No key configured";
                        modalKeyStatus.className = "text-[11px] font-semibold text-gray-400";
                    }
                }

                // Set Endpoint field
                if (modalEndpointContainer) {
                    if (providerId === "custom") {
                        modalEndpointContainer.classList.remove("hidden");
                    } else {
                        modalEndpointContainer.classList.add("hidden");
                    }
                }
                if (modalEndpoint) {
                    modalEndpoint.value = pConf.endpoint || (providerId === "custom" ? "" : pObj.defaultEndpoint || "");
                }

                // Set Model field
                if (modalModel) {
                    modalModel.value = pConf.model || pObj.defaultModel;
                }

                // Set Make Active checkbox
                if (modalMakeActive) {
                    modalMakeActive.checked = (providerId === (activeProviderInput ? activeProviderInput.value : "openrouter"));
                }

                // Free models filter toggle
                if (modalFreeFilterContainer) {
                    if (providerId === "openrouter") {
                        modalFreeFilterContainer.classList.remove("hidden");
                    } else {
                        modalFreeFilterContainer.classList.add("hidden");
                    }
                }
                if (modalFreeOnlyToggle) {
                    modalFreeOnlyToggle.checked = false;
                }

                // Reset fetched models list
                rawFetchedModels = [];
                if (modalFetchedContainer) modalFetchedContainer.classList.add("hidden");
                if (modalFetchedDropdown) modalFetchedDropdown.innerHTML = `<option value="">-- Choose a model --</option>`;

                // Render Quick Preset Chips
                if (modalQuickPresets) {
                    if (pObj.popularModels && pObj.popularModels.length > 0) {
                        let html = '<span class="text-[10px] text-gray-400 uppercase font-bold mr-1">Presets:</span>';
                        pObj.popularModels.forEach(m => {
                            const badgeStyle = m.isFree
                                ? 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200'
                                : 'bg-gray-100 text-gray-700 hover:bg-orange-100 hover:text-brand-orange border border-gray-200';
                            html += `<button type="button" class="modal-preset-chip px-2.5 py-1 text-[11px] font-semibold rounded-lg transition-all cursor-pointer ${badgeStyle}" data-model="${m.id}">${m.name}</button>`;
                        });
                        modalQuickPresets.innerHTML = html;

                        modalQuickPresets.querySelectorAll(".modal-preset-chip").forEach(btn => {
                            btn.addEventListener("click", () => {
                                const targetModel = btn.getAttribute("data-model");
                                if (targetModel && modalModel) {
                                    modalModel.value = targetModel;
                                }
                            });
                        });
                    } else {
                        modalQuickPresets.innerHTML = '<span class="text-[10px] text-gray-400 font-medium italic">Custom endpoint models can be entered above.</span>';
                    }
                }

                // Reset diagnostics area
                if (modalTestResult) {
                    modalTestResult.textContent = 'Click "Test Connection" to ping provider API and verify credentials.';
                    modalTestResult.className = "text-xs font-medium text-gray-500";
                }
                if (modalTestIndicator) {
                    modalTestIndicator.className = pConf.status === "error"
                        ? "w-2 h-2 rounded-full bg-red-500"
                        : pConf.hasKey
                        ? "w-2 h-2 rounded-full bg-emerald-500"
                        : "w-2 h-2 rounded-full bg-gray-400";
                }

                modal.classList.remove("hidden");
            }

            // Close Modal
            function closeModal() {
                if (modal) modal.classList.add("hidden");
            }

            if (modalCloseBtn) modalCloseBtn.addEventListener("click", closeModal);
            if (modalCancelBtn) modalCancelBtn.addEventListener("click", closeModal);
            if (modal) {
                modal.addEventListener("click", (e) => {
                    if (e.target === modal) closeModal();
                });
            }

            // Toggle Password Visibility in Modal
            if (modalToggleKeyBtn && modalApiKey) {
                modalToggleKeyBtn.addEventListener("click", () => {
                    if (modalApiKey.type === "password") {
                        modalApiKey.type = "text";
                        modalToggleKeyBtn.textContent = "Hide";
                    } else {
                        modalApiKey.type = "password";
                        modalToggleKeyBtn.textContent = "Show";
                    }
                });
            }

            // Render Fetched Models with Free Filter
            function renderModalFetchedModels() {
                if (!modalFetchedDropdown || !modalFetchedContainer) return;
                if (!rawFetchedModels || rawFetchedModels.length === 0) {
                    modalFetchedContainer.classList.add("hidden");
                    return;
                }

                const isFreeOnly = modalFreeOnlyToggle && modalFreeOnlyToggle.checked && currentModalProviderId === "openrouter";
                let list = rawFetchedModels;
                if (isFreeOnly) {
                    list = rawFetchedModels.filter(m => m.isFree || (m.id && m.id.includes(":free")));
                }

                if (modalModelsCount) {
                    modalModelsCount.textContent = isFreeOnly
                        ? `${list.length} free models`
                        : `${list.length} models`;
                }

                modalFetchedDropdown.innerHTML = `<option value="">-- Choose from ${list.length} ${isFreeOnly ? 'free ' : ''}models --</option>`;
                list.forEach(m => {
                    const opt = document.createElement("option");
                    opt.value = m.id;
                    opt.textContent = m.name;
                    if (m.id === modalModel?.value) opt.selected = true;
                    modalFetchedDropdown.appendChild(opt);
                });

                modalFetchedContainer.classList.remove("hidden");
            }

            if (modalFreeOnlyToggle) {
                modalFreeOnlyToggle.addEventListener("change", renderModalFetchedModels);
            }

            if (modalFetchedDropdown && modalModel) {
                modalFetchedDropdown.addEventListener("change", () => {
                    if (modalFetchedDropdown.value) {
                        modalModel.value = modalFetchedDropdown.value;
                    }
                });
            }

            // Fetch Models Button
            if (modalFetchBtn) {
                modalFetchBtn.addEventListener("click", async () => {
                    const apiKey = modalApiKey ? modalApiKey.value.trim() : "";
                    const endpoint = modalEndpoint ? modalEndpoint.value.trim() : "";

                    modalFetchSpinner?.classList.remove("hidden");
                    modalFetchIcon?.classList.add("hidden");
                    modalFetchBtn.disabled = true;

                    try {
                        const res = await fetch("/api/chatbot/models/", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                provider: currentModalProviderId,
                                apiKey,
                                endpoint,
                            }),
                        });

                        const text = await res.text();
                        let data;
                        try {
                            data = JSON.parse(text);
                        } catch (err) {
                            throw new Error("Server returned invalid response: " + text.slice(0, 150));
                        }

                        if (data.success && Array.isArray(data.models) && data.models.length > 0) {
                            rawFetchedModels = data.models;
                            renderModalFetchedModels();
                        } else {
                            alert(data.error || "No models returned. Verify API Key and Endpoint.");
                        }
                    } catch (e) {
                        alert("Error fetching models: " + e.message);
                    } finally {
                        modalFetchSpinner?.classList.add("hidden");
                        modalFetchIcon?.classList.remove("hidden");
                        modalFetchBtn.disabled = false;
                    }
                });
            }

            // Live Connection Diagnostics Test Button
            if (modalTestBtn) {
                modalTestBtn.addEventListener("click", async () => {
                    const apiKey = modalApiKey ? modalApiKey.value.trim() : "";
                    const endpoint = modalEndpoint ? modalEndpoint.value.trim() : "";
                    const model = modalModel ? modalModel.value.trim() : "";

                    modalTestSpinner?.classList.remove("hidden");
                    modalTestIcon?.classList.add("hidden");
                    modalTestBtn.disabled = true;
                    if (modalTestResult) {
                        modalTestResult.textContent = "Connecting to provider API...";
                        modalTestResult.className = "text-xs font-semibold text-brand-orange animate-pulse";
                    }

                    try {
                        const res = await fetch("/api/chatbot/test-provider/", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                provider: currentModalProviderId,
                                apiKey,
                                endpoint,
                                model,
                            }),
                        });

                        const data = await res.json();
                        if (data.success) {
                            if (modalTestResult) {
                                modalTestResult.textContent = `Success! ${data.message} (${data.latencyMs}ms)`;
                                modalTestResult.className = "text-xs font-bold text-emerald-700";
                            }
                            if (modalTestIndicator) {
                                modalTestIndicator.className = "w-2 h-2 rounded-full bg-emerald-500";
                            }
                        } else {
                            if (modalTestResult) {
                                modalTestResult.textContent = `Connection Failed: ${data.error || "Unknown error"}`;
                                modalTestResult.className = "text-xs font-bold text-red-600";
                            }
                            if (modalTestIndicator) {
                                modalTestIndicator.className = "w-2 h-2 rounded-full bg-red-500";
                            }
                        }
                    } catch (err) {
                        if (modalTestResult) {
                            modalTestResult.textContent = `Diagnostic Error: ${err.message}`;
                            modalTestResult.className = "text-xs font-bold text-red-600";
                        }
                        if (modalTestIndicator) {
                            modalTestIndicator.className = "w-2 h-2 rounded-full bg-red-500";
                        }
                    } finally {
                        modalTestSpinner?.classList.add("hidden");
                        modalTestIcon?.classList.remove("hidden");
                        modalTestBtn.disabled = false;
                    }
                });
            }

            // 2. Provider Card Selection & Gear Buttons
            providerCards.forEach(card => {
                card.addEventListener("click", (e) => {
                    if (e.target.closest(".gear-config-btn")) return;
                    const pid = card.getAttribute("data-provider-id");
                    if (pid) setActiveProvider(pid);
                });
            });

            // Initial render of fallback sequence
            renderFallbackSequence();

            // Ensure fallback JSON is synced right before form submit
            const aiForm = document.querySelector('form[action="?tab=ai"]');
            if (aiForm) {
                aiForm.addEventListener("submit", () => {
                    syncFallbackJson();
                });
            }

            // Gear Config Buttons on Cards
            document.querySelectorAll(".gear-config-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const pid = btn.getAttribute("data-provider");
                    if (pid) openProviderModal(pid);
                });
            });

            // Configure Active Provider button in notice
            if (openActiveConfigBtn) {
                openActiveConfigBtn.addEventListener("click", () => {
                    const activePid = activeProviderInput ? activeProviderInput.value : "openrouter";
                    openProviderModal(activePid);
                });
            }

            // Temperature Slider Live Update
            if (tempSlider && tempDisplay) {
                tempSlider.addEventListener("input", () => {
                    tempDisplay.textContent = tempSlider.value;
                });
            }

            // 3. Live Simulator Logic
            const simChatForm = document.getElementById("sim_chat_form");
            const simChatInput = document.getElementById("sim_chat_input");
            const simSendBtn = document.getElementById("sim_send_btn");
            const simMessagesContainer = document.getElementById("sim_messages_container");
            const simResetBtn = document.getElementById("sim_reset_btn");
            const simLatencyIndicator = document.getElementById("sim_latency_indicator");
            const simTestChips = document.querySelectorAll(".sim-test-chip");

            let simSessionId = "sim_sess_" + Math.random().toString(36).substring(2, 9);
            let simConversationId = "";

            function isUrdu(text) {
                return /[\u0600-\u06FF]/.test(text || "");
            }

            function formatSimMarkdown(text) {
                if (!text) return "";
                let html = text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");

                // Bold
                html = html.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
                // Italic
                html = html.replace(/\*(.*?)\*/g, "<em>$1</em>");
                // Monospace code
                html = html.replace(/`(.*?)`/g, "<code class='bg-gray-100 text-gray-800 px-1 py-0.5 rounded font-mono text-[11px]'>$1</code>");

                // Markdown links [label](url)
                html = html.replace(
                    /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
                    `<a href="$2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 my-1 px-2.5 py-1 rounded-lg text-xs font-bold text-white bg-brand-orange hover:bg-orange-600 transition-colors shadow-2xs no-underline"><svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg><span>$1</span></a>`
                );

                // Autolink bare URLs
                html = html.replace(
                    /(^|[^"'>])(https?:\/\/[^\s<]+)/g,
                    `$1<a href="$2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 my-0.5 px-2 py-0.5 rounded text-xs font-semibold text-brand-orange bg-orange-50 hover:bg-orange-100 border border-orange-200 transition-colors no-underline"><span>$2</span><svg class="w-2.5 h-2.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a>`
                );

                return html.replace(/\n/g, "<br/>");
            }

            function appendSimMessage(role, text, meta = {}) {
                if (!simMessagesContainer) return;
                const isUser = role === "user";
                const isUr = isUrdu(text);

                const bubbleWrapper = document.createElement("div");
                bubbleWrapper.className = `flex ${isUser ? "justify-end" : "justify-start"}`;

                const bubble = document.createElement("div");
                bubble.className = `max-w-[85%] rounded-2xl p-3.5 text-xs leading-relaxed shadow-2xs ${
                    isUser
                        ? "bg-brand-orange text-white"
                        : "bg-white text-gray-800 border border-gray-200"
                } ${isUr ? "font-beiruti text-[13.5px]" : ""}`;
                if (isUr) bubble.setAttribute("dir", "rtl");

                let headerHtml = "";
                if (!isUser) {
                    const providerTag = meta.providerUsed
                        ? `<span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-orange-100 text-brand-orange border border-orange-200 uppercase">${meta.providerUsed}</span>`
                        : "";
                    const latencyTag = meta.latencyMs
                        ? `<span class="font-mono text-gray-400 text-[9px]">${meta.latencyMs}ms</span>`
                        : "";

                    headerHtml = `
                        <div class="text-[10px] text-gray-400 font-semibold uppercase mb-1 flex items-center gap-1.5 flex-wrap">
                            <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
                            <span class="font-bold text-gray-700">Gionee Assistant</span>
                            ${providerTag}
                            ${latencyTag}
                        </div>
                    `;
                }

                bubble.innerHTML = `
                    ${headerHtml}
                    <div class="whitespace-pre-wrap">${isUser ? text : formatSimMarkdown(text)}</div>
                `;

                bubbleWrapper.appendChild(bubble);
                simMessagesContainer.appendChild(bubbleWrapper);
                simMessagesContainer.scrollTop = simMessagesContainer.scrollHeight;
            }

            async function sendSimMessage(userText) {
                if (!userText || !simMessagesContainer) return;

                appendSimMessage("user", userText);
                if (simChatInput) simChatInput.value = "";
                if (simSendBtn) simSendBtn.disabled = true;

                const typingIndicator = document.createElement("div");
                typingIndicator.id = "sim_typing_indicator";
                typingIndicator.className = "flex justify-start";
                typingIndicator.innerHTML = `
                    <div class="rounded-2xl px-4 py-2.5 bg-white border border-gray-200 text-gray-400 text-xs flex items-center gap-2 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
                        <span>Assistant thinking...</span>
                    </div>
                `;
                simMessagesContainer.appendChild(typingIndicator);
                simMessagesContainer.scrollTop = simMessagesContainer.scrollHeight;

                const startTime = Date.now();
                try {
                    const res = await fetch("/api/chatbot/message/", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            message: userText,
                            sessionId: simSessionId,
                            conversationId: simConversationId,
                        }),
                    });

                    const data = await res.json();
                    const latencyMs = Date.now() - startTime;
                    if (simLatencyIndicator) {
                        simLatencyIndicator.textContent = `Last latency: ${latencyMs}ms`;
                    }

                    typingIndicator.remove();

                    if (data.conversationId) {
                        simConversationId = data.conversationId;
                    }

                    if (data.reply) {
                        appendSimMessage("assistant", data.reply, {
                            providerUsed: data.providerUsed,
                            latencyMs,
                            isHandover: data.isHandover,
                        });
                    } else if (data.error) {
                        appendSimMessage("assistant", `⚠️ Error: ${data.error}`, { latencyMs });
                    }
                } catch (err) {
                    typingIndicator.remove();
                    appendSimMessage("assistant", `⚠️ Request failed: ${err.message}`);
                } finally {
                    if (simSendBtn) simSendBtn.disabled = false;
                    if (simChatInput) simChatInput.focus();
                }
            }

            if (simChatForm && simChatInput) {
                simChatForm.addEventListener("submit", (e) => {
                    e.preventDefault();
                    const text = simChatInput.value.trim();
                    if (text) sendSimMessage(text);
                });
            }

            if (simResetBtn) {
                simResetBtn.addEventListener("click", () => {
                    simSessionId = "sim_sess_" + Math.random().toString(36).substring(2, 9);
                    simConversationId = "";
                    if (simMessagesContainer) {
                        simMessagesContainer.innerHTML = `
                            <div class="flex justify-start">
                                <div class="max-w-[85%] rounded-2xl p-4 text-xs leading-relaxed bg-white text-gray-800 border border-gray-200 shadow-2xs">
                                    <div class="text-[10px] text-gray-400 font-semibold uppercase mb-1.5 flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-brand-orange"></span>
                                        <span class="font-bold text-gray-700">Chat Session Reset</span>
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-green-50 text-green-700 border border-green-200 uppercase">SYSTEM READY</span>
                                    </div>
                                    <p>Simulator conversation reset. Enter a prompt or choose a scenario pill to begin testing.</p>
                                </div>
                            </div>
                        `;
                    }
                });
            }

            simTestChips.forEach(chip => {
                chip.addEventListener("click", () => {
                    const prompt = chip.getAttribute("data-prompt");
                    if (prompt) {
                        if (simChatInput) simChatInput.value = prompt;
                        sendSimMessage(prompt);
                    }
                });
            });
        });
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Beiruti:wght@400;500;600;700;800&display=swap');
        .font-beiruti {
            font-family: 'Beiruti', system-ui, -apple-system, sans-serif !important;
        }
    </style>
</AdminLayout>
