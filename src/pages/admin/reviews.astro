---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import Pagination from "../../components/admin/Pagination.astro";

const seoTitle = "Admin Reviews - Gionee Pakistan";

const url = new URL(Astro.request.url);
const search = url.searchParams.get("search") || "";
const productFilter = url.searchParams.get("product") || "";

const page = parseInt(url.searchParams.get("page") || "1");
const limit = parseInt(url.searchParams.get("limit") || "20");
const offset = (page - 1) * limit;

const db = Astro.locals.runtime?.env?.DB;

let reviews: any[] = [];
let products: any[] = [];
let errorMsg = "";
let successMsg = "";

let totalItems = 0;
let totalPages = 0;

if (!db) {
    errorMsg = "Cloudflare D1 Database binding is missing. Please check your wrangler.toml or start development using Astro proxy.";
} else {
    try {
        // 1. Process Delete Request
        if (Astro.request.method === "POST") {
            const formData = await Astro.request.formData();
            const actionType = formData.get("action_type")?.toString();

            if (actionType === "delete") {
                const reviewId = formData.get("review_id")?.toString();
                if (reviewId) {
                    await db.prepare("DELETE FROM reviews WHERE id = ?").bind(reviewId).run();
                    successMsg = `Review #${reviewId} has been successfully deleted from the database.`;
                }
            } else if (actionType === "bulk_delete") {
                const reviewIdsStr = formData.get("review_ids")?.toString();
                if (reviewIdsStr) {
                    const ids = reviewIdsStr.split(",").map(id => id.trim()).filter(id => id);
                    if (ids.length > 0) {
                        const placeholders = ids.map(() => '?').join(',');
                        await db.prepare(`DELETE FROM reviews WHERE id IN (${placeholders})`).bind(...ids).run();
                        successMsg = `${ids.length} reviews have been successfully deleted.`;
                    }
                }
            }
        }

        // 2. Fetch Products list for filters
        const productsResult = await db.prepare("SELECT id, title FROM products ORDER BY title ASC").all();
        products = productsResult.results || [];

        // 3. Count Total Items for Pagination
        let countQuery = "SELECT COUNT(*) as count FROM reviews r";
        let countWhereClauses: string[] = [];
        let countParams: any[] = [];

        if (search) {
            countWhereClauses.push(`(r.author LIKE ? OR r.text LIKE ? OR r.title LIKE ? OR r.location LIKE ?)`);
            const wildSearch = `%${search}%`;
            countParams.push(wildSearch, wildSearch, wildSearch, wildSearch);
        }



        if (productFilter) {
            countWhereClauses.push(`r.product_id = ?`);
            countParams.push(parseInt(productFilter));
        }

        if (countWhereClauses.length > 0) {
            countQuery += ` WHERE ` + countWhereClauses.join(" AND ");
        }

        const countStmt = db.prepare(countQuery);
        const countResult: any = countParams.length > 0 ? await countStmt.bind(...countParams).first() : await countStmt.first();
        totalItems = countResult?.count || 0;
        totalPages = Math.ceil(totalItems / limit);

        // 4. Fetch Reviews with details & join with products
        let query = `
            SELECT 
                r.*, 
                p.title as product_title, 
                p.slug as product_slug,
                p.images as product_images
            FROM reviews r
            LEFT JOIN products p ON r.product_id = p.id
        `;
        let params: any[] = [];
        let whereClauses: string[] = [];

        if (search) {
            whereClauses.push(`(r.author LIKE ? OR r.text LIKE ? OR r.title LIKE ? OR r.location LIKE ?)`);
            const wildSearch = `%${search}%`;
            params.push(wildSearch, wildSearch, wildSearch, wildSearch);
        }



        if (productFilter) {
            whereClauses.push(`r.product_id = ?`);
            params.push(parseInt(productFilter));
        }

        if (whereClauses.length > 0) {
            query += ` WHERE ` + whereClauses.join(" AND ");
        }

        query += ` ORDER BY r.created_at DESC, r.id DESC LIMIT ? OFFSET ?`;
        params.push(limit, offset);

        const stmt = db.prepare(query);
        const { results } = await stmt.bind(...params).all();
        reviews = results || [];

    } catch (e: any) {
        errorMsg = "Database Error: " + e.message;
    }
}
---

<AdminLayout title={seoTitle} activePage="reviews">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
                <div>
                    <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">Customer Reviews</h1>
                    <p class="text-gray-500 mt-1">Manage dynamic testimonials, star ratings, and review connections for catalog products.</p>
                </div>
                <div>
                    <a href="/admin/reviews/new/" class="inline-flex items-center gap-2 py-2.5 px-5 bg-brand-orange hover:bg-brand-orange/95 text-white font-semibold rounded-md text-sm transition-all shadow-sm active:scale-[0.98] hover:scale-[1.01]">
                        + Create Review
                    </a>
                </div>
            </div>

            <!-- Error Banner -->
            {errorMsg && (
                <div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg mb-8 flex items-start gap-3">
                    <div class="bg-red-100 text-red-800 p-1 rounded-full shrink-0 font-semibold">⚠️</div>
                    <div>
                        <p class="font-semibold">Database Error Occurred</p>
                        <p class="text-sm mt-0.5">{errorMsg}</p>
                    </div>
                </div>
            )}

            <!-- Success Banner -->
            {successMsg && (
                <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-lg mb-8 flex items-start gap-3">
                    <div class="bg-green-100 text-green-800 p-1 rounded-full shrink-0 font-semibold">✓</div>
                    <div>
                        <p class="font-semibold">Operation Successful</p>
                        <p class="text-sm mt-0.5">{successMsg}</p>
                    </div>
                </div>
            )}

            <!-- Statistics Grid Removed -->

            <!-- Filter & Search Panel -->
            <div class="bg-white p-5 rounded-lg border border-gray-100 shadow-sm mb-8">
                <form method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <!-- Search Input -->
                    <div class="md:col-span-2 relative">
                        <label class="text-xs font-medium text-gray-500 uppercase tracking-wider block mb-2">Search Content</label>
                        <div class="relative">
                            <input
                                type="text"
                                name="search"
                                value={search}
                                placeholder="Search by author, review text, title..."
                                class="w-full pl-10 pr-4 py-2.5 rounded-md border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange text-sm text-gray-800 bg-white"
                            />
                            <div class="absolute left-3.5 top-3.5 text-gray-400">
                                <Icon name="search" class="w-4 h-4" />
                            </div>
                        </div>
                    </div>

                    <!-- Linked Product Dropdown -->
                    <div class="md:col-span-1">
                        <label class="text-xs font-medium text-gray-500 uppercase tracking-wider block mb-2">Product Catalog</label>
                        <select
                            name="product"
                            class="w-full pl-3 pr-10 py-2.5 rounded-md border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange text-sm text-gray-800 bg-white appearance-none admin-select"
                        >
                            <option value="">All Products</option>
                            {products.map((p) => (
                                <option value={p.id} selected={productFilter === p.id.toString()}>
                                    {p.title}
                                </option>
                            ))}
                        </select>
                    </div>

                    <!-- Submit & Reset Buttons -->
                    <div class="md:col-span-1 flex gap-2">
                        <button type="submit" class="flex-1 py-2.5 px-3 bg-brand-orange hover:bg-brand-orange/95 text-white font-semibold rounded-md text-sm transition-colors shadow-sm active:scale-[0.98]">
                            Apply
                        </button>
                        {(search || productFilter) && (
                            <a href="/admin/reviews/" class="py-2.5 px-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-md text-sm transition-colors flex items-center justify-center" title="Reset Filters">
                                <Icon name="x" class="w-4 h-4" />
                            </a>
                        )}
                    </div>
                </form>
            </div>

            <!-- Reviews Table Card -->
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100 text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <th class="p-4 w-12 text-center">
                                    <input type="checkbox" id="selectAll" class="rounded border-gray-300 text-brand-orange focus:ring-brand-orange cursor-pointer w-4 h-4" />
                                </th>
                                <th class="p-4">Linked Product</th>
                                <th class="p-4">Rating</th>
                                <th class="p-4">Reviewer</th>
                                <th class="p-4">Created Date</th>
                                <th class="p-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm text-gray-800">
                            {reviews.length === 0 ? (
                                <tr>
                                    <td colspan="6" class="p-12 text-center text-gray-500">
                                        <div class="max-w-sm mx-auto flex flex-col items-center">
                                            <div class="text-4xl mb-2">⭐</div>
                                            <p class="font-medium text-gray-800">No Reviews Found</p>
                                            <p class="text-xs text-gray-400 mt-1">
                                                No reviews matched your filters or search terms. Try modifying your criteria or create a review.
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            ) : (
                                reviews.map((rev) => {
                                    // Parse product image
                                    let coverImage = "/favicon.png";
                                    try {
                                        if (rev.product_images) {
                                            const parsed = JSON.parse(rev.product_images);
                                            if (Array.isArray(parsed) && parsed.length > 0) {
                                                const firstItem = parsed[0];
                                                coverImage = typeof firstItem === 'object' && firstItem !== null ? firstItem.url : firstItem;
                                            }
                                        }
                                    } catch (e) {}

                                    return (
                                        <tr class="hover:bg-gray-50/50 transition-colors group">
                                            <!-- Checkbox Column -->
                                            <td class="p-4 w-12 text-center">
                                                <input type="checkbox" name="selected_reviews[]" value={rev.id} class="row-checkbox rounded border-gray-300 text-brand-orange focus:ring-brand-orange cursor-pointer w-4 h-4" />
                                            </td>
                                            <!-- Product Column -->
                                            <td class="p-4">
                                                {rev.product_title ? (
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded bg-gray-100 overflow-hidden border border-gray-200 flex-shrink-0 flex items-center justify-center">
                                                            <img src={coverImage} alt={rev.product_title} class="w-full h-full object-cover" />
                                                        </div>
                                                        <div class="max-w-[160px] truncate">
                                                            <div class="font-medium text-gray-900 truncate" title={rev.product_title}>{rev.product_title}</div>
                                                            <div class="text-xs text-gray-400">ID: #{rev.product_id}</div>
                                                        </div>
                                                    </div>
                                                ) : (
                                                    <span class="text-xs font-medium text-red-500 italic">Product Removed (#{rev.product_id})</span>
                                                )}
                                            </td>

                                            <!-- Rating Column -->
                                            <td class="p-4 shrink-0">
                                                <div class="flex items-center gap-1.5">
                                                    <span class="text-yellow-500 font-medium text-sm">
                                                        ★ {parseFloat(Number(rev.rating).toFixed(1))}
                                                    </span>
                                                    <div class="flex text-[10px] text-yellow-400 select-none translate-y-px">
                                                        {Array.from({ length: 5 }).map((_, i) => (
                                                            <span>{i < Math.round(rev.rating) ? "★" : "☆"}</span>
                                                        ))}
                                                    </div>
                                                </div>
                                            </td>
                                            
                                            <!-- Reviewer Column -->
                                            <td class="p-4">
                                                <div class="font-medium text-gray-900">{rev.author}</div>
                                                <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                                                    {rev.location ? (
                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-100 text-gray-500 border border-gray-200 uppercase tracking-wide">
                                                            {rev.location}
                                                        </span>
                                                    ) : (
                                                        <span class="text-[10px] text-gray-400 italic">No Location</span>
                                                    )}
                                                </div>
                                            </td>



                                            <!-- Date Column -->
                                            <td class="p-4 text-xs font-medium text-gray-400 shrink-0">
                                                {new Date(rev.created_at).toLocaleDateString('en-US', {
                                                    day: '2-digit',
                                                    month: 'short',
                                                    year: 'numeric'
                                                })}
                                            </td>

                                            <!-- Actions Column -->
                                            <td class="p-4 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <a href={`/admin/reviews/${rev.id}/`} class="p-1.5 text-gray-400 hover:text-brand-orange hover:bg-orange-50 rounded transition-colors" title="Manage Review">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                    </a>
                                                    <button type="button" class="delete-review-btn p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors focus:outline-none" title="Delete Review" data-id={rev.id}>
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    );
                                })
                            )}
                        </tbody>
                    </table>
                </div>

                {totalItems > 0 && (
                    <Pagination 
                        currentPage={page} 
                        totalPages={totalPages} 
                        totalItems={totalItems} 
                        limit={limit} 
                    />
                )}
            </div>

            <!-- Floating Bulk Action Bar -->
            <div id="bulkActionBar" class="fixed bottom-0 left-0 right-0 md:left-64 bg-white border-t border-gray-200 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)] p-4 flex items-center justify-between z-50 transform translate-y-full transition-transform duration-300">
                <div class="flex items-center gap-4">
                    <span class="bg-brand-orange text-white font-bold px-3 py-1 rounded-full text-sm"><span id="selectedCount">0</span> Selected</span>
                    <span class="text-sm text-gray-500 font-medium hidden sm:inline">Bulk Actions:</span>
                </div>
                
                <div class="flex items-center gap-3">
                    <button type="button" id="bulk-delete-btn" class="flex items-center gap-1.5 text-sm font-semibold text-rose-600 hover:text-rose-700 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        Delete Selected
                    </button>
                </div>
            </div>

            <!-- Custom Delete Confirmation Modal -->
            <div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
                <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform duration-200">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mb-4 mx-auto">
                            <Icon name="trash" class="w-6 h-6 text-red-600" />
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 text-center mb-2" id="delete-modal-title">Delete Review</h3>
                        <p class="text-sm text-gray-500 text-center mb-6" id="delete-modal-text">Are you absolutely sure you want to permanently delete this review? This action cannot be undone.</p>
                        
                        <form method="POST" id="delete-form" class="flex gap-3">
                            <input type="hidden" name="action_type" id="modal-action-type" value="delete" />
                            <input type="hidden" name="review_id" id="modal-review-id" value="" />
                            <input type="hidden" name="review_ids" id="modal-review-ids" value="" />
                            
                            <button type="button" id="cancel-delete-btn" class="flex-1 py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg transition-colors">
                                Cancel
                            </button>
                            <button type="submit" class="flex-1 py-2.5 px-4 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors shadow-sm">
                                Yes, Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>

</AdminLayout>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const selectAllCheckbox = document.getElementById("selectAll");
            const rowCheckboxes = document.querySelectorAll(".row-checkbox");
            const bulkActionBar = document.getElementById("bulkActionBar");
            const selectedCountEl = document.getElementById("selectedCount");
            const bulkDeleteBtn = document.getElementById("bulk-delete-btn");
            
            const deleteModal = document.getElementById("delete-modal");
            const deleteForm = document.getElementById("delete-form");
            const cancelDeleteBtn = document.getElementById("cancel-delete-btn");
            const modalActionType = document.getElementById("modal-action-type");
            const modalReviewId = document.getElementById("modal-review-id");
            const modalReviewIds = document.getElementById("modal-review-ids");
            const deleteModalTitle = document.getElementById("delete-modal-title");
            const deleteModalText = document.getElementById("delete-modal-text");
            const singleDeleteBtns = document.querySelectorAll(".delete-review-btn");

            // Update selected state
            const updateSelectionState = () => {
                const selectedBoxes = document.querySelectorAll(".row-checkbox:checked");
                const count = selectedBoxes.length;
                
                if (count > 0) {
                    selectedCountEl.textContent = count;
                    bulkActionBar.classList.remove("translate-y-full");
                    bulkActionBar.classList.add("translate-y-0");
                    if (selectAllCheckbox) selectAllCheckbox.checked = count === rowCheckboxes.length;
                } else {
                    bulkActionBar.classList.add("translate-y-full");
                    bulkActionBar.classList.remove("translate-y-0");
                    if (selectAllCheckbox) selectAllCheckbox.checked = false;
                }
            };

        // Select All toggle
        selectAllCheckbox?.addEventListener("change", (e) => {
            rowCheckboxes.forEach(cb => cb.checked = e.target.checked);
            updateSelectionState();
        });

        // Individual row toggles
        rowCheckboxes.forEach(cb => {
            cb.addEventListener("change", updateSelectionState);
        });

        // Open Modal Function
        const openModal = (isBulk, idOrIds) => {
            if (isBulk) {
                modalActionType.value = "bulk_delete";
                modalReviewIds.value = idOrIds.join(",");
                modalReviewId.value = "";
                deleteModalTitle.textContent = "Delete Selected Reviews";
                deleteModalText.textContent = `Are you absolutely sure you want to permanently delete ${idOrIds.length} reviews? This action cannot be undone.`;
            } else {
                modalActionType.value = "delete";
                modalReviewId.value = idOrIds;
                modalReviewIds.value = "";
                deleteModalTitle.textContent = "Delete Review";
                deleteModalText.textContent = "Are you absolutely sure you want to permanently delete this review? This action cannot be undone.";
            }
            
            deleteModal.classList.remove("opacity-0", "pointer-events-none");
            deleteModal.querySelector("div").classList.remove("scale-95");
        };

        // Close Modal Function
        const closeModal = () => {
            deleteModal.classList.add("opacity-0", "pointer-events-none");
            deleteModal.querySelector("div").classList.add("scale-95");
        };

        // Single delete click
        singleDeleteBtns.forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const id = btn.getAttribute("data-id");
                openModal(false, id);
            });
        });

        // Bulk delete click
        bulkDeleteBtn?.addEventListener("click", () => {
            const selectedBoxes = document.querySelectorAll(".row-checkbox:checked");
            const ids = Array.from(selectedBoxes).map(cb => cb.value);
            if (ids.length > 0) {
                openModal(true, ids);
            }
        });

        // Cancel delete
        cancelDeleteBtn?.addEventListener("click", closeModal);
        
        // Close on outside click
        deleteModal?.addEventListener("click", (e) => {
            if (e.target === deleteModal) closeModal();
        });
    });
</script>
