                    <div class="flex justify-end pt-1">
                        <button type="submit" class="px-4 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg hover:bg-black transition-colors shadow-sm flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Add URL Source & Sync
                        </button>
                    </div>
                </form>

                <!-- URL Sources List -->
                <div class="border border-gray-200 rounded-lg overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs min-w-[620px]">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 uppercase text-[10px] font-semibold border-b border-gray-200">
                                <th class="py-2.5 px-4">Label</th>
                                <th class="py-2.5 px-4">URL</th>
                                <th class="py-2.5 px-4">Status</th>
                                <th class="py-2.5 px-4">Last Synced</th>
                                <th class="py-2.5 px-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {knowledgeUrls.length === 0 ? (
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-gray-400 text-xs">No URLs added yet. Add a page URL above!</td>
                                </tr>
                            ) : (
                                knowledgeUrls.map((u) => (
                                    <tr class="hover:bg-gray-50/50">
                                        <td class="py-3 px-4 font-semibold text-gray-900">{u.label || "Page"}</td>
                                        <td class="py-3 px-4 font-mono text-gray-600">{u.url}</td>
                                        <td class="py-3 px-4">
                                            <span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                                                u.status === 'synced' ? 'bg-green-100 text-green-800' :
                                                u.status === 'error' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'
                                            }`}>
                                                {u.status || 'Pending'}
                                            </span>
                                            {u.errorMsg && <span class="text-[10px] text-red-500 ml-1">({u.errorMsg})</span>}
                                        </td>
                                        <td class="py-3 px-4 text-gray-500">{u.lastSynced || "Never"}</td>
                                        <td class="py-3 px-4 text-right">
                                            <form method="POST" class="inline" onsubmit="return confirm('Remove this URL source from Knowledge Hub?');">
                                                <input type="hidden" name="action" value="delete_knowledge_url" />
                                                <input type="hidden" name="url_id" value={u.id} />
                                                <button type="submit" class="px-2 py-1 text-[11px] font-semibold text-red-600 hover:bg-red-50 rounded transition-colors">
                                                    Remove
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 2: MANUAL Q&A BUILDER (From Monthly Chat Reviews) -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm space-y-4">
                <div>
                    <h3 class="text-base font-bold text-gray-900">Manual Questions & Answers</h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Review customer chat transcripts from the Conversations tab and add specific questions that the bot was unable to answer.
                    </p>
                </div>

                <form method="POST" class="space-y-4 bg-gray-50/70 p-4 border border-gray-200 rounded-lg">
                    <input type="hidden" name="action" value="add_faq" />
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Category</label>
                            <select name="category" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm focus:ring-brand-orange focus:border-brand-orange">
                                <option value="general">General</option>
                                <option value="shipping">Shipping & Delivery</option>
                                <option value="warranty">Warranty & Guarantee</option>
                                <option value="returns">Returns & Refunds</option>
                                <option value="products">Product Specifications</option>
                            </select>
                        </div>
                        <div class="sm:col-span-3">
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Customer Query / Question</label>
                            <input type="text" name="question" required placeholder="e.g. What makes your handsfree different from cheap copies?" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm focus:ring-brand-orange focus:border-brand-orange" />
                        </div>
                        <div class="sm:col-span-4">
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Official Support Answer</label>
                            <textarea name="answer" required rows="2" placeholder="Provide a concise, factual answer for the bot to quote..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm focus:ring-brand-orange focus:border-brand-orange"></textarea>
                        </div>
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <label class="inline-flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer">
                            <input type="checkbox" name="is_active" value="1" checked class="w-4 h-4 accent-brand-orange rounded" />
                            Active immediately in bot context
                        </label>
                        <button type="submit" class="px-4 py-2 bg-brand-orange text-white text-xs font-bold rounded-lg hover:bg-orange-600 transition-colors shadow-sm">
                            + Add Manual Q&A
                        </button>
                    </div>
                </form>

                <!-- Existing FAQs List -->
                <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
                    {faqsList.length === 0 ? (
                        <div class="p-8 text-center text-gray-400 text-xs">No manual FAQs yet. Add your first Q&A above!</div>
                    ) : (
                        faqsList.map((faq) => (
                            <div class="p-4 flex flex-col sm:flex-row sm:items-start justify-between gap-4 hover:bg-gray-50/50 transition-colors">
                                <div class="space-y-1.5 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-700 border border-gray-200">
                                            {faq.category}
                                        </span>
                                        <span class={`inline-block w-2 h-2 rounded-full ${faq.is_active ? 'bg-green-500' : 'bg-gray-300'}`} title={faq.is_active ? 'Active' : 'Inactive'}></span>
                                        <h4 class="font-bold text-sm text-gray-900">{faq.question}</h4>
                                    </div>
                                    <p class="text-xs text-gray-600 leading-relaxed pl-1">{faq.answer}</p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0 self-end sm:self-start">
                                    <form method="POST" class="inline">
                                        <input type="hidden" name="action" value="toggle_faq" />
                                        <input type="hidden" name="faq_id" value={faq.id} />
                                        <input type="hidden" name="current_state" value={faq.is_active} />
                                        <button type="submit" class={`px-2.5 py-1 rounded text-xs font-semibold transition-colors ${faq.is_active ? 'text-amber-700 bg-amber-50 hover:bg-amber-100' : 'text-green-700 bg-green-50 hover:bg-green-100'}`}>
                                            {faq.is_active ? "Disable" : "Enable"}
                                        </button>
                                    </form>
                                    <form method="POST" class="inline" onsubmit="return confirm('Delete this FAQ?');">
                                        <input type="hidden" name="action" value="delete_faq" />
                                        <input type="hidden" name="faq_id" value={faq.id} />
                                        <button type="submit" class="px-2.5 py-1 rounded text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 transition-colors">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        ))
                    )}
                </div>
            </div>
        </div>
    )}

    <!-- TAB 5: HUMAN HANDOVER (WHATSAPP & CONTACT PAGE) -->
    {activeTab === "handover" && (
        <div class="space-y-6">
            <form method="POST" action="?tab=handover" class="bg-white p-6 sm:p-7 rounded-2xl border border-gray-200 shadow-sm space-y-6">
                <input type="hidden" name="action" value="save_handover_settings" />
                <div class="border-b border-gray-100 pb-4">
                    <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        WhatsApp Human Support Handover & Contact Routing
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">When a customer requests human support or clicks "Speak with Human", the bot connects them directly to WhatsApp. For email inquiries, customers are directed to your store's Contact page to fill out the form.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">WhatsApp Support Number</label>
                        <input
                            type="text"
                            name="chatbot_handover_whatsapp"
                            value={config.handoverWhatsapp}
                            required
                            placeholder="e.g. 923112390620 or 03112390620"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-brand-orange focus:border-brand-orange"
                        />
                        <span class="text-[11px] text-gray-400 mt-1 block">The WhatsApp number where customers will be connected when requesting human support.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">Contact Page URL (For Email Inquiries)</label>
                        <input
                            type="text"
                            name="chatbot_handover_contact_url"
                            value={config.handoverContactUrl === "/contact" ? "/contact/" : config.handoverContactUrl}
                            required
                            placeholder="/contact/"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-brand-orange focus:border-brand-orange"
                        />
                        <span class="text-[11px] text-gray-400 mt-1 block">Customers asking for email support will be directed to this page to fill out the contact form.</span>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">Pre-filled WhatsApp Message</label>
                        <input
                            type="text"
                            name="chatbot_handover_whatsapp_prefill"
                            value={config.handoverWhatsappPrefill}
                            required
                            placeholder="Hello Gionee Support, I need assistance with my order/query from the store."
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-brand-orange focus:border-brand-orange"
                        />
                        <span class="text-[11px] text-gray-400 mt-1 block">Default message automatically pre-filled in the customer's WhatsApp chat when they click the WhatsApp button.</span>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">In-Chat Handover Message</label>
                        <textarea
                            name="chatbot_handover_message"
                            rows="2"
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-brand-orange focus:border-brand-orange"
                        >{config.handoverMessage}</textarea>
                        <span class="text-[11px] text-gray-400 mt-1 block">Message displayed in the chat widget when the customer requests to speak with a human agent.</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-brand-orange text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm hover:bg-orange-600 transition-colors cursor-pointer flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        Save Handover Settings
                    </button>
                </div>
            </form>

            <!-- Test WhatsApp Link Card -->
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-sm text-gray-900">Verify WhatsApp Direct Link</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Test the generated WhatsApp link to ensure it correctly opens your official support chat.</p>
                    </div>
                    <span class="px-2.5 py-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg">Live Test</span>
                </div>
                
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="font-mono text-xs text-gray-700 break-all">
                        https://wa.me/{config.handoverWhatsapp.replace(/[^0-9]/g, '')}?text={encodeURIComponent(config.handoverWhatsappPrefill)}
                    </div>
                    <a
                        href={`https://wa.me/${config.handoverWhatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(config.handoverWhatsappPrefill)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2 shrink-0 cursor-pointer"
                    >
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
                        </svg>
                        Test WhatsApp Support Link
                    </a>
                </div>
            </div>
        </div>
    )}

    <!-- TAB 6: SECURITY & RETENTION -->
    {activeTab === "security" && (
        <div class="space-y-6">
            <form method="POST" action="?tab=security" class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm space-y-6">
                <input type="hidden" name="action" value="save_security_settings" />
                <div>
                    <h2 class="text-base font-bold text-gray-900">Abuse Protection & Storage Retention</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Prevent bot spam, rate limit visitors, and manage database storage size.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">Max Messages Per Hour (per IP/Session)</label>
                        <input type="number" min="5" max="200" name="chatbot_rate_limit_per_hour" value={config.rateLimitPerHour} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-brand-orange focus:border-brand-orange" />
                        <span class="text-[11px] text-gray-400 mt-1 block">Default: 30 messages per hour. Protects against automated scrapers.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">Chat History Retention (Days)</label>
                        <input type="number" min="7" max="365" name="chatbot_retention_days" value={config.retentionDays} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-brand-orange focus:border-brand-orange" />
                        <span class="text-[11px] text-gray-400 mt-1 block">Conversations older than this number of days can be auto-pruned.</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-5 py-2.5 bg-brand-orange text-white text-xs sm:text-sm font-bold rounded-lg shadow-sm hover:bg-orange-600 transition-colors">
                        Save Security Rules
                    </button>
                </div>
            </form>

            <div class="bg-red-50 border border-red-200 p-6 rounded-xl shadow-sm">
                <h3 class="font-bold text-sm text-red-900">Clear All Chat Conversations</h3>
                <p class="text-xs text-red-700 mt-1">This will permanently delete all stored chat transcripts and reset conversation counters. Settings and FAQs will not be deleted.</p>
                <form method="POST" class="mt-4" onsubmit="return confirm('WARNING: Are you sure you want to delete ALL chat conversations? This cannot be undone.');">
                    <input type="hidden" name="action" value="clear_conversations" />
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white text-xs font-bold rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                        Clear Stored Conversations
                    </button>
                </form>
            </div>
        </div>
    )}

    <!-- TAB 7: CONVERSATIONS INSPECTOR -->
    {activeTab === "conversations" && (
        <div class="space-y-6">
            {selectedConv ? (
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                        <div>
                            <a href="?tab=conversations" class="text-xs font-semibold text-brand-orange hover:underline mb-1 inline-block">&larr; Back to all conversations</a>
                            <h2 class="text-lg font-bold text-gray-900">Conversation: <span class="font-mono text-base">{selectedConv.id}</span></h2>
                            <p class="text-xs text-gray-500">Started: {formatPktTime(selectedConv.created_at)} • Last Updated: {formatPktTime(selectedConv.updated_at)}</p>
                        </div>
                        <span class={`inline-flex px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                            selectedConv.status === 'handed_over' ? 'bg-amber-100 text-amber-800' :
                            selectedConv.status === 'resolved' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'
                        }`}>
                            {selectedConv.status.replace('_', ' ')}
                        </span>
                    </div>

                    {selectedConv.customer_name && (
                        <div class="bg-gray-50 p-4 rounded-lg text-xs space-y-1">
                            <p><strong>Customer Name:</strong> {selectedConv.customer_name}</p>
                            <p><strong>Phone:</strong> {selectedConv.customer_phone || 'None'}</p>
                            <p><strong>Email:</strong> {selectedConv.customer_email || 'None'}</p>
                            {selectedConv.handover_reason && <p><strong>Handover Reason:</strong> {selectedConv.handover_reason}</p>}
                        </div>
                    )}

                    <!-- Message Transcript Stream -->
                    <div class="space-y-3 bg-gray-50 p-4 rounded-xl max-h-[500px] overflow-y-auto">
                        {selectedConvMessages.length === 0 ? (
                            <p class="text-center text-xs text-gray-400 py-6">No messages found for this conversation.</p>
                        ) : (
                            selectedConvMessages.map((m) => {
                                const isUser = m.role === 'user';
                                const isUrdu = /[\u0600-\u06FF]/.test(m.content || '');
                                return (
                                    <div class={`flex ${isUser ? 'justify-end' : 'justify-start'}`}>
                                        <div class={`max-w-[85%] rounded-xl p-3 text-xs leading-relaxed ${
                                            isUser ? 'bg-brand-orange text-white' : 'bg-white text-gray-800 border border-gray-200'
                                        } ${isUrdu ? 'font-beiruti text-[13px]' : ''}`} dir={isUrdu ? 'rtl' : 'ltr'}>
                                            <div class="text-[10px] opacity-75 font-semibold uppercase mb-1 flex items-center gap-1.5 flex-wrap">
                                                <span>{isUser ? 'Customer' : 'Gionee Assistant'}</span>
                                                {!isUser && m.name && (
                                                    <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-orange-100 text-brand-orange border border-orange-200 uppercase">
                                                        {m.name}
                                                    </span>
                                                )}
                                                <span>• {formatPktTime(m.created_at)}</span>
                                            </div>
                                            <div class="whitespace-pre-wrap">{m.content}</div>
                                        </div>
                                    </div>
                                );
                            })
                        )}
                    </div>
                </div>
            ) : (
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="p-4 sm:px-6 border-b border-gray-100 flex items-center justify-between">
                        <div>
                            <h2 class="font-bold text-base text-gray-900">All Logged Conversations ({recentConversations.length})</h2>
                            <p class="text-xs text-gray-500 mt-0.5">Click "Inspect" on any conversation to view the full dialogue transcript.</p>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs sm:text-sm min-w-[700px]">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 uppercase text-[11px] font-semibold border-b border-gray-200">
                                    <th class="py-3 px-4">Conversation ID</th>
                                    <th class="py-3 px-4">Customer</th>
                                    <th class="py-3 px-4">Status</th>
                                    <th class="py-3 px-4">Messages</th>
                                    <th class="py-3 px-4">Last Message Snippet</th>
                                    <th class="py-3 px-4">Time (PKT)</th>
                                    <th class="py-3 px-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                {recentConversations.length === 0 ? (
                                    <tr>
                                        <td colspan="7" class="py-8 text-center text-gray-400 text-xs">
                                            No conversations recorded yet.
                                        </td>
                                    </tr>
                                ) : (
                                    recentConversations.map((c) => (
                                        <tr class="hover:bg-gray-50/70 transition-colors">
                                            <td class="py-3 px-4 font-mono text-[11px] text-gray-600 truncate max-w-[130px]">{c.id}</td>
                                            <td class="py-3 px-4">
                                                <div class="font-semibold text-gray-900">{c.customer_name || "Guest Visitor"}</div>
                                                <div class="text-[11px] text-gray-400">{c.customer_phone || "Anonymous"}</div>
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class={`inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                                                    c.status === 'handed_over' ? 'bg-amber-100 text-amber-800' :
                                                    c.status === 'resolved' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'
                                                }`}>
                                                    {c.status.replace('_', ' ')}
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-gray-600 font-semibold">{c.message_count}</td>
                                            <td class="py-3 px-4 text-gray-500 truncate max-w-[200px] text-xs">{c.last_message || "—"}</td>
                                            <td class="py-3 px-4 text-gray-500 text-xs whitespace-nowrap">{formatPktTime(c.updated_at)}</td>
                                            <td class="py-3 px-4 text-right">
                                                <a href={`?tab=conversations&conv=${c.id}`} class="px-2.5 py-1 text-xs font-semibold text-brand-orange bg-orange-50 hover:bg-orange-100 rounded transition-colors">
                                                    Inspect
                                                </a>
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            )}
        </div>
    )}

    <!-- TAB 8: LIVE SIMULATOR SANDBOX -->
