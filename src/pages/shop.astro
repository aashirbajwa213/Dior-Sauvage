---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/ui/Icon.astro";
import { singleSauvageProduct } from "../data/product";

const seoTitle = "Shop Dior Sauvage 100ml | 100% Original Perfume Pakistan";
const seoDescription = "Browse authentic Christian Dior Sauvage Eau de Parfum 100ml. 100% original imported fragrance with batch code verification and Cash on Delivery in Pakistan.";

const db = Astro.locals.runtime?.env?.DB;
let productsList: any[] = [];

if (db) {
	try {
		const productsResult = await db.prepare("SELECT * FROM products ORDER BY id ASC").all();
		productsList = productsResult.results || [];
		
		for (const prod of productsList) {
			try { 
				prod.images = JSON.parse(prod.images); 
			} catch(e) { 
				prod.images = []; 
			}
			
			const packsResult = await db.prepare("SELECT * FROM product_packs WHERE product_id = ? ORDER BY unit_count ASC").bind(prod.id).all();
			prod.packs = packsResult.results || [];
			
			const reviewStats = await db.prepare("SELECT COUNT(*) as count, AVG(rating) as avg_rating FROM reviews WHERE product_id = ?").bind(prod.id).first();
			prod.reviewCount = prod.review_count || 1840;
			prod.rating = reviewStats?.avg_rating ? parseFloat(Number(reviewStats.avg_rating).toFixed(1)) : (prod.rating || 4.9);
		}
	} catch (e) {
		console.error("Failed to fetch products/packs from D1 in shop page:", e);
	}
}

if (productsList.length === 0) {
	productsList = [singleSauvageProduct];
}
const shopItemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": "Christian Dior Sauvage Collection Pakistan",
	"numberOfItems": productsList.length,
	"itemListElement": productsList.map((prod: any, index: number) => ({
		"@type": "ListItem",
		"position": index + 1,
		"url": `https://sauvagedior.pk/${prod.slug || 'dior-sauvage-100ml'}/`,
		"name": prod.title,
	})),
};
---

<MainLayout
	title={seoTitle}
	description={seoDescription}
	schema={shopItemListSchema}
>
    {/* Page Header */}
    <PageHeader
        title="Dior Sauvage Collection"
        tagline="Discover the world's most iconic luxury fragrance for men. 100% authentic Christian Dior Sauvage Eau de Parfum 100ml with verifiable batch code guarantee."
    />

    {/* Shop Content Layout */}
    <div class="container mx-auto px-4 max-w-7xl py-12 lg:py-20">
        
        {/* Active Filters / Sorting Bar */}
        <div class="flex flex-col sm:flex-row justify-between items-center bg-white border border-gray-100 p-4 rounded-xl shadow-sm mb-8 gap-4 max-w-4xl mx-auto">
            <div class="text-gray-500 text-sm font-medium">
                Showing <span class="text-gray-900 font-bold">{productsList.length}</span> signature fragrance
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                In Stock & Ready to Ship (TCS / Leopards)
            </div>
        </div>

        <div class="max-w-md mx-auto">
            {productsList.map((product: any) => (
                <div class="group h-full shadow-lg rounded-2xl overflow-hidden border border-slate-100">
                    <ProductCard
                        id={product.id}
                        title={product.title}
                        price={product.base_price}
                        originalPrice={product.original_price}
                        rating={product.rating || 4.9}
                        reviewCount={product.reviewCount || 1840}
                        image={Array.isArray(product.images) && product.images.length > 0 ? (typeof product.images[0] === 'string' ? product.images[0] : product.images[0]?.url) : (product.image || "/images/sauvage-dior/sauvage-4.jpg")}
                        href={product.slug.startsWith('/') ? product.slug : `/${product.slug}/`}
                        badge={(product.badge && product.badge !== "Best Seller") ? product.badge : "Brand Leftover Lot"}
                        packs={product.packs && product.packs.length > 0 ? product.packs : singleSauvageProduct.packs}
                    />
                </div>
            ))}
        </div>

        {/* Value Props Bar */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto mt-16 pt-12 border-t border-gray-100">
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg">
                    ✓
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-sm">100% Original Sourced</h4>
                    <p class="text-xs text-slate-500">Authentic batch codes verifiable on CheckFresh</p>
                </div>
            </div>
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg">
                    ⚡
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-sm">12+ Hours Longevity</h4>
                    <p class="text-xs text-slate-500">Unrivaled projection and sillage all day</p>
                </div>
            </div>
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
                    📦
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-sm">Transit Damage Protection</h4>
                    <p class="text-xs text-slate-500">48-Hour free replacement guarantee on COD</p>
                </div>
            </div>
        </div>
    </div>
</MainLayout>
