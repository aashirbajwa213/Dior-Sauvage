---
import "../styles/global.css";
import ChatWidget from "../components/chat/ChatWidget.astro";

// Fonts are now preloaded and defined in global.css

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	disableTracking?: boolean;
}

const { title, description = "Dior Sauvage Eau de Parfum 100ml Pakistan - 100% Original Authentic Perfume with Checking Warranty", image = "/images/sauvage-dior/sauvage-4.jpg", noindex = false, disableTracking = false } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Google Font: Lato -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">

		<meta name="description" content={description} />
		{noindex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		)}
		<meta name="publisher" content="Dior Sauvage Pakistan" />
		<link rel="canonical" href={Astro.url.href} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<meta
			name="google-site-verification"
			content="lAHoVZv_W5uGOMVUP3FPs1d4KRaYQk6hcPZPTlJTK7E"
		/>
		<title>{title}</title>
		<slot name="head" />

		<!-- Resource Hints -->
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="preconnect" href="https://connect.facebook.net" crossorigin />

		<!-- Deferred Google Tag Manager & Meta Pixel -->
		{!disableTracking && (
		<script is:inline define:vars={{ gtmId: "GTM-NT9BRMJP", pixelId: "1612216799847193" }}>
			(function () {
				let loaded = false;
				function loadTracking() {
					if (loaded) return;
					loaded = true;
					
					// Load GTM
					if (gtmId) {
						const gtmScript = document.createElement('script');
						gtmScript.async = true;
						gtmScript.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
						document.head.appendChild(gtmScript);
						window.dataLayer = window.dataLayer || [];
						window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
					}

					// Load Meta Pixel
					if (pixelId) {
						!function(f,b,e,v,n,t,s)
						{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
						n.callMethod.apply(n,arguments):n.queue.push(arguments)};
						if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
						n.queue=[];t=b.createElement(e);t.async=!0;
						t.src=v;s=b.getElementsByTagName(e)[0];
						s.parentNode.insertBefore(t,s)}(window, document,'script',
						'https://connect.facebook.net/en_US/fbevents.js');
						window.fbq('init', pixelId);
						window.fbq('track', 'PageView');
					}
				}

				const events = ['pointermove', 'scroll', 'touchstart', 'keydown'];
				events.forEach(event => window.addEventListener(event, loadTracking, { once: true, passive: true }));

				window.addEventListener('load', () => {
					if ('requestIdleCallback' in window) {
						requestIdleCallback(loadTracking, { timeout: 2500 });
					} else {
						setTimeout(loadTracking, 1500);
					}
				});
			})();
		</script>
		)}

		<!-- Cloudflare Turnstile -->
		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer></script>

		<slot name="head" />
	</head>
	<body
		class="bg-gray-50 text-gray-900 font-sans antialiased selection:bg-brand-orange selection:text-white"
	>
		<!-- Google Tag Manager (noscript) -->
		{!disableTracking && (
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NT9BRMJP"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		)}
		<!-- End Google Tag Manager (noscript) -->
		<slot />
		{!isAdmin && <ChatWidget />}
	</body>
</html>
