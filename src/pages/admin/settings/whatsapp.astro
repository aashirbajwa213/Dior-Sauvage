                                    </div>
                                </div>
                                <div class="p-2.5 bg-orange-50/60 rounded-xl border border-orange-100">
                                    <span class="text-[11px] font-semibold text-brand-orange block mb-1">Insert Anti-Ban Spintax:</span>
                                    <div class="flex flex-wrap gap-1">
                                        <button type="button" class="insert-tag px-2 py-0.5 bg-white border border-orange-200 rounded text-[11px] font-mono text-brand-orange hover:bg-orange-100 transition-colors cursor-pointer" data-target="template_input_confirmation" data-tag="&#123;Assalam-o-Alaikum|Hello|Hi&#125;">Greeting Spintax</button>
                                        <button type="button" class="insert-tag px-2 py-0.5 bg-white border border-orange-200 rounded text-[11px] font-mono text-brand-orange hover:bg-orange-100 transition-colors cursor-pointer" data-target="template_input_confirmation" data-tag="&#123;Shukriya|Thank you|Bohat shukriya&#125;">Closing Spintax</button>
                                        <button type="button" class="insert-tag px-2 py-0.5 bg-white border border-orange-200 rounded text-[11px] font-mono text-brand-orange hover:bg-orange-100 transition-colors cursor-pointer" data-target="template_input_confirmation" data-tag="&#123;Option 1|Option 2|Option 3&#125;">Custom Spintax</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Live WhatsApp Mockup -->
