                                    <th class="py-2.5 px-3 text-center font-semibold text-rose-600 bg-rose-50/50">Pending Pickup</th>
                                    <th class="py-2.5 px-3 text-center font-semibold text-emerald-600 bg-emerald-50/30">Received</th>
