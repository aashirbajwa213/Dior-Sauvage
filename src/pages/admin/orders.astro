---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import Pagination from "../../components/admin/Pagination.astro";
import ColumnSelector from "../../components/admin/ColumnSelector.astro";
import { addTimelineEntry, getDefaultTimelineContent } from "../../utils/timeline";
import { getAllSettings } from "../../utils/settings";
import { getCourierTrackingUrl, getCourierProviderName, COURIER_PROVIDERS, getCachedCourierCities } from "../../utils/courier";

const orderColumns = [
    { id: "order_id", label: "Order ID", defaultVisible: true },
    { id: "customer", label: "Customer Details", defaultVisible: true },
    { id: "date", label: "Date & Time", defaultVisible: true },
    { id: "amount", label: "Total Amount", defaultVisible: true },
    { id: "risk", label: "Health / Risk", defaultVisible: true },
    { id: "status", label: "Status", defaultVisible: true },
    { id: "tracking", label: "Tracking ID", defaultVisible: true },
    { id: "action", label: "Action", defaultVisible: true },
];

const seoTitle = "Admin Orders - Dior Sauvage Pakistan";

const url = new URL(Astro.request.url);
const search = url.searchParams.get("search") || "";
const statusFilter = url.searchParams.get("status") || "";
const riskFilter = url.searchParams.get("risk") || "";

const page = parseInt(url.searchParams.get("page") || "1");
const limit = parseInt(url.searchParams.get("limit") || "20");
const offset = (page - 1) * limit;

const period = url.searchParams.get("period") || "all";
const customStart = url.searchParams.get("start") || "";
const customEnd = url.searchParams.get("end") || "";

let nowPktStr = new Date().toLocaleString("en-US", { timeZone: "Asia/Karachi" });
let startDate = new Date(nowPktStr);
let endDate = new Date(nowPktStr);

if (period === "today") {
    startDate.setHours(0, 0, 0, 0);
} else if (period === "yesterday") {
    startDate.setDate(startDate.getDate() - 1);
    startDate.setHours(0, 0, 0, 0);
    endDate = new Date(startDate);
    endDate.setHours(23, 59, 59, 999);
} else if (period === "this_week") {
    const day = startDate.getDay();
    const diff = startDate.getDate() - day + (day === 0 ? -6 : 1);
    startDate.setDate(diff);
    startDate.setHours(0, 0, 0, 0);
} else if (period === "this_month") {
    startDate.setDate(1);
    startDate.setHours(0, 0, 0, 0);
} else if (period === "last_30_days") {
    startDate.setDate(startDate.getDate() - 30);
    startDate.setHours(0, 0, 0, 0);
} else if (period === "custom" && customStart && customEnd) {
    startDate = new Date(customStart + "T00:00:00");
    endDate = new Date(customEnd + "T23:59:59");
}

const PKT_OFFSET = 5 * 60 * 60 * 1000;
startDate.setTime(startDate.getTime() - PKT_OFFSET);
endDate.setTime(endDate.getTime() - PKT_OFFSET);

const startStr = startDate.toISOString();
const endStr = endDate.toISOString();

const db = Astro.locals.runtime?.env?.DB;

let courierSettings: any = null;
let activeCourier: any = COURIER_PROVIDERS.postex;
let cachedCities: string[] = [];
let availableProducts: any[] = [];

let orders: any[] = [];
let errorMsg = "";
let successMsg = "";
let totalItems = 0;
let totalPages = 0;
let stats = {
    total: 0,
    pending: 0,
    shipped: 0,
    out_for_delivery: 0,
    delivered: 0,
    revenue: 0,
};

if (!db) {
    errorMsg = "Cloudflare D1 Database binding is missing. Please check your wrangler.toml or start development using Astro proxy.";
} else {
    try {
        try {
            courierSettings = await getAllSettings(db);
            const provKey = courierSettings.courier_default_provider || "postex";
            activeCourier = COURIER_PROVIDERS[provKey] || COURIER_PROVIDERS.postex;
        } catch (e) {
            console.error("Failed to load courier settings:", e);
        }

        try {
            cachedCities = await getCachedCourierCities(db, false);
        } catch (e) {
            console.error("Failed to load cities for orders modal:", e);
        }

        try {
            const { results: prods } = await db.prepare("SELECT id, title, slug, base_price, original_price FROM products WHERE status = 'published' ORDER BY id ASC").all();
            const { results: packs } = await db.prepare("SELECT id, product_id, pack_label, unit_count, pack_price, free_shipping FROM product_packs ORDER BY product_id ASC, unit_count ASC").all();
            
            availableProducts = (prods || []).map((p: any) => {
                const productPacks = (packs || []).filter((pk: any) => pk.product_id === p.id);
                return {
                    id: p.id,
                    title: p.title,
                    slug: p.slug,
                    base_price: p.base_price,
                    original_price: p.original_price,
                    packs: productPacks.map((pk: any) => ({
                        id: pk.id,
                        label: pk.pack_label,
                        unit_count: pk.unit_count,
                        price: pk.pack_price,
                        free_shipping: pk.free_shipping === 1
                    }))
                };
            });
        } catch (e) {
            console.error("Failed to load products for manual booking modal:", e);
        }

        // 1. Fetch Stats
        const totalStats: any = await db.prepare(`
            SELECT 
                COUNT(*) as total, 
                SUM(CASE WHEN status = 'Pending' THEN 1 ELSE 0 END) as pending,
                SUM(CASE WHEN status = 'Shipped' THEN 1 ELSE 0 END) as shipped,
                SUM(CASE WHEN status = 'Out for Delivery' THEN 1 ELSE 0 END) as out_for_delivery,
                SUM(CASE WHEN status = 'Delivered' THEN 1 ELSE 0 END) as delivered,
                SUM(CASE WHEN status != 'Cancelled' THEN total_amount ELSE 0 END) as revenue
            FROM orders
        `).first();
        
        if (totalStats) {
            stats.total = totalStats.total || 0;
            stats.pending = totalStats.pending || 0;
            stats.shipped = totalStats.shipped || 0;
            stats.out_for_delivery = totalStats.out_for_delivery || 0;
            stats.delivered = totalStats.delivered || 0;
            stats.revenue = totalStats.revenue || 0;
        }

        // 1. Handle Status Updates & Actions (POST)
        if (Astro.request.method === "POST") {
            const formData = await Astro.request.formData();
            const action = formData.get("action")?.toString();

            if (action === "create_booking") {
                const manualId = formData.get("order_id")?.toString().replace(/^#+/, '').trim();
                let orderId = manualId;

                if (!orderId) {
                    const pakTime = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Karachi" }));
                    const currentMonth = String(pakTime.getMonth() + 1).padStart(2, '0');
                    const orderPrefix = `GPK${currentMonth}`;
                    try {
                        const latestOrder = await db.prepare("SELECT id FROM orders WHERE id LIKE ? ORDER BY CAST(SUBSTR(id, 6) AS INTEGER) DESC LIMIT 1").bind(`${orderPrefix}%`).first();
                        let sequence = 1;
                        if (latestOrder && latestOrder.id) {
                            const seqStr = String(latestOrder.id).substring(orderPrefix.length);
                            const seqInt = parseInt(seqStr, 10);
                            if (!isNaN(seqInt)) sequence = seqInt + 1;
                        }
                        orderId = `${orderPrefix}${String(sequence).padStart(3, '0')}`;
                    } catch (e) {
                        orderId = `${orderPrefix}${Math.random().toString(10).substring(2, 5)}`;
                    }
                }

                const customerName = formData.get("customer_name")?.toString() || "";
                const customerPhone = formData.get("customer_phone")?.toString() || "";
                const customerEmail = formData.get("customer_email")?.toString() || "";
                const city = formData.get("city")?.toString() || "";
                const address = formData.get("address")?.toString() || "";
                const totalAmount = parseFloat(formData.get("total_amount")?.toString() || "0");
                const deliveryFee = parseFloat(formData.get("delivery_fee")?.toString() || "0");
                const trackingNo = formData.get("tracking_no")?.toString() || null;
                const status = formData.get("status")?.toString() || "Pending";
                let orderSummary = formData.get("order_summary")?.toString() || "";
                const customDate = formData.get("created_at")?.toString();
                const itemsJson = formData.get("items_json")?.toString();
                
                let createdAtObj = new Date();
                if (customDate) {
                    try {
                        const parsedDate = new Date(`${customDate}+05:00`);
                        if (!isNaN(parsedDate.getTime())) {
                            createdAtObj = parsedDate;
                        }
                    } catch (e) {}
                }
                const createdAt = createdAtObj.toISOString().replace('T', ' ').replace(/\.\d{3}Z$/, '');

                try {
                    let parsedItems: any[] = [];
                    if (itemsJson) {
                        try {
                            parsedItems = JSON.parse(itemsJson);
                        } catch (e) {}
                    }

                    if (!orderSummary && parsedItems.length > 0) {
                        orderSummary = parsedItems.map(item => `${item.productName || item.product_name} (${item.packSizeLabel || item.pack_size_label || '1 Unit'}) x${item.quantity}`).join(", ");
                    }

                    await db.prepare(`
                        INSERT INTO orders (
                            id, customer_name, customer_phone, customer_email, city, address, 
                            total_amount, delivery_fee, status, tracking_no, 
                            order_summary, created_at
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    `).bind(
                        orderId, customerName, customerPhone, customerEmail, city, address,
                        totalAmount, deliveryFee, status, trackingNo, orderSummary, createdAt
                    ).run();

                    // Insert individual items into order_items table
                    if (parsedItems.length > 0) {
                        for (const item of parsedItems) {
                            const prodId = item.productId || item.product_id || 1;
                            const prodName = item.productName || item.product_name || "Dior Sauvage 100ml";
                            const unitPrice = parseFloat(item.unitPrice || item.unit_price || item.price || 0);
                            const quantity = parseInt(item.quantity || 1, 10);
                            const packLabel = item.packSizeLabel || item.pack_size_label || "1 Unit";

                            await db.prepare(`
                                INSERT INTO order_items (order_id, product_id, product_name, unit_price, quantity, pack_size_label)
                                VALUES (?, ?, ?, ?, ?, ?)
                            `).bind(
                                orderId, prodId, prodName, unitPrice, quantity, packLabel
                            ).run();
                        }
                    } else if (orderSummary) {
                        await db.prepare(`
                            INSERT INTO order_items (order_id, product_id, product_name, unit_price, quantity, pack_size_label)
                            VALUES (?, ?, ?, ?, ?, ?)
                        `).bind(
                            orderId, 1, orderSummary, Math.max(0, totalAmount - deliveryFee), 1, "Standard Pack"
                        ).run();
                    }

                    // Auto-calculate Order Health Score and sync Customer Profile (Real-Time)
                    try {
                        const { syncOrderRiskAndCustomer } = await import("../../utils/orderRiskSync");
                        await syncOrderRiskAndCustomer(db, orderId);
                    } catch (syncErr) {
                        console.error(`Failed to auto-sync risk & customer for manual order #${orderId}:`, syncErr);
                    }

                    const { title, description } = getDefaultTimelineContent(status);
                    await addTimelineEntry(db, orderId, status, "Manual Booking Created", `Admin manually created this booking with status: ${status}.`);
                    successMsg = `Manual booking #${orderId} successfully created.`;
                } catch (e: any) {
                    errorMsg = `Failed to create booking: ${e.message}`;
                }
            } else if (action === "delete") {
                const orderId = formData.get("order_id")?.toString();
                if (orderId) {
                    await db.prepare("DELETE FROM order_items WHERE order_id = ?").bind(orderId).run();
                    await db.prepare("DELETE FROM order_timeline WHERE order_id = ?").bind(orderId).run();
                    await db.prepare("DELETE FROM orders WHERE id = ?").bind(orderId).run();
                    successMsg = `Order #${orderId} successfully deleted.`;
                }
            } else if (action === "bulk_book_shipments") {
                const orderIdsRaw = formData.get("order_ids")?.toString();
                if (orderIdsRaw) {
                    const orderIds = orderIdsRaw.split(",").filter(id => id.trim() !== "");
                    let successCount = 0;
                    let errorCount = 0;
                    const failedReasons: string[] = [];
                    if (orderIds.length > 0) {
                        const { createCourierOrder, COURIER_PROVIDERS } = await import("../../utils/courier");
                        
                        for (const id of orderIds) {
                            const currentOrder: any = await db.prepare("SELECT status, tracking_no, city, address, customer_name, customer_phone, customer_email, total_amount FROM orders WHERE id = ?").bind(id).first();
                            
                            if (currentOrder && !currentOrder.tracking_no && (currentOrder.status === 'Pending' || currentOrder.status === 'Confirmed')) {
                                const { results: items } = await db.prepare("SELECT product_name, quantity FROM order_items WHERE order_id = ?").bind(id).all();
                                const productDesc = (items || []).map((i: any) => `${i.product_name} (${i.quantity} Units)`).join(", ");
                                
                                const bookingResult = await createCourierOrder(db, {
                                    receiverName: currentOrder.customer_name,
                                    receiverPhone: currentOrder.customer_phone,
                                    receiverEmail: currentOrder.customer_email || "",
                                    receiverAddress: currentOrder.address,
                                    destinationCity: currentOrder.city,
                                    pieces: (items || []).reduce((sum: number, i: any) => sum + i.quantity, 0) || 1,
                                    weight: 1,
                                    collectionAmount: currentOrder.total_amount,
                                    productDescription: productDesc,
                                    orderId: String(id)
                                });
                                
                                if (bookingResult.success && bookingResult.data && bookingResult.data.tracking_no) {
                                    const trackingNo = (bookingResult.data.thirdparty_tracking_no && bookingResult.data.thirdparty_tracking_no !== "null" && bookingResult.data.thirdparty_tracking_no !== "")
                                        ? String(bookingResult.data.thirdparty_tracking_no)
                                        : String(bookingResult.data.tracking_no);
                                    const courierId = String(bookingResult.data.id);
                                    const providerUsed = bookingResult.providerUsed || "postex";
                                    const providerLabel = (bookingResult.providerUsed && COURIER_PROVIDERS[bookingResult.providerUsed]?.name) || "RS Courier";

                                    await db.prepare("UPDATE orders SET tracking_no = ?, courier_order_id = ?, courier_provider = ?, status = 'Booked' WHERE id = ?").bind(trackingNo, courierId, providerUsed, id).run();
                                    await addTimelineEntry(db, id, "Booked", "Shipment Booked", `Admin booked shipment via ${providerLabel} in bulk. Tracking ID: ${trackingNo}`);
                                    successCount++;
                                } else {
                                    errorCount++;
                                    const err = bookingResult.error || "Unknown error";
                                    failedReasons.push(`Order #${id} (${currentOrder.city}): ${err}`);
                                    console.error(`Bulk booking failed for ${id}:`, err);
                                }
                            }
                        }
                        
                        if (successCount > 0) {
                            successMsg = `${successCount} shipments successfully booked.`;
                        }
                        if (errorCount > 0) {
                            const details = failedReasons.slice(0, 3).join("; ");
                            errorMsg = errorMsg ? `${errorMsg} Failed to book ${errorCount} shipments: ${details}` : `Failed to book ${errorCount} shipments: ${details}`;
                        }
                        if (successCount === 0 && errorCount === 0) {
                            errorMsg = "No eligible orders selected for booking (must be Pending/Confirmed without an existing tracking ID).";
                        }
                    }
                }
            } else if (action === "bulk_delete") {
                const orderIdsRaw = formData.get("order_ids")?.toString();
                if (orderIdsRaw) {
                    const orderIds = orderIdsRaw.split(",").filter(id => id.trim() !== "");
                    if (orderIds.length > 0) {
                        for (const id of orderIds) {
                            await db.prepare("DELETE FROM order_items WHERE order_id = ?").bind(id).run();
                            await db.prepare("DELETE FROM order_timeline WHERE order_id = ?").bind(id).run();
                            await db.prepare("DELETE FROM orders WHERE id = ?").bind(id).run();
                        }
                        successMsg = `${orderIds.length} orders successfully deleted.`;
                    }
                }
            } else if (action === "bulk_update_status") {
                const orderIdsRaw = formData.get("order_ids")?.toString();
                const newStatus = formData.get("new_status")?.toString();
                if (orderIdsRaw && newStatus) {
                    const orderIds = orderIdsRaw.split(",").filter(id => id.trim() !== "");
                    if (orderIds.length > 0) {
                        for (const id of orderIds) {
                            if (newStatus === "Shipped") {
                                await db.prepare("UPDATE orders SET status = ?, shipped_at = CURRENT_TIMESTAMP WHERE id = ?").bind(newStatus, id).run();
                            } else if (newStatus === "Delivered") {
                                await db.prepare("UPDATE orders SET status = ?, delivered_at = CURRENT_TIMESTAMP WHERE id = ?").bind(newStatus, id).run();
                            } else {
                                await db.prepare("UPDATE orders SET status = ? WHERE id = ?").bind(newStatus, id).run();
                            }
                            const { title, description } = getDefaultTimelineContent(newStatus);
                            await addTimelineEntry(db, id, newStatus, title, description);

                            // Email/WhatsApp Notifications for Shipped
                            if (newStatus === "Shipped") {
                                try {
                                    const shippedOrder = await db.prepare("SELECT * FROM orders WHERE id = ?").bind(id).first();
                                    if (shippedOrder) {
                                        const trackingUrl = `https://sauvagedior.pk/track-order/${shippedOrder.id}/`;
                                        const trackingNo = shippedOrder.tracking_no || "N/A";
                                        const { sendShippedNotifications } = await import("../../utils/notifications");
                                        await sendShippedNotifications(db, Astro.locals.runtime?.env, shippedOrder, trackingNo, trackingUrl);
                                    }
                                } catch (err: any) {
                                    console.error(`Failed to process bulk Shipped notifications for ${id}:`, err);
                                }
                            } else if (newStatus === "Out for Delivery") {
                                try {
                                    const targetOrder = await db.prepare("SELECT * FROM orders WHERE id = ?").bind(id).first();
                                    if (targetOrder) {
                                        const { sendOrderOutForDeliveryAlert } = await import("../../utils/whatsapp");
                                        await sendOrderOutForDeliveryAlert(db, Astro.locals.runtime?.env, targetOrder, targetOrder.tracking_no, targetOrder.courier_status, { forceSend: true });

                                        const { sendOrderOutForDeliveryEmail } = await import("../../utils/notifications");
                                        await sendOrderOutForDeliveryEmail(db, Astro.locals.runtime?.env, targetOrder, targetOrder.tracking_no, targetOrder.courier_status, { forceSend: true });
                                    }
                                } catch (err: any) {
                                    console.error(`Failed to process bulk Out for Delivery alert for ${id}:`, err);
                                }
                            }
                        }
                        successMsg = `${orderIds.length} orders successfully updated to ${newStatus}.`;
                    }
                }
            } else if (action === "cancel_label") {
                const orderId = formData.get("order_id")?.toString();
                if (orderId) {
                    const currentOrder: any = await db.prepare("SELECT tracking_no FROM orders WHERE id = ?").bind(orderId).first();
                    if (currentOrder && currentOrder.tracking_no) {
                        const { cancelCourierOrder } = await import("../../utils/courier");
                        const cancelResult = await cancelCourierOrder(db, currentOrder.tracking_no);
                        
                        if (cancelResult.success) {
                            await db.prepare("UPDATE orders SET tracking_no = NULL, courier_order_id = NULL, courier_status = NULL, status = 'Confirmed' WHERE id = ?").bind(orderId).run();
                            await addTimelineEntry(db, orderId, "Confirmed", "Shipping Label Cancelled", `Admin cancelled the shipping label (${currentOrder.tracking_no}). Status reverted to Confirmed.`);
                            successMsg = "Shipping label successfully cancelled.";
                        } else {
                            errorMsg = `Failed to cancel label via Courier API: ${cancelResult.error}`;
                        }
                    } else {
                        errorMsg = "Order does not have an active shipping label.";
                    }
                }
            } else {
                const orderId = formData.get("order_id")?.toString();
                const newStatus = formData.get("new_status")?.toString();
                
                if (orderId && newStatus) {
                    // Update order and set timestamps if needed
                    if (newStatus === "Shipped") {
                        await db.prepare("UPDATE orders SET status = ?, shipped_at = CURRENT_TIMESTAMP WHERE id = ?").bind(newStatus, orderId).run();
                    } else if (newStatus === "Delivered") {
                        await db.prepare("UPDATE orders SET status = ?, delivered_at = CURRENT_TIMESTAMP WHERE id = ?").bind(newStatus, orderId).run();
                    } else {
                        await db.prepare("UPDATE orders SET status = ? WHERE id = ?").bind(newStatus, orderId).run();
                    }

                    // Log to timeline
                    const { title, description } = getDefaultTimelineContent(newStatus);
                    await addTimelineEntry(db, orderId, newStatus, title, description);

                    if (newStatus === "Shipped") {
                        try {
                            const shippedOrder = await db.prepare("SELECT * FROM orders WHERE id = ?").bind(orderId).first();
                            if (shippedOrder) {
                                const trackingUrl = `https://sauvagedior.pk/track-order/${shippedOrder.id}/`;
                                const trackingNo = shippedOrder.tracking_no || "N/A";
                                const { sendShippedNotifications } = await import("../../utils/notifications");
                                const notifResult = await sendShippedNotifications(db, Astro.locals.runtime?.env, shippedOrder, trackingNo, trackingUrl);
                                
                                if (notifResult.successMsg) successMsg = successMsg ? successMsg + " " + notifResult.successMsg : notifResult.successMsg;
                                if (notifResult.errorMsg) errorMsg = errorMsg ? errorMsg + " " + notifResult.errorMsg : notifResult.errorMsg;
                            }
                        } catch (err: any) {
                            console.error("Failed to process Shipped notifications from orders list:", err);
                        }
                    } else if (newStatus === "Out for Delivery") {
                        try {
                            const targetOrder = await db.prepare("SELECT * FROM orders WHERE id = ?").bind(orderId).first();
                            if (targetOrder) {
                                const { sendOrderOutForDeliveryAlert } = await import("../../utils/whatsapp");
                                const waRes = await sendOrderOutForDeliveryAlert(db, Astro.locals.runtime?.env, targetOrder, targetOrder.tracking_no, targetOrder.courier_status, { forceSend: true });
                                if (waRes.success) {
                                    successMsg = successMsg ? successMsg + " WhatsApp Out for Delivery alert sent." : "WhatsApp Out for Delivery alert sent.";
                                }

                                const { sendOrderOutForDeliveryEmail } = await import("../../utils/notifications");
                                const emailRes = await sendOrderOutForDeliveryEmail(db, Astro.locals.runtime?.env, targetOrder, targetOrder.tracking_no, targetOrder.courier_status, { forceSend: true });
                                if (emailRes.success) {
                                    successMsg = successMsg ? successMsg + " Out for Delivery email sent." : "Out for Delivery email sent.";
                                }
                            }
                        } catch (err: any) {
                            console.error("Failed to process Out for Delivery alert from orders list:", err);
                        }
                    }

                    if (!successMsg && !errorMsg) {
                        successMsg = `Order #${orderId} status successfully updated to ${newStatus}.`;
                    }
                }
            }
        }
        let query = `
            SELECT 
                o.*,
                r.health_score,
                r.risk_level,
                r.all_flags,
                r.recommendations,
                r.is_serial_returner,
                r.is_high_risk_city,
                r.is_landmark_only,
                cp.risk_tier as customer_risk_tier,
                cp.total_returned as customer_lifetime_returns
            FROM orders o
            LEFT JOIN order_risk_scores r ON r.order_id = o.id
            LEFT JOIN customer_profiles cp ON cp.phone = o.customer_phone
        `;

        let params: any[] = [];
        let whereClauses: string[] = [];

        if (search) {
            whereClauses.push(`(o.id LIKE ? OR o.customer_name LIKE ? OR o.customer_phone LIKE ? OR o.city LIKE ?)`);
            const wildSearch = `%${search}%`;
            params.push(wildSearch, wildSearch, wildSearch, wildSearch);
        }

        if (statusFilter) {
            whereClauses.push(`o.status = ?`);
            params.push(statusFilter);
        }

        if (riskFilter) {
            whereClauses.push(`r.risk_level = ?`);
            params.push(riskFilter);
        }
        
        if (period !== 'all') {
            whereClauses.push(`DATETIME(o.created_at) >= DATETIME(?) AND DATETIME(o.created_at) <= DATETIME(?)`);
            params.push(startStr, endStr);
        }

        // 2. Count Total Items for Pagination
        let countQuery = `
            SELECT COUNT(*) as count 
            FROM orders o
            LEFT JOIN order_risk_scores r ON r.order_id = o.id
        `;
        if (whereClauses.length > 0) {
            countQuery += ` WHERE ` + whereClauses.join(" AND ");
        }

        const countStmt = db.prepare(countQuery);
        const countResult: any = params.length > 0 ? await countStmt.bind(...params).first() : await countStmt.first();
        totalItems = countResult?.count || 0;
        totalPages = Math.ceil(totalItems / limit);

        if (whereClauses.length > 0) {
            query += ` WHERE ` + whereClauses.join(" AND ");
        }

        query += ` ORDER BY DATETIME(o.created_at) DESC LIMIT ? OFFSET ?`;
        params.push(limit, offset);

        const stmt = db.prepare(query);
        const { results } = await stmt.bind(...params).all();
        orders = results || [];

        // Auto-score any orders missing health score on-the-fly (Real-Time)
        const unscored = orders.filter((o: any) => o.health_score === null || o.health_score === undefined);
        if (unscored.length > 0) {
            try {
                const { syncOrderRiskAndCustomer } = await import("../../utils/orderRiskSync");
                for (const un of unscored) {
                    const res = await syncOrderRiskAndCustomer(db, un.id);
                    if (res) {
                        un.health_score = res.healthScore;
                        un.risk_level = res.riskLevel;
                    }
                }
            } catch (err) {}
        }

    } catch (e: any) {
        errorMsg = "Database Error: " + e.message;
    }
}

// Function to helper status color
function getStatusStyles(status: string) {
    switch (status) {
        case "Pending":
            return "bg-amber-50 text-amber-700 border-amber-200";
        case "Confirmed":
            return "bg-blue-50 text-blue-700 border-blue-200";
        case "Booked":
            return "bg-purple-50 text-purple-700 border-purple-200";
        case "Shipped":
            return "bg-indigo-50 text-indigo-700 border-indigo-200";
        case "Out for Delivery":
            return "bg-amber-50 text-amber-700 border-amber-300 ring-1 ring-amber-300/50";
        case "Delivered":
            return "bg-emerald-50 text-emerald-700 border-emerald-200";
        case "Returned":
            return "bg-rose-50 text-rose-700 border-rose-200";
        case "Cancelled":
            return "bg-gray-50 text-gray-700 border-gray-200";
        default:
            return "bg-gray-50 text-gray-700 border-gray-200";
    }
}

// Function for health risk badge styling
function getHealthBadgeStyles(score: number | null | undefined, riskLevel: string | null | undefined) {
    if (score === null || score === undefined) {
        return {
            badgeClass: "bg-gray-50 text-gray-600 border-gray-200",
            dotClass: "bg-gray-400",
            label: "N/A"
        };
    }
    if (score < 40 || riskLevel === "Critical") {
        return {
            badgeClass: "bg-red-50 text-red-700 border-red-200 font-semibold ring-1 ring-red-200",
            dotClass: "bg-red-500 animate-pulse",
            label: `${score} Critical`
        };
    }
    if (score < 60 || riskLevel === "High") {
        return {
            badgeClass: "bg-orange-50 text-orange-700 border-orange-200 font-medium",
            dotClass: "bg-orange-500",
            label: `${score} High`
        };
    }
    if (score < 80 || riskLevel === "Medium") {
        return {
            badgeClass: "bg-amber-50 text-amber-700 border-amber-200",
            dotClass: "bg-amber-500",
            label: `${score} Med`
        };
    }
    return {
        badgeClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
        dotClass: "bg-emerald-500",
        label: `${score} Healthy`
    };
}
