                    <div class="relative">
                        <input type="text" id="customerSearchInput" placeholder="Search customer by name or phone (e.g. 03001234567)..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm bg-white" autocomplete="off" />
                        <div id="customerSearchResults" class="absolute z-30 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-xl hidden max-h-48 overflow-y-auto">
                            <!-- Results will be populated here -->
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Order ID</label>
                        <input type="text" name="order_id" placeholder="Auto-generated (e.g. GPK09083)" readonly class="w-full px-3 py-2 border border-gray-200 bg-gray-50 text-gray-500 font-mono rounded-lg focus:outline-none text-xs sm:text-sm cursor-not-allowed" title="Order ID is auto-generated to maintain sequence" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Date & Time (PKT)</label>
                        <input type="datetime-local" name="created_at" id="createBookingDate" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm" />
                    </div>
                    
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Customer Name *</label>
                        <input type="text" name="customer_name" id="book_customer_name" required placeholder="e.g. Muhammad Ali" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Phone No *</label>
                        <input type="text" name="customer_phone" id="book_customer_phone" required placeholder="e.g. 03001234567" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm font-mono" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address (Optional)</label>
                        <input type="email" name="customer_email" id="book_customer_email" placeholder="customer@example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm" />
                    </div>
                    
                    <!-- Searchable City Dropdown (Exact match with checkout) -->
                    <div class="relative" id="book_city_container">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">City / Destination *</label>
                        <input type="hidden" name="city" id="book_customer_city" required value="" />
                        <div class="relative">
                            <input 
                                type="text" 
                                id="book_city_input" 
                                placeholder="Search city (e.g. Lahore, Karachi, Islamabad)..." 
                                autocomplete="off"
                                required
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm bg-white" 
                            />
                            <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-gray-400">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                            </div>
                        </div>
                        <!-- City Dropdown List -->
                        <div id="book_city_dropdown" class="absolute left-0 right-0 z-40 mt-1 bg-white border border-gray-200 rounded-xl shadow-2xl hidden max-h-56 overflow-y-auto">
                            <ul id="book_city_list" class="divide-y divide-gray-50 text-xs sm:text-sm">
                                {cachedCities.filter((c: string) => c && c !== "#N/A").map((c: string) => (
                                    <li class="px-3 py-2 hover:bg-orange-50 cursor-pointer text-gray-700 hover:text-brand-orange transition-colors book-city-item" data-city={c}>{c}</li>
                                ))}
                                <li id="book_city_no_results" class="px-4 py-3 text-xs text-gray-400 text-center hidden">No matching cities found</li>
                            </ul>
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Full Shipping Address *</label>
                        <textarea name="address" id="book_customer_address" required rows="2" placeholder="House #, Street #, Sector/Area, Landmark..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm"></textarea>
                    </div>

                    <!-- PRODUCTS & BUNDLE VARIATIONS SELECTOR SECTION -->
                    <div class="md:col-span-2 bg-gray-50/70 p-4 rounded-xl border border-gray-200/90 space-y-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-xs sm:text-sm font-bold text-gray-900 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                                    Order Items & Bundle Variations
                                </h3>
                                <p class="text-[11px] text-gray-500">Select product & bundle pack (e.g. 1 Pack, Pack of 2, Pack of 3).</p>
                            </div>
                            <button type="button" id="addBookingItemBtn" class="px-2.5 py-1.5 bg-white border border-gray-300 hover:border-brand-orange text-gray-700 hover:text-brand-orange font-bold text-xs rounded-lg transition-colors shadow-2xs flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                                + Add Product Item
                            </button>
                        </div>

                        <!-- Dynamic Items Container -->
                        <div id="bookingItemsList" class="space-y-2.5">
                            <!-- Injected dynamically via JS -->
                        </div>

                        <!-- Subtotal & Calculations Display -->
                        <div class="pt-2 border-t border-gray-200/80 flex items-center justify-between text-xs">
                            <span class="text-gray-500 font-medium">Items Subtotal:</span>
                            <span id="bookingSubtotalDisplay" class="font-bold text-gray-900 font-mono">PKR 0</span>
                        </div>
                    </div>

                    <!-- Financial & Status Fields -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Delivery Charges (Rs)</label>
                        <input type="number" name="delivery_fee" id="book_delivery_fee" min="0" value="200" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm font-mono font-semibold" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Total COD Amount (Rs) *</label>
                        <input type="number" name="total_amount" id="book_total_amount" required min="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm font-mono font-bold text-brand-orange bg-orange-50/30" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Initial Status</label>
                        <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm font-medium">
                            <option value="Pending" selected>Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Booked">Booked</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Out for Delivery">Out for Delivery</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Returned">Returned</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tracking ID (Optional)</label>
                        <input type="text" name="tracking_no" placeholder="Leave empty for new booking" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm font-mono" />
                    </div>
                    
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Order Summary / Note</label>
                        <textarea name="order_summary" id="book_order_summary" rows="2" placeholder="Auto-populated from items or write custom note..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange text-xs sm:text-sm"></textarea>
                    </div>
                </div>
                
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 mt-5">
                    <button type="button" onclick="closeCreateBookingModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-50 font-semibold text-xs sm:text-sm transition-colors cursor-pointer">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-brand-orange text-white rounded-xl hover:bg-orange-600 font-bold text-xs sm:text-sm transition-colors shadow-sm cursor-pointer flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        Create Booking
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cancel Label Modal -->
    <div id="cancelLabelModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg p-6 w-full max-w-md shadow-xl">
            <h2 class="text-xl font-bold mb-2 text-gray-900 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                Cancel Shipping Label?
            </h2>
            <p class="text-sm text-gray-600 mb-6">Are you sure you want to cancel this shipping label? This action cannot be undone and will void the current tracking number.</p>
            <form method="POST" id="cancelLabelForm">
                <input type="hidden" name="action" value="cancel_label" />
                <input type="hidden" name="order_id" id="cancelLabelOrderId" value="" />
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="closeCancelModal()" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50 font-semibold text-sm transition-colors">Go Back</button>
                    <button type="submit" class="px-4 py-2 bg-rose-600 text-white rounded hover:bg-rose-700 font-semibold text-sm transition-colors">Yes, Cancel Label</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Order Modal -->
    <div id="deleteOrderModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg p-6 w-full max-w-md shadow-xl">
            <h2 class="text-xl font-bold mb-2 text-gray-900 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Delete Order?
            </h2>
            <p class="text-sm text-gray-600 mb-6">Are you sure you want to delete this order? This action cannot be undone.</p>
            <form method="POST" id="deleteOrderForm">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="order_id" id="deleteOrderId" value="" />
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50 font-semibold text-sm transition-colors">Go Back</button>
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-semibold text-sm transition-colors">Yes, Delete Order</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bulk Delete Modal -->
    <div id="bulkDeleteModal" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4">
        <div class="bg-white rounded-lg p-6 w-full max-w-md shadow-xl">
            <h2 class="text-xl font-bold mb-2 text-gray-900 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Delete Selected Orders?
            </h2>
            <p class="text-sm text-gray-600 mb-6">Are you sure you want to delete all selected orders? This action cannot be undone.</p>
            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeBulkDeleteModal()" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50 font-semibold text-sm transition-colors">Go Back</button>
                <button type="button" onclick="confirmBulkDelete()" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-semibold text-sm transition-colors">Yes, Delete Orders</button>
            </div>
        </div>
    </div>

    <!-- Bulk Book Shipments Modal -->
    <div id="bulkBookModal" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4">
        <div class="bg-white rounded-lg p-6 w-full max-w-md shadow-xl">
            <h2 class="text-xl font-bold mb-2 text-gray-900 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                Book Selected Shipments?
            </h2>
            <p class="text-sm text-gray-600 mb-4">Are you sure you want to book shipments for the selected orders via RS Courier? Eligible orders must be Pending or Confirmed and not have an existing tracking ID.</p>
            
            <div class="mb-5 bg-orange-50/70 border border-orange-200 rounded-lg p-3 flex items-center gap-3">
                <div class="w-9 h-9 bg-white rounded border border-orange-100 flex items-center justify-center p-1 shrink-0">
                    <img src={activeCourier?.logo || "/images/couriers/postex.png"} alt={activeCourier?.name || "Active Courier"} class="max-h-full max-w-full object-contain" />
                </div>
                <div class="text-xs">
                    <span class="text-gray-500 font-medium">Active Courier Partner:</span>
                    <p class="text-gray-900 font-bold text-sm mt-0.5">{activeCourier?.name || "PostEx"} <span class="text-gray-400 font-normal text-xs">({courierSettings?.courier_service_type || activeCourier?.serviceType || "Overnight"})</span></p>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeBulkBookModal()" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50 font-semibold text-sm transition-colors">Go Back</button>
                <button type="button" onclick="confirmBulkBook()" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-semibold text-sm transition-colors">Yes, Book Shipments</button>
            </div>
        </div>
    </div>

    <!-- Bulk Action Bar -->
    <div id="bulkActionBar" class="fixed bottom-0 left-0 right-0 md:left-64 bg-white border-t border-gray-200 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.08)] p-3 md:p-4 z-50 transform translate-y-full transition-transform duration-300">
        <!-- Desktop Layout -->
        <div class="hidden md:flex items-center justify-between w-full">
            <div class="flex items-center gap-4">
                <span class="bg-brand-orange text-white font-bold px-3 py-1 rounded-full text-sm"><span id="selectedCount">0</span> Selected</span>
                <span class="text-sm text-gray-500 font-medium">Bulk Actions:</span>
            </div>
            
            <form method="POST" id="bulkForm" class="flex items-center gap-3">
                <input type="hidden" name="action" id="bulkActionType" value="" />
                <input type="hidden" name="order_ids" id="bulkOrderIds" value="" />
                
                <button type="button" onclick="openBulkBookModal()" class="flex items-center gap-1.5 text-sm font-semibold text-indigo-700 hover:text-indigo-800 transition-colors bg-indigo-50 hover:bg-indigo-100 px-3 py-2 rounded-md border border-indigo-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    Book Shipments
                </button>
                
                <button type="button" onclick="printSelectedInvoices()" class="flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors bg-emerald-50 hover:bg-emerald-100 px-3 py-2 rounded-md border border-emerald-200" title="Print 6-per-page A4 Landscape Shipping Labels">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                    Print Shipping Labels
                </button>

                <div class="w-px h-6 bg-gray-200 mx-2"></div>

                <select name="new_status" class="text-sm border-gray-300 rounded-md focus:ring-brand-orange focus:border-brand-orange py-2 pl-3 pr-8 appearance-none" style="background-position: right 0.4rem center; background-size: 1rem 1rem;">
                    <option value="" disabled selected>Update Status...</option>
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Booked">Booked</option>
                    <option value="Shipped">Shipped</option>
                    <option value="Out for Delivery">Out for Delivery</option>
                    <option value="Delivered">Delivered</option>
                    <option value="Returned">Returned</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <button type="button" onclick="submitBulk('bulk_update_status')" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-black transition-colors">Apply</button>
                <div class="w-px h-6 bg-gray-200 mx-2"></div>
                <button type="button" onclick="openBulkDeleteModal()" class="flex items-center gap-1.5 text-sm font-semibold text-rose-600 hover:text-rose-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    Delete
                </button>
            </form>
        </div>

        <!-- Mobile Responsive Layout -->
        <div class="flex md:hidden items-center justify-between w-full">
            <div class="flex items-center gap-2">
                <span class="bg-brand-orange text-white font-bold px-2.5 py-1 rounded-full text-xs">
                    <span class="mobileSelectedCount">0</span> Selected
                </span>
                <button type="button" onclick="clearAllSelections()" class="text-xs text-gray-500 hover:text-gray-800 underline font-medium px-1">
                    Clear
                </button>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" onclick="openMobileBulkModal()" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5 shadow hover:bg-black transition-colors">
                    <span>Bulk Actions</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Bulk Action Bottom Sheet Modal -->
    <div id="mobileBulkModal" class="fixed inset-0 bg-black/60 z-50 hidden transition-opacity flex flex-col justify-end md:hidden" onclick="if(event.target === this) closeMobileBulkModal()">
        <div class="bg-white rounded-t-2xl max-h-[85vh] overflow-y-auto shadow-2xl p-5 space-y-4 animate-in slide-in-from-bottom duration-200">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                <div>
                    <h3 class="font-extrabold text-gray-900 text-base">Bulk Actions</h3>
                    <p class="text-xs text-gray-500 font-medium"><span class="mobileModalCount">0</span> orders selected</p>
                </div>
                <button type="button" onclick="closeMobileBulkModal()" class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Quick Action Grid -->
            <div class="grid grid-cols-2 gap-2.5">
                <button type="button" onclick="handleMobileBulkAction('book')" class="flex flex-col items-center justify-center p-3 bg-indigo-50 border border-indigo-200 rounded-xl text-indigo-800 hover:bg-indigo-100 transition-colors">
                    <svg class="w-5 h-5 mb-1 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    <span class="text-xs font-bold">Book Shipments</span>
                </button>
                <button type="button" onclick="handleMobileBulkAction('print')" class="flex flex-col items-center justify-center p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 hover:bg-emerald-100 transition-colors">
                    <svg class="w-5 h-5 mb-1 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                    <span class="text-xs font-bold">Print Shipping Labels</span>
                </button>
            </div>

            <!-- Status Update Section -->
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-200 space-y-2.5">
                <label class="block text-xs font-bold text-gray-700">Update Status To:</label>
                <div class="flex gap-2">
                    <select id="mobileStatusSelect" class="flex-1 text-xs border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange py-2 px-2.5 bg-white">
                        <option value="" disabled selected>Select status...</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Booked">Booked</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Out for Delivery">Out for Delivery</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Returned">Returned</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <button type="button" onclick="handleMobileStatusApply()" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-black transition-colors shrink-0">
                        Apply
                    </button>
                </div>
            </div>

            <!-- Danger Zone & Clear -->
            <div class="pt-2 flex items-center justify-between border-t border-gray-100 gap-3">
                <button type="button" onclick="clearAllSelections(); closeMobileBulkModal();" class="text-xs text-gray-500 hover:text-gray-800 font-medium py-2 px-3 rounded-lg border border-gray-200 hover:bg-gray-50">
                    Deselect All
                </button>
                <button type="button" onclick="handleMobileBulkAction('delete')" class="text-xs text-rose-600 hover:text-rose-700 font-bold py-2 px-3 rounded-lg bg-rose-50 hover:bg-rose-100 border border-rose-200 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    <span>Delete Selected</span>
                </button>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ availableProducts, cachedCities, defaultDeliveryFee: courierSettings?.delivery_charges ?? 200, freeShippingThreshold: courierSettings?.free_shipping_threshold ?? 2000 }}>
        // --- Manual Booking Items & City Search Engine ---
        let bookingItems = [];

        function initDefaultBookingItem() {
            bookingItems = [];
            if (availableProducts && availableProducts.length > 0) {
                const firstProd = availableProducts[0];
                const firstPack = firstProd.packs && firstProd.packs.length > 0 ? firstProd.packs[0] : null;
                bookingItems.push({
                    productId: firstProd.id,
                    productName: firstProd.title,
                    packId: firstPack ? firstPack.id : 0,
                    packLabel: firstPack ? firstPack.label : '1 Unit (Single)',
                    unitPrice: firstPack ? firstPack.price : firstProd.base_price,
                    quantity: 1,
                    freeShipping: firstPack ? firstPack.free_shipping : false
                });
            }
            renderBookingItems();
        }

        function renderBookingItems() {
            const container = document.getElementById('bookingItemsList');
            if (!container) return;

            container.innerHTML = '';
            if (bookingItems.length === 0) {
                container.innerHTML = `<div class="p-3 text-center text-xs text-gray-400 bg-white rounded-lg border border-dashed border-gray-200">No items added. Click "+ Add Product Item" above.</div>`;
                updateBookingCalculations();
                return;
            }

            bookingItems.forEach((item, index) => {
                const currentProduct = availableProducts.find(p => p.id === item.productId) || availableProducts[0] || { packs: [] };
                const packs = currentProduct.packs || [];

                const itemRow = document.createElement('div');
                itemRow.className = 'bg-white p-3 rounded-xl border border-gray-200 shadow-2xs space-y-2';
                
                let productOptionsHtml = availableProducts.map(p => `
                    <option value="${p.id}" ${p.id === item.productId ? 'selected' : ''}>${p.title}</option>
                `).join('');

                let packOptionsHtml = `
                    <option value="0" ${item.packId === 0 ? 'selected' : ''}>Standard Single (Rs. ${currentProduct.base_price})</option>
                `;
                packs.forEach(pk => {
                    packOptionsHtml += `
                        <option value="${pk.id}" ${pk.id === item.packId ? 'selected' : ''}>${pk.label} (Rs. ${pk.price.toLocaleString()})</option>
                    `;
                });

                itemRow.innerHTML = `
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center">
                        <div class="sm:col-span-5">
                            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Product</label>
                            <select class="item-prod-select w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-semibold focus:ring-brand-orange focus:border-brand-orange" data-index="${index}">
                                ${productOptionsHtml}
                            </select>
                        </div>
                        <div class="sm:col-span-4">
                            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Bundle / Pack Variation</label>
                            <select class="item-pack-select w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs focus:ring-brand-orange focus:border-brand-orange" data-index="${index}">
                                ${packOptionsHtml}
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Qty</label>
                            <input type="number" min="1" max="99" value="${item.quantity}" class="item-qty-input w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-mono font-bold text-center focus:ring-brand-orange focus:border-brand-orange" data-index="${index}" />
                        </div>
                        <div class="sm:col-span-1 flex items-center justify-end pt-3 sm:pt-0">
                            <button type="button" class="item-remove-btn p-1.5 text-gray-400 hover:text-red-500 rounded-lg hover:bg-red-50 transition-colors" data-index="${index}" title="Remove Item">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-gray-500 pt-1 border-t border-gray-100">
                        <span>Unit Price: <strong class="text-gray-900 font-mono">PKR ${(item.unitPrice || 0).toLocaleString()}</strong></span>
                        <span>Item Total: <strong class="text-brand-orange font-mono font-bold">PKR ${((item.unitPrice || 0) * item.quantity).toLocaleString()}</strong></span>
                    </div>
                `;

                container.appendChild(itemRow);
            });

            // Bind Row Events
            container.querySelectorAll('.item-prod-select').forEach(sel => {
                sel.addEventListener('change', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'), 10);
                    const newProdId = parseInt(e.target.value, 10);
                    const prod = availableProducts.find(p => p.id === newProdId);
                    if (prod) {
                        bookingItems[idx].productId = prod.id;
                        bookingItems[idx].productName = prod.title;
                        const firstPack = prod.packs && prod.packs.length > 0 ? prod.packs[0] : null;
                        if (firstPack) {
                            bookingItems[idx].packId = firstPack.id;
                            bookingItems[idx].packLabel = firstPack.label;
                            bookingItems[idx].unitPrice = firstPack.price;
                            bookingItems[idx].freeShipping = firstPack.free_shipping;
                        } else {
                            bookingItems[idx].packId = 0;
                            bookingItems[idx].packLabel = '1 Unit (Single)';
                            bookingItems[idx].unitPrice = prod.base_price;
                            bookingItems[idx].freeShipping = false;
                        }
                        renderBookingItems();
                    }
                });
            });

            container.querySelectorAll('.item-pack-select').forEach(sel => {
                sel.addEventListener('change', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'), 10);
                    const packId = parseInt(e.target.value, 10);
                    const prod = availableProducts.find(p => p.id === bookingItems[idx].productId);
                    if (packId === 0) {
                        bookingItems[idx].packId = 0;
                        bookingItems[idx].packLabel = '1 Unit (Single)';
                        bookingItems[idx].unitPrice = prod ? prod.base_price : 700;
                        bookingItems[idx].freeShipping = false;
                    } else {
                        const pack = prod?.packs?.find(pk => pk.id === packId);
                        if (pack) {
                            bookingItems[idx].packId = pack.id;
                            bookingItems[idx].packLabel = pack.label;
                            bookingItems[idx].unitPrice = pack.price;
                            bookingItems[idx].freeShipping = pack.free_shipping;
                        }
                    }
                    renderBookingItems();
                });
            });

            container.querySelectorAll('.item-qty-input').forEach(inp => {
                inp.addEventListener('input', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'), 10);
                    const val = Math.max(1, parseInt(e.target.value || '1', 10));
                    bookingItems[idx].quantity = val;
                    updateBookingCalculations();
                });
            });

            container.querySelectorAll('.item-remove-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(btn.getAttribute('data-index'), 10);
                    bookingItems.splice(idx, 1);
                    renderBookingItems();
                });
            });

            updateBookingCalculations();
        }

        function updateBookingCalculations() {
            const subtotal = bookingItems.reduce((sum, item) => sum + ((item.unitPrice || 0) * (item.quantity || 1)), 0);
            
            const subtotalDisplay = document.getElementById('bookingSubtotalDisplay');
            if (subtotalDisplay) subtotalDisplay.textContent = `PKR ${subtotal.toLocaleString()}`;

            const deliveryFeeInp = document.getElementById('book_delivery_fee');
            const totalAmountInp = document.getElementById('book_total_amount');
            const itemsJsonInp = document.getElementById('book_items_json');
            const summaryInp = document.getElementById('book_order_summary');

            // Free shipping check
            const hasFreeShippingPack = bookingItems.some(i => i.freeShipping);
            const isEligibleFree = hasFreeShippingPack || (subtotal >= freeShippingThreshold);
            
            let deliveryFee = defaultDeliveryFee;
            if (isEligibleFree) {
                deliveryFee = 0;
            }

            if (deliveryFeeInp) {
                // If the user hasn't explicitly overridden delivery fee manually
                deliveryFeeInp.value = deliveryFee;
            }

            const currentDelFee = parseFloat(deliveryFeeInp?.value || '0');
            const total = subtotal + currentDelFee;

            if (totalAmountInp) {
                totalAmountInp.value = total;
            }

            if (itemsJsonInp) {
                itemsJsonInp.value = JSON.stringify(bookingItems);
            }

            if (summaryInp && bookingItems.length > 0) {
                summaryInp.value = bookingItems.map(i => `${i.productName} (${i.packLabel}) x${i.quantity}`).join(", ");
            }
        }

        // City Search Autocomplete Setup
        function setupCityDropdown() {
            const cityInput = document.getElementById('book_city_input');
            const cityHidden = document.getElementById('book_customer_city');
            const cityDropdown = document.getElementById('book_city_dropdown');
            const cityList = document.getElementById('book_city_list');
            const noResults = document.getElementById('book_city_no_results');

            if (!cityInput || !cityDropdown || !cityList) return;

            cityInput.addEventListener('focus', () => {
                cityDropdown.classList.remove('hidden');
                filterCities(cityInput.value.trim());
            });

            cityInput.addEventListener('input', (e) => {
                const q = e.target.value.trim().toLowerCase();
                cityHidden.value = e.target.value.trim();
                cityDropdown.classList.remove('hidden');
                filterCities(q);
            });

            function filterCities(query) {
                let matchCount = 0;
                const items = cityList.querySelectorAll('.book-city-item');
                items.forEach(item => {
                    const cityName = (item.getAttribute('data-city') || '').toLowerCase();
                    if (!query || cityName.includes(query)) {
                        item.classList.remove('hidden');
                        matchCount++;
                    } else {
                        item.classList.add('hidden');
                    }
                });

                if (matchCount === 0 && query) {
                    if (noResults) noResults.classList.remove('hidden');
                } else {
                    if (noResults) noResults.classList.add('hidden');
                }
            }

            cityList.addEventListener('click', (e) => {
                const target = e.target.closest('.book-city-item');
                if (target) {
                    const chosenCity = target.getAttribute('data-city');
                    cityInput.value = chosenCity;
                    cityHidden.value = chosenCity;
                    cityDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('click', (e) => {
                const container = document.getElementById('book_city_container');
                if (container && !container.contains(e.target)) {
                    cityDropdown.classList.add('hidden');
                }
            });
        }

        window.openCreateBookingModal = function() {
            const modal = document.getElementById('createBookingModal');
            const dateInput = document.getElementById('createBookingDate');
            
            // Set current date in PKT format for datetime-local
            const now = new Date();
            const pktOffset = 5 * 60 * 60 * 1000;
            const pktTime = new Date(now.getTime() + pktOffset);
            
            // Format to YYYY-MM-DDThh:mm
            const formatted = pktTime.toISOString().slice(0, 16);
            if (dateInput) dateInput.value = formatted;
            
            initDefaultBookingItem();
            if (modal) modal.classList.remove('hidden');
        };

        window.closeCreateBookingModal = function() {
            const modal = document.getElementById('createBookingModal');
            if (modal) modal.classList.add('hidden');
        };

        // Customer Search Autocomplete Logic
        const searchInput = document.getElementById('customerSearchInput');
        const searchResults = document.getElementById('customerSearchResults');
        
        let searchTimeout;
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                clearTimeout(searchTimeout);
                const query = e.target.value.trim();
                
                if (query.length < 2) {
                    searchResults.classList.add('hidden');
                    return;
                }
                
                searchTimeout = setTimeout(async () => {
                    try {
                        const res = await fetch(`/api/admin/customer-search?q=${encodeURIComponent(query)}`);
                        if (!res.ok) return;
                        const data = await res.json();
                        
                        searchResults.innerHTML = '';
                        if (data.length > 0) {
                            data.forEach(customer => {
                                const div = document.createElement('div');
                                div.className = 'px-4 py-2 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-0';
                                div.innerHTML = `
                                    <div class="font-medium text-gray-900">${customer.name}</div>
                                    <div class="text-xs text-gray-500">${customer.phone} • ${customer.city}</div>
                                `;
                                div.addEventListener('click', () => {
                                    document.getElementById('book_customer_name').value = customer.name || '';
                                    document.getElementById('book_customer_phone').value = customer.phone || '';
                                    document.getElementById('book_customer_email').value = customer.email || '';
                                    
                                    const cityInp = document.getElementById('book_city_input');
                                    const cityHid = document.getElementById('book_customer_city');
                                    if (cityInp && cityHid) {
                                        cityInp.value = customer.city || '';
                                        cityHid.value = customer.city || '';
                                    }

                                    document.getElementById('book_customer_address').value = customer.address || '';
                                    
                                    searchInput.value = '';
                                    searchResults.classList.add('hidden');
                                });
                                searchResults.appendChild(div);
                            });
                            searchResults.classList.remove('hidden');
                        } else {
                            searchResults.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 text-center">No customers found</div>';
                            searchResults.classList.remove('hidden');
                        }
                    } catch(err) {
                        console.error("Search failed", err);
                    }
                }, 300);
            });

            document.addEventListener('click', (e) => {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.add('hidden');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            setupCityDropdown();

            const openBtn = document.getElementById('openCreateBookingBtn');
            if (openBtn) {
                openBtn.addEventListener('click', window.openCreateBookingModal);
            }

            const addBtn = document.getElementById('addBookingItemBtn');
            if (addBtn) {
                addBtn.addEventListener('click', () => {
                    if (availableProducts && availableProducts.length > 0) {
                        const prod = availableProducts[0];
                        const pack = prod.packs && prod.packs.length > 0 ? prod.packs[0] : null;
                        bookingItems.push({
                            productId: prod.id,
                            productName: prod.title,
                            packId: pack ? pack.id : 0,
                            packLabel: pack ? pack.label : '1 Unit (Single)',
                            unitPrice: pack ? pack.price : prod.base_price,
                            quantity: 1,
                            freeShipping: pack ? pack.free_shipping : false
                        });
                        renderBookingItems();
                    }
                });
            }

            const delFeeInp = document.getElementById('book_delivery_fee');
            if (delFeeInp) {
                delFeeInp.addEventListener('input', () => {
                    const subtotal = bookingItems.reduce((sum, item) => sum + ((item.unitPrice || 0) * (item.quantity || 1)), 0);
                    const del = parseFloat(delFeeInp.value || '0');
                    const totalInp = document.getElementById('book_total_amount');
                    if (totalInp) totalInp.value = subtotal + del;
                });
            }

            const selectAll = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulkActionBar');
            const selectedCount = document.getElementById('selectedCount');
            const bulkOrderIds = document.getElementById('bulkOrderIds');
            const bulkActionType = document.getElementById('bulkActionType');
            const bulkForm = document.getElementById('bulkForm');
            const periodSelect = document.getElementById('period-select');
            const customDateInputs = document.getElementById('custom-date-inputs');

            if (periodSelect && customDateInputs) {
                periodSelect.addEventListener('change', (e) => {
                    if (e.target.value === 'custom') {
                        customDateInputs.classList.remove('hidden');
                        customDateInputs.classList.add('flex');
                        customDateInputs.querySelectorAll('input').forEach(i => i.required = true);
                    } else {
                        customDateInputs.classList.add('hidden');
                        customDateInputs.classList.remove('flex');
                        customDateInputs.querySelectorAll('input').forEach(i => i.required = false);
                        e.target.form.submit();
                    }
                });
            }

            function updateBulkActionUI() {
                const selected = Array.from(rowCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
                if (selected.length > 0) {
                    bulkActionBar.classList.remove('translate-y-full');
                    bulkActionBar.classList.add('translate-y-0');
                    if (selectedCount) selectedCount.textContent = selected.length;
                    document.querySelectorAll('.mobileSelectedCount').forEach(el => el.textContent = selected.length);
                    document.querySelectorAll('.mobileModalCount').forEach(el => el.textContent = selected.length);
                    bulkOrderIds.value = selected.join(',');
                } else {
                    bulkActionBar.classList.add('translate-y-full');
                    bulkActionBar.classList.remove('translate-y-0');
                    closeMobileBulkModal();
                }
                
                if (selectAll && rowCheckboxes.length > 0) {
                    selectAll.checked = selected.length === rowCheckboxes.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', (e) => {
                    rowCheckboxes.forEach(cb => cb.checked = e.target.checked);
                    updateBulkActionUI();
                });
            }

            rowCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkActionUI);
            });

            window.clearAllSelections = function() {
                rowCheckboxes.forEach(cb => cb.checked = false);
                if (selectAll) selectAll.checked = false;
                updateBulkActionUI();
            };

            window.openMobileBulkModal = function() {
                const modal = document.getElementById('mobileBulkModal');
                if (modal) modal.classList.remove('hidden');
            };

            window.closeMobileBulkModal = function() {
                const modal = document.getElementById('mobileBulkModal');
                if (modal) modal.classList.add('hidden');
            };

            window.handleMobileBulkAction = function(action) {
                closeMobileBulkModal();
                if (action === 'book') openBulkBookModal();
                else if (action === 'print') printSelectedInvoices();
                else if (action === 'delete') openBulkDeleteModal();
            };

            window.handleMobileStatusApply = function() {
                const mobileSelect = document.getElementById('mobileStatusSelect');
                if (!mobileSelect || !mobileSelect.value) {
                    alert('Please select a status to apply.');
                    return;
                }
                const desktopSelect = bulkForm.querySelector('select[name="new_status"]');
                if (desktopSelect) desktopSelect.value = mobileSelect.value;
                closeMobileBulkModal();
                submitBulk('bulk_update_status');
            };

            window.openCancelModal = function(orderId) {
                document.getElementById('cancelLabelOrderId').value = orderId;
                document.getElementById('cancelLabelModal').classList.remove('hidden');
            }

            window.closeCancelModal = function() {
                document.getElementById('cancelLabelModal').classList.add('hidden');
            }

            window.openDeleteModal = function(orderId) {
                document.getElementById('deleteOrderId').value = orderId;
                document.getElementById('deleteOrderModal').classList.remove('hidden');
            }

            window.closeDeleteModal = function() {
                document.getElementById('deleteOrderModal').classList.add('hidden');
            }

            window.openBulkDeleteModal = function() {
                document.getElementById('bulkDeleteModal').classList.remove('hidden');
            }

            window.closeBulkDeleteModal = function() {
                document.getElementById('bulkDeleteModal').classList.add('hidden');
            }

            window.confirmBulkDelete = function() {
                document.getElementById('bulkActionType').value = 'bulk_delete';
                document.getElementById('bulkForm').submit();
            }

            window.printSelectedInvoices = function() {
                const checkedBoxes = Array.from(document.querySelectorAll('.row-checkbox:checked'));
                if (checkedBoxes.length === 0) {
                    alert('Please select at least one order to print.');
                    return;
                }
                const orderIds = checkedBoxes.map(cb => cb.value).filter(Boolean);
                const courierIds = checkedBoxes.map(cb => (cb.getAttribute('data-courier-id') || '').trim()).filter(Boolean);

                // If all selected orders have RS Courier booking IDs, open RS Courier official bulk print URL directly!
                if (courierIds.length === checkedBoxes.length && courierIds.length > 0) {
                    const rsUrl = `https://portal.rscourier.pk/invoicehtml.php?order_id=${courierIds.join('%2C')}&save_print=&print=1`;
                    window.open(rsUrl, '_blank');
                } else {
                    window.open('/admin/print-invoices/?ids=' + orderIds.join(','), '_blank');
                }
            }

            window.openBulkBookModal = function() {
                document.getElementById('bulkBookModal').classList.remove('hidden');
            }

            window.closeBulkBookModal = function() {
                document.getElementById('bulkBookModal').classList.add('hidden');
            }

            window.confirmBulkBook = function() {
                document.getElementById('bulkActionType').value = 'bulk_book_shipments';
                document.getElementById('bulkForm').submit();
            }

            window.submitBulk = function(actionType) {
                bulkActionType.value = actionType;
                
                if (actionType === 'bulk_update_status') {
                    const selectEl = bulkForm.querySelector('select[name="new_status"]');
                    if (!selectEl.value) {
                        alert('Please select a status to apply.');
                        return;
                    }
                }
                
                bulkForm.submit();
            }
        });
    </script>
</AdminLayout>

