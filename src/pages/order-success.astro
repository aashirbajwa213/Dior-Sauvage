---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

const seoTitle = "Order Confirmed - Dior Sauvage Pakistan";
const orderId =
    Astro.url.searchParams.get("id") ||
    Math.floor(100000 + Math.random() * 900000);
---

<MainLayout title={seoTitle}>
    <div
        class="min-h-[60vh] flex items-center justify-center bg-gray-50 py-12 px-4"
    >
        <div
            class="max-w-md w-full bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center"
        >
            <div
                class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 text-green-600 animate-bounce"
            >
                <Icon name="check" class="w-10 h-10" />
            </div>

            <h1 class="text-2xl font-bold text-gray-900 mb-2">
                Order Confirmed!
            </h1>
            <p class="text-gray-600 mb-6">
                Thank you for your purchase. We have received your order and one
                of our agents will contact you shortly for confirmation.
            </p>

            <div class="bg-gray-50 p-4 rounded-lg mb-8">
                <p class="text-sm text-gray-500 mb-1">Order Reference</p>
                <p
                    class="text-lg font-mono font-bold text-gray-900 tracking-wider"
                >
                    {orderId}
                </p>
            </div>

            <Button href="/" class="w-full justify-center"
                >Continue Shopping</Button
            >
        </div>
    </div>

    <!-- Conversion Events -->
    <script is:inline define:vars={{ orderId }}>
        // Meta Pixel Purchase Event
        if (typeof window !== 'undefined' && window.fbq) {
            window.fbq('track', 'Purchase', {
                currency: 'PKR',
                value: 0,
                transaction_id: orderId
            });
        }
        
        // GA4 / GTM Purchase Event
        if (typeof window !== 'undefined') {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
                event: "purchase",
                ecommerce: {
                    transaction_id: orderId,
                    currency: "PKR",
                    value: 0
                }
            });
        }
    </script>
</MainLayout>
