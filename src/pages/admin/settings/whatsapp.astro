    <!-- CLIENT SCRIPT FOR LIVE PREVIEWS, TAG INSERTION, AND SANDBOX -->
    <script is:inline>
        // Tag Insertion
        document.querySelectorAll(".insert-tag").forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = btn.getAttribute("data-target");
                const tag = btn.getAttribute("data-tag");
                const targetEl = document.getElementById(targetId);
                if (targetEl && tag) {
                    const start = targetEl.selectionStart;
                    const end = targetEl.selectionEnd;
                    const text = targetEl.value;
                    targetEl.value = text.substring(0, start) + tag + text.substring(end);
                    targetEl.selectionStart = targetEl.selectionEnd = start + tag.length;
                    targetEl.focus();
                    targetEl.dispatchEvent(new Event("input"));
                }
            });
        });

        // Simple Client Spintax Engine for Previews
        function spinClient(text) {
            if (!text) return "";
            const regex = /\{([^{}]+?\|[^{}]+?)\}/g;
            let spun = text;
            let limit = 0;
            while (regex.test(spun) && limit < 10) {
                spun = spun.replace(regex, (_, match) => {
                    const options = match.split("|").map(s => s.trim());
                    return options[Math.floor(Math.random() * options.length)];
                });
                limit++;
            }
            return spun;
        }

        function updatePreview(sourceId, destId) {
            const src = document.getElementById(sourceId);
            const dst = document.getElementById(destId);
            if (!src || !dst) return;

            let val = src.value || "";
            val = val.replace(/\{customer_name\}/gi, "Muhammad Ali")
                     .replace(/\{order_id\}/gi, "GPK09999")
                     .replace(/\{total_amount\}/gi, "1,499")
                     .replace(/\{total\}/gi, "1,499")
                     .replace(/\{city\}/gi, "Lahore")
                     .replace(/\{address\}/gi, "House 12, Street 4, Gulberg III, Lahore")
                     .replace(/\{items\}/gi, "- Gionee Handsfree Original (Type-C) x1")
                     .replace(/\{tracking_no\}/gi, "SA7540893000")
                     .replace(/\{courier_name\}/gi, "RS Courier")
                     .replace(/\{count\}/gi, "1")
                     .replace(/\{return_reason\}/gi, "Customer refused parcel / Address incomplete")
                     .replace(/\{orders_list\}/gi, "*1. Order #GPK09999*\n• *Name:* Muhammad Ali\n• *Phone:* 03112390620\n• *City:* Lahore\n• *Tracking:* SA7540893000 (RS Courier)\n• *Return Reason:* Customer Refused");

            // Resolve Spintax
            val = spinClient(val);
            dst.textContent = val || "(Empty Template)";
        }

        // Initialize and bind previews
        const previewPairs = [
            { src: "template_input_confirmation", dst: "preview_confirmation" },
            { src: "template_input_thank_you", dst: "preview_thank_you" },
            { src: "template_input_shipped", dst: "preview_shipped" },
            { src: "template_input_returned", dst: "preview_returned" }
        ];

        previewPairs.forEach(p => {
            const el = document.getElementById(p.src);
            if (el) {
                el.addEventListener("input", () => updatePreview(p.src, p.dst));
                updatePreview(p.src, p.dst);
            }
        });

        document.querySelectorAll(".spin-preview-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const src = btn.getAttribute("data-source");
                const dst = btn.getAttribute("data-dest");
                updatePreview(src, dst);
            });
        });

        // Sandbox Preset Switcher
        const templateSelect = document.getElementById("sandbox_template_select");
        const customBox = document.getElementById("sandbox_custom_box");
        if (templateSelect && customBox) {
            templateSelect.addEventListener("change", () => {
                if (templateSelect.value === "custom") {
                    customBox.classList.remove("hidden");
                } else {
                    customBox.classList.add("hidden");
                }
            });
        }

        // Sandbox Send Test
        const sendBtn = document.getElementById("sandbox_send_btn");
        const resultBox = document.getElementById("sandbox_result");
        if (sendBtn && resultBox) {
            sendBtn.addEventListener("click", async () => {
                const phone = (document.getElementById("sandbox_phone")?.value || "").trim();
                const templateType = templateSelect?.value || "confirmation";
                const customText = (document.getElementById("sandbox_custom_text")?.value || "").trim();

                if (!phone) {
                    alert("Please enter a phone number to test.");
                    return;
                }

                sendBtn.disabled = true;
                sendBtn.innerHTML = "<span>Sending WhatsApp message...</span>";
                resultBox.classList.remove("hidden");
                resultBox.className = "p-4 rounded-xl border text-xs font-mono whitespace-pre-wrap leading-relaxed bg-gray-50 border-gray-200 text-gray-600";
                resultBox.textContent = "Connecting to OpenWA API...";

                try {
                    const res = await fetch("/api/admin/whatsapp/test-send", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            phone,
                            templateType: templateType === "custom" ? "" : templateType,
                            message: templateType === "custom" ? customText : ""
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        resultBox.className = "p-4 rounded-xl border text-xs font-mono whitespace-pre-wrap leading-relaxed bg-emerald-50 border-emerald-200 text-emerald-900";
                        resultBox.textContent = `[SUCCESS] Message Delivered in ${data.latencyMs}ms!\n\nResolved Chat ID: ${data.resolvedChatId || 'Sent'}\n\nRendered Content:\n${data.renderedText}`;
                    } else {
                        resultBox.className = "p-4 rounded-xl border text-xs font-mono whitespace-pre-wrap leading-relaxed bg-red-50 border-red-200 text-red-900";
                        resultBox.textContent = `[FAILED] Error: ${data.error}`;
                    }
                } catch (e) {
                    resultBox.className = "p-4 rounded-xl border text-xs font-mono whitespace-pre-wrap leading-relaxed bg-red-50 border-red-200 text-red-900";
                    resultBox.textContent = `[NETWORK ERROR] ${e.message}`;
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg><span>Send Test WhatsApp Message</span>`;
                }
            });
        }

        // Live Ping Status Check
        const pingBtn = document.getElementById("ping_session_btn");
        const statusBox = document.getElementById("session_status_box");
        if (pingBtn && statusBox) {
            pingBtn.addEventListener("click", async () => {
                pingBtn.disabled = true;
                pingBtn.textContent = "Checking...";
                statusBox.classList.remove("hidden");
                statusBox.className = "p-3.5 rounded-xl border text-xs font-mono bg-gray-50 border-gray-200 text-gray-700";
                statusBox.textContent = "Pinging OpenWA session endpoint...";

                try {
                    const res = await fetch("/api/admin/whatsapp/status");
                    const data = await res.json();
                    if (data.success) {
                        statusBox.className = "p-3.5 rounded-xl border text-xs font-mono bg-emerald-50 border-emerald-200 text-emerald-900";
                        statusBox.textContent = `[CONNECTED] Status: ${data.status} | Engine: ${data.engine} | Number: ${data.user?.id || 'Active'}`;
                    } else {
                        statusBox.className = "p-3.5 rounded-xl border text-xs font-mono bg-red-50 border-red-200 text-red-900";
                        statusBox.textContent = `[OFFLINE / ERROR] Status: ${data.status} | Reason: ${data.error}`;
                    }
                } catch (err) {
                    statusBox.className = "p-3.5 rounded-xl border text-xs font-mono bg-red-50 border-red-200 text-red-900";
                    statusBox.textContent = `[UNREACHABLE] ${err.message}`;
                } finally {
                    pingBtn.disabled = false;
                    pingBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg><span>Check Live Status</span>`;
                }
            });
        }
    </script>
</AdminLayout>
