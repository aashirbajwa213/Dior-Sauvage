---
import Icon from "../ui/Icon.astro";

interface TimelineEvent {
    id: number;
    order_id: string;
    status: string;
    title: string;
    description: string;
    created_at: string;
}

interface Props {
    events: TimelineEvent[];
    currentStatus: string;
}

const { events = [], currentStatus } = Astro.props;

// Sort events chronologically (oldest to newest for timeline order)
const sortedEvents = [...events].sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());

// Helper to determine the theme/color for a timeline item based on its status
function getEventTheme(status: string, title: string, isLast: boolean) {
    const titleLower = title.toLowerCase();
    
    // Check for specific notification types first
    if (titleLower.includes("whatsapp")) {
        return {
            bg: "bg-green-50 border-green-200 text-green-800",
            dotBg: "bg-green-500 ring-green-100",
            icon: "message-circle"
        };
    }
    if (titleLower.includes("email")) {
        return {
            bg: "bg-sky-50 border-sky-200 text-sky-800",
            dotBg: "bg-sky-500 ring-sky-100",
            icon: "mail"
        };
    }

    if (status === "Cancelled") {
        return {
            bg: "bg-red-50 border-red-200 text-red-700",
            dotBg: "bg-red-500 ring-red-100",
            icon: "x"
        };
    }
    if (status === "Delivered") {
        return {
            bg: "bg-emerald-50 border-emerald-100 text-emerald-800",
            dotBg: "bg-emerald-500 ring-emerald-100",
            icon: "check"
        };
    }
    if (status === "Shipped") {
        return {
            bg: "bg-indigo-50 border-indigo-100 text-indigo-800",
            dotBg: "bg-indigo-500 ring-indigo-100",
            icon: "truck"
        };
    }
    if (status === "Confirmed") {
        return {
            bg: "bg-blue-50 border-blue-100 text-blue-800",
            dotBg: "bg-blue-500 ring-blue-100",
            icon: "thumbs-up"
        };
    }
    if (status === "Booked") {
        return {
            bg: "bg-purple-50 border-purple-100 text-purple-800",
            dotBg: "bg-purple-500 ring-purple-100",
            icon: "package"
        };
    }
    if (status === "Returned") {
        return {
            bg: "bg-rose-50 border-rose-100 text-rose-800",
            dotBg: "bg-rose-500 ring-rose-100",
            icon: "corner-up-left"
        };
    }
    
    // Default Pending or general updates
    return {
        bg: isLast ? "bg-amber-50 border-amber-100 text-amber-800" : "bg-gray-50 border-gray-100 text-gray-700",
        dotBg: isLast ? "bg-amber-500 ring-amber-100 animate-pulse" : "bg-gray-400 ring-gray-100",
        icon: "clock"
    };
}
---

<div class="relative pl-6">
    <!-- Timeline Vertical Connection Line -->
    <div class="absolute left-[34px] top-4 bottom-4 w-0.5 border-l-2 border-dashed border-gray-200"></div>

    {sortedEvents.length === 0 ? (
        <div class="text-center py-8 text-gray-400">
            <Icon name="info" class="w-8 h-8 mx-auto mb-2 text-gray-300" />
            <p class="text-sm font-semibold">No history logged yet</p>
            <p class="text-xs mt-1">Timeline milestones will appear as status changes occur.</p>
        </div>
    ) : (
        <div class="space-y-8 relative">
            {sortedEvents.map((event, index) => {
                const isLast = index === sortedEvents.length - 1;
                const theme = getEventTheme(event.status, event.title, isLast);
                const formattedDate = new Date(event.created_at).toLocaleString('en-US', {
                    timeZone: 'Asia/Karachi',
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });

                return (
                    <div class="relative flex gap-6 group">
                        <!-- Dot Indicator -->
                        <div class="absolute -left-[20px] top-1.5 z-10 flex items-center justify-center">
                            <span class={`flex h-7 h-7 w-7 items-center justify-center rounded-full text-white ring-4 ${theme.dotBg} shadow-sm transition-transform duration-200 group-hover:scale-110`}>
                                <Icon name={theme.icon} class="w-3.5 h-3.5" />
                            </span>
                        </div>

                        <!-- Card Content -->
                        <div class={`flex-1 border rounded-lg p-4 md:p-5 shadow-sm transition-all duration-200 hover:shadow-md ${theme.bg}`}>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
                                <h4 class="font-bold text-sm tracking-tight text-gray-900 flex items-center gap-1.5">
                                    {event.title}
                                    {isLast && (
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white text-gray-800 shadow-sm border border-gray-200 shrink-0">
                                            Current Status
                                        </span>
                                    )}
                                </h4>
                                <span class="text-[11px] font-semibold text-gray-500 flex items-center gap-1">
                                    <Icon name="calendar" class="w-3 h-3 text-gray-400" />
                                    {formattedDate}
                                </span>
                            </div>
                            {event.description && (
                                <p class="text-xs mt-2 text-gray-700 leading-relaxed font-medium">
                                    {event.description}
                                </p>
                            )}
                        </div>
                    </div>
                );
            })}
        </div>
    )}
</div>
