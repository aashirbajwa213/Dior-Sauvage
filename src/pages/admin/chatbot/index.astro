                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">System Prompt & Store Rules</label>
                        <textarea name="chatbot_system_prompt" rows="10" class="w-full font-mono text-xs px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-brand-orange focus:border-brand-orange leading-relaxed">{config.systemPrompt}</textarea>
