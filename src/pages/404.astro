---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

const seoTitle = "Page Not Found - Dior Sauvage Pakistan";
const seoDescription = "The page you are looking for does not exist.";
---

<MainLayout title={seoTitle} description={seoDescription}>
    <div class="min-h-[70vh] flex items-center justify-center bg-gray-50 px-4">
        <div class="text-center max-w-lg mx-auto">
            <div class="mb-8 relative inline-block">
                <div
                    class="absolute inset-0 bg-brand-orange/20 blur-2xl rounded-full"
                >
                </div>
                <Icon
                    name="alert-circle"
                    class="w-32 h-32 text-slate-800 relative z-10 mx-auto"
                />
            </div>

            <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
                Page Not Found
            </h2>
            <p class="text-gray-600 mb-8 text-lg">
                Oops! The page you are looking for might have been moved or updated.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <Button href="/" size="lg" class="flex items-center gap-2">
                    <Icon name="home" class="w-5 h-5" />
                    Go to Homepage
                </Button>
                <Button
                    href="/contact/"
                    variant="outline"
                    size="lg"
                    class="flex items-center gap-2"
                >
                    <Icon name="mail" class="w-5 h-5" />
                    Contact Support
                </Button>
            </div>

            <div class="mt-12 pt-8 border-t border-gray-200">
                <p class="text-sm text-gray-500 mb-4">
                    Looking for our authentic fragrances?
                </p>
                <div class="flex flex-wrap justify-center gap-4 text-sm">
                    <a
                        href="/shop/"
                        class="text-amber-600 hover:underline font-bold"
                        >Browse Shop</a
                    >
                    <span class="text-gray-300">|</span>
                    <a
                        href="/about/"
                        class="text-gray-600 hover:underline font-medium"
                        >About Us</a
                    >
                    <span class="text-gray-300">|</span>
                    <a
                        href="/faq/"
                        class="text-gray-600 hover:underline font-medium"
                        >FAQs</a
                    >
                </div>
            </div>
        </div>
    </div>
</MainLayout>
