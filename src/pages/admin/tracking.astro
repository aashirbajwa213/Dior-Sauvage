                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    )}

    <!-- Data Table -->
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">{totalItems} Records</span>
            <ColumnSelector tableId="tracking-table" storageKey="admin_tracking_cols" columns={trackingColumns} />
        </div>
        <div class="overflow-x-auto">
            <table id="tracking-table" class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-xs font-medium text-gray-500 uppercase tracking-wider">
                        <th class="p-4 w-12"><input type="checkbox" id="selectAll" class="rounded text-brand-orange focus:ring-brand-orange cursor-pointer" /></th>
                        <th class="p-4 w-28" data-col="order_num">Order Num</th>
                        <th class="p-4" data-col="customer">Customer</th>
                        <th class="p-4" data-col="tracking">Tracking ID</th>
                        <th class="p-4" data-col="amount">Amount</th>
                        <th class="p-4" data-col="order_status">Order Status</th>
                        {currentTab === 'payments' ? (
                            <th class="p-4" data-col="status">Payment Status</th>
                        ) : (
                            <th class="p-4" data-col="status">Return Status</th>
                        )}
                        <th class="p-4" data-col="summary">Summary</th>
                        <th class="p-4 w-64" data-col="notes">Notes</th>
