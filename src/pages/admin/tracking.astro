                            <tbody class="divide-y divide-gray-50">
                                {oldestPendingReturns.length === 0 ? (
                                    <tr>
                                        <td colspan="4" class="p-6 text-center text-gray-400">No pending return pickups waiting.</td>
                                    </tr>
                                ) : (
                                    oldestPendingReturns.map(or => (
                                        <tr class="hover:bg-gray-50/50">
                                            <td class="py-2.5 px-4 font-bold text-brand-orange">
                                                <a href={`/admin/orders/${or.id}/`} class="hover:underline">#{or.id}</a>
