                {(search || statusFilter || period !== 'all') && (
                    <a href="/admin/orders/" class="p-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md text-sm transition-colors flex items-center justify-center" title="Clear filters">
                        Reset
