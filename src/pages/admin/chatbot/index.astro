                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1.5">Fallback Error Message</label>
                        <textarea name="chatbot_fallback_message" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-brand-orange focus:border-brand-orange">{config.fallbackMessage}</textarea>
                        <span class="text-[11px] text-gray-400 mt-1 block">Displayed if AI service is temporarily unreachable or encountering rate limits.</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-brand-orange text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm hover:bg-orange-600 transition-colors cursor-pointer flex items-center gap-2">
