---
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";
---

<!-- Cart Backdrop -->
<div
    id="cart-backdrop"
    class="fixed inset-0 bg-black/50 z-[70] hidden transition-opacity opacity-0"
    aria-hidden="true"
>
</div>

<!-- Cart Drawer -->
<div
    id="cart-drawer"
    class="fixed inset-y-0 right-0 z-[75] w-full max-w-md bg-white shadow-2xl transform transition-transform translate-x-full flex flex-col h-full"
    aria-modal="true"
    role="dialog"
    aria-labelledby="cart-title"
>
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-gray-100">
        <div id="cart-title" class="text-lg font-bold text-gray-900">
            Your Cart
        </div>
        <button
            id="close-cart"
            class="text-gray-500 hover:text-gray-700 p-2"
            aria-label="Close cart"
        >
            <Icon name="x" class="w-6 h-6" />
        </button>
    </div>

    <!-- Cart Items Container -->
    <div id="cart-items-container" class="flex-1 overflow-y-auto p-4 space-y-4">
        <!-- Items will be injected here via JS -->
        <div
            id="cart-empty-state"
            class="hidden h-full flex flex-col items-center justify-center text-center space-y-4"
        >
            <div
                class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center text-gray-400"
            >
                <Icon name="shopping-cart" class="w-8 h-8" />
            </div>
            <p class="text-gray-500">Your cart is empty.</p>
            <Button href="/#products" size="sm">Start Shopping</Button>
        </div>
    </div>

    <!-- Footer -->
    <div
        id="cart-footer"
        class="p-4 border-t border-gray-100 bg-gray-50 space-y-4 hidden"
    >
        <div
            class="flex items-center justify-between font-bold text-lg text-gray-900"
        >
            <span>Subtotal</span>
            <span id="cart-subtotal">PKR 0</span>
        </div>
        <div class="space-y-2">
            <Button href="/checkout/" class="w-full justify-center"
                >Proceed to Checkout</Button
            >
            <Button
                variant="outline"
                class="w-full justify-center"
                id="continue-shopping">Continue Shopping</Button
            >
        </div>
    </div>
</div>

<script>
    import {
        isCartOpen,
        cartItems,
        removeFromCart,
        updateQuantity,
        toggleCart,
    } from "../stores/cart";

    const backdrop = document.getElementById("cart-backdrop");
    const drawer = document.getElementById("cart-drawer");
    const closeBtn = document.getElementById("close-cart");
    const continueBtn = document.getElementById("continue-shopping");
    const itemsContainer = document.getElementById("cart-items-container");
    const emptyState = document.getElementById("cart-empty-state");
    const footer = document.getElementById("cart-footer");
    const subtotalEl = document.getElementById("cart-subtotal");

    // Force close on checkout page load (handles /checkout and /checkout/)
    if (window.location.pathname.startsWith("/checkout")) {
        isCartOpen.set(false);
    }

    // Toggle Visibility
    isCartOpen.subscribe((isOpen) => {
        if (isOpen) {
            backdrop?.classList.remove("hidden");
            // small delay to allow display:block to apply before opacity transition
            setTimeout(() => {
                backdrop?.classList.remove("opacity-0");
                drawer?.classList.remove("translate-x-full");
            }, 10);
            document.body.style.overflow = "hidden"; // Prevent background scroll
        } else {
            backdrop?.classList.add("opacity-0");
            drawer?.classList.add("translate-x-full");
            setTimeout(() => {
                backdrop?.classList.add("hidden");
            }, 300); // match transition duration
            document.body.style.overflow = "";
        }
    });

    // Close actions
    [closeBtn, backdrop, continueBtn].forEach((el) => {
        el?.addEventListener("click", () => isCartOpen.set(false));
    });

    // Render Items
    cartItems.subscribe((items) => {
        // Clear current items (except empty state)
        const currentItems = itemsContainer?.querySelectorAll(".cart-item");
        currentItems?.forEach((el) => el.remove());

        if (items.length === 0) {
            emptyState?.classList.remove("hidden");
            footer?.classList.add("hidden");
        } else {
            emptyState?.classList.add("hidden");
            footer?.classList.remove("hidden");

            // Calculate Subtotal
            const subtotal = items.reduce(
                (sum, item) => sum + item.price * item.quantity,
                0,
            );
            if (subtotalEl)
                subtotalEl.textContent = `PKR ${subtotal.toLocaleString()}`;

            // Render List
            items.forEach((item) => {
                const itemEl = document.createElement("div");
                itemEl.className =
                    "cart-item flex gap-4 bg-white p-3 rounded-lg border border-gray-100";
                itemEl.innerHTML = `
          <div class="w-20 h-20 bg-gray-50 rounded-md overflow-hidden flex-shrink-0">
            <img src="${item.image}" width="80" height="80" alt="${item.name}" class="w-full h-full object-cover">
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-medium text-gray-900 line-clamp-1"><a href="/${item.slug}/">${item.name}</a></h3>
              <p class="text-brand-orange font-bold text-sm">PKR ${item.price.toLocaleString()}</p>
            </div>
            <div class="flex items-center justify-between mt-2">
              <div class="flex items-center border border-gray-200 rounded-md">
                <button class="px-2 py-1 text-gray-500 hover:bg-gray-50 qty-btn" data-id="${item.id}" data-action="dec">-</button>
                <span class="px-2 text-sm text-gray-700">${item.quantity}</span>
                <button class="px-2 py-1 text-gray-500 hover:bg-gray-50 qty-btn" data-id="${item.id}" data-action="inc">+</button>
              </div>
              <button class="text-xs text-red-500 hover:text-red-700 underline remove-btn" data-id="${item.id}">Remove</button>
            </div>
          </div>
        `;
                itemsContainer?.insertBefore(itemEl, emptyState);
            });

            // Attach Event Listeners to new elements
            document.querySelectorAll(".qty-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const id = (e.target as HTMLElement).dataset.id;
                    const action = (e.target as HTMLElement).dataset.action;
                    const item = items.find((i) => i.id === id);
                    if (item && id) {
                        const newQty =
                            action === "inc"
                                ? item.quantity + 1
                                : item.quantity - 1;
                        updateQuantity(id, newQty);
                    }
                });
            });

            document.querySelectorAll(".remove-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const id = (e.target as HTMLElement).dataset.id;
                    if (id) removeFromCart(id);
                });
            });
        }
    });
</script>
