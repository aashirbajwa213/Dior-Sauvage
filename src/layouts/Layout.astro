---
import "../styles/global.css";
import ChatWidget from "../components/chat/ChatWidget.astro";

// Fonts are now preloaded and defined in global.css

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	disableTracking?: boolean;
}

const { title, description = "Dior Sauvage Eau de Parfum 100ml Pakistan - 100% Original Authentic Perfume with Checking Warranty", image = "/images/sauvage-dior/sauvage-4.jpg", noindex = false, disableTracking = false } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Google Font: Lato -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">

		<meta name="description" content={description} />
		{noindex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		)}
		<meta name="publisher" content="Dior Sauvage Pakistan" />
		<link rel="canonical" href={Astro.url.href} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<meta
			name="google-site-verification"
			content="lAHoVZv_W5uGOMVUP3FPs1d4KRaYQk6hcPZPTlJTK7E"
		/>
		<title>{title}</title>
		<slot name="head" />

		<!-- Resource Hints -->
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="preconnect" href="https://connect.facebook.net" crossorigin />

		<!-- Google Tag Manager -->
		{!disableTracking && (
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-NFGK357J');
		</script>
		)}
		<!-- End Google Tag Manager -->

		<!-- Cloudflare Turnstile -->
		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer></script>

		<slot name="head" />
	</head>
	<body
		class="bg-gray-50 text-gray-900 font-sans antialiased selection:bg-brand-orange selection:text-white"
	>
		<!-- Google Tag Manager (noscript) -->
		{!disableTracking && (
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NFGK357J"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		)}
		<!-- End Google Tag Manager (noscript) -->
		<slot />
		{!isAdmin && <ChatWidget />}
	</body>
</html>
