                        </div>
                    </div>

                    <!-- Live HTML Iframe Preview -->
                    <div>
                        <span class="block text-xs font-semibold text-gray-700 mb-1.5">Live Render Preview</span>
                        <div class="border border-gray-200 rounded-2xl bg-gray-50 overflow-hidden shadow-inner h-[440px] flex flex-col">
                            <div class="bg-gray-100 px-3 py-1.5 border-b border-gray-200 flex items-center gap-1.5 text-[11px] text-gray-500 font-semibold">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
                                <span class="ml-2 font-mono text-[10px]">Email Viewer Preview</span>
                            </div>
                            <iframe id="modal_preview_whatsapp_failure" class="w-full flex-1 bg-white" frameborder="0"></iframe>
                        </div>
                    </div>
                </div>

                <div class="pt-5 border-t border-gray-100 flex justify-end gap-2.5 mt-6 shrink-0">
                    <button type="button" class="close-modal-btn px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-xl cursor-pointer">Cancel</button>
                    <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-brand-orange hover:bg-orange-600 rounded-xl shadow-xs transition-colors cursor-pointer">Save Template</button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<script>
    const initEmailSettings = () => {
        // Modal Open/Close handlers
        const openModalButtons = document.querySelectorAll(".open-modal-btn");
        const closeModalButtons = document.querySelectorAll(".close-modal-btn");
        const allModals = document.querySelectorAll(".template-modal");

        openModalButtons.forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";
            btn.addEventListener("click", () => {
                const modalId = btn.getAttribute("data-modal-target");
                const targetModal = document.getElementById(modalId);
                if (targetModal) {
                    targetModal.classList.remove("hidden");
                    targetModal.classList.add("flex");
                }
            });
        });

        closeModalButtons.forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";
            btn.addEventListener("click", () => {
                allModals.forEach((m) => {
                    m.classList.add("hidden");
                    m.classList.remove("flex");
                });
            });
        });

        allModals.forEach((modal) => {
            if (modal.dataset.bound) return;
            modal.dataset.bound = "true";
            modal.addEventListener("click", (e) => {
                if (e.target === modal) {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                }
            });
        });

        // Insert Placeholder tag into active textarea
        const insertTagButtons = document.querySelectorAll(".insert-tag");
        insertTagButtons.forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";
            btn.addEventListener("click", () => {
                const targetInputId = btn.getAttribute("data-target");
                const tag = btn.getAttribute("data-tag");
                const input = document.getElementById(targetInputId) as HTMLTextAreaElement;
                if (input && tag) {
                    const start = input.selectionStart || 0;
                    const end = input.selectionEnd || 0;
                    const val = input.value;
                    input.value = val.substring(0, start) + tag + val.substring(end);
                    input.focus();
                    input.selectionStart = input.selectionEnd = start + tag.length;
                    input.dispatchEvent(new Event("input"));
                }
            });
        });

        // Payload JSON View
        const viewPayloadButtons = document.querySelectorAll("[data-view-payload-id]");
        viewPayloadButtons.forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";
            btn.addEventListener("click", () => {
                const logId = btn.getAttribute("data-view-payload-id");
                const row = document.getElementById(`payload-row-${logId}`);
                if (row) {
                    if (row.classList.contains("hidden")) {
                        row.classList.remove("hidden");
                        btn.textContent = "Hide Logs";
                    } else {
                        row.classList.add("hidden");
                        btn.textContent = "View Logs";
                    }
                }
            });
        });

        // Format and render email preview in iframe
        const formatEmailText = (text: string) => {
            if (!text) return "";
            
            const mockItemsTable = `
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #eee;">
                        <span style="font-weight: 500; color: #111;">Gionee Handsfree Type-C (Pack of 2)</span><br/>
                    </td>
                    <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: center;">1</td>
                    <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right;">PKR 2,500</td>
                </tr>
            `;

            const currentTimestamp = new Date().toLocaleString("en-PK", {
                timeZone: "Asia/Karachi",
                dateStyle: "medium",
                timeStyle: "medium",
            });

            return text
                .replace(/{customer_name}/g, "Ayesha Khan")
                .replace(/{order_id}/g, "GPK09070")
                .replace(/{items_table}/g, mockItemsTable)
                .replace(/{subtotal}/g, "2,500")
                .replace(/{shipping}/g, "250")
                .replace(/{total}/g, "2,750")
                .replace(/{address}/g, "House 412, Sector Y, DHA Phase 3")
                .replace(/{city}/g, "Lahore")
                .replace(/{phone}/g, "03001234567")
                .replace(/{year}/g, new Date().getFullYear().toString())
                .replace(/{tracking_no}/g, "SA7535276788")
                .replace(/{tracking_url}/g, "https://gionee.com.pk/track-order/GPK09070/")
                .replace(/{courier_name}/g, "Leopards Courier")
                .replace(/{error_message}/g, "OpenWA API returned HTTP 400: Session &#39;d5434c82-a0da-4fa2-b0a6-c7673ef11c67&#39; is not active. Start the session first.")
                .replace(/{session_id}/g, "d5434c82-a0da-4fa2-b0a6-c7673ef11c67")
                .replace(/{timestamp}/g, currentTimestamp)
                .replace(/{admin_url}/g, "https://gionee.com.pk/admin/settings/whatsapp/?tab=connection")
                .replace(/{store_url}/g, "https://gionee.com.pk/");
        };

        const setupPreview = (inputId: string, previewId: string) => {
            const input = document.getElementById(inputId) as HTMLTextAreaElement;
            const iframe = document.getElementById(previewId) as HTMLIFrameElement;
            
            if (input && iframe && !input.dataset.bound) {
                input.dataset.bound = "true";
                
                const update = () => {
                    const rawHtml = input.value;
                    const parsedHtml = formatEmailText(rawHtml);
                    
                    const iframeDoc = `
                        <!DOCTYPE html>
                        <html>
                        <head>
                            <meta charset="utf-8">
                            <style>
                                body { margin: 0; padding: 20px; background: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
                            </style>
                        </head>
                        <body>${parsedHtml}</body>
                        </html>
                    `;
                    
                    iframe.srcdoc = iframeDoc;
                };

                input.addEventListener("input", update);
                update(); // initial render
            }
        };

        setupPreview("modal_input_email_placed", "modal_preview_email_placed");
        setupPreview("modal_input_email_shipped", "modal_preview_email_shipped");
        setupPreview("modal_input_whatsapp_failure", "modal_preview_whatsapp_failure");
    };

    initEmailSettings();
    document.addEventListener("astro:page-load", initEmailSettings);
</script>

