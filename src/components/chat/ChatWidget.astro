---
/**
 * Gionee Pakistan - Official AI Support Chatbot Widget
 * Floating storefront assistant with dynamic settings, tool-assisted answers, and email handover.
 * Styled to match official Gionee Brand Look & Feel preview.
 */
---

<!-- Chat Backdrop Overlay (closes chat window when clicked) -->
<div
    id="chat-overlay"
    class="fixed inset-0 bg-black/20 backdrop-blur-[0.5px] z-40 hidden transition-opacity duration-200 print:hidden cursor-pointer"
    aria-hidden="true"
></div>

<div id="gionee-chat-widget" class="fixed bottom-4 right-4 sm:bottom-5 sm:right-5 z-50 font-sans print:hidden">
    <!-- Chat Launcher Floating Button (shown when chat is closed) -->
    <div id="chat-launcher-container" class="relative flex items-center">
        <!-- Floating Tooltip: Chat with us -->
        <div id="chat-launcher-tooltip" class="absolute right-16 top-1/2 -translate-y-1/2 bg-gray-900/90 text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-lg whitespace-nowrap hidden sm:flex items-center gap-1.5 transition-all duration-300 pointer-events-none">
            <span>Chat with us</span>
            <div class="absolute -right-1 top-1/2 -translate-y-1/2 w-2 h-2 bg-gray-900/90 rotate-45"></div>
        </div>

        <button
            id="chat-toggle-btn"
            type="button"
            class="group relative flex items-center justify-center w-12 h-12 sm:w-13 sm:h-13 transition-all duration-300 transform hover:scale-105 active:scale-95 focus:outline-none cursor-pointer filter drop-shadow-[0_8px_18px_rgba(0,0,0,0.22)]"
            aria-label="Open Customer Support Chat"
        >
            <!-- Online status badge -->
            <span id="chat-online-badge" class="absolute top-0 right-0 z-10 flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500 border-2 border-white shadow-xs"></span>
            </span>
            
            <!-- Open Icon: Mascot Avatar -->
            <img
                src="/chat-bot-avatar.png"
                alt="Dior Sauvage Support"
                class="w-full h-full object-contain rounded-full transition-transform duration-200 group-hover:scale-105"
            />
        </button>
    </div>

    <!-- Chat Modal Window (anchored directly to bottom corner, replacing launcher when open) -->
    <div
        id="chat-window"
        class="hidden w-[calc(100vw-32px)] sm:w-[335px] h-[520px] sm:h-[420px] max-h-[calc(100vh-60px)] sm:max-h-[calc(100vh-80px)] bg-white rounded-xl shadow-2xl border border-gray-200/90 flex flex-col overflow-hidden transition-all duration-200 origin-bottom-right"
        style="box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.22), 0 5px 15px rgba(0, 0, 0, 0.08);"
    >
        <!-- Chat Header -->
        <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white px-3.5 py-2 flex items-center justify-between shadow-sm shrink-0 border-b border-amber-500/20">
            <div class="flex items-center gap-2 min-w-0 pr-2">
                <img src="/chat-bot-avatar.png" alt="Dior Sauvage Assistant" class="w-7.5 h-7.5 rounded-full object-contain shrink-0 shadow-xs" />
                <div class="min-w-0 flex flex-col justify-center">
                    <h3 id="chat-header-title" class="font-semibold text-xs sm:text-[13px] text-white tracking-normal leading-tight truncate whitespace-nowrap">Fragrance Assistant</h3>
                    <span class="text-[9px] text-amber-300 font-medium tracking-wider uppercase leading-none mt-0.5">Dior Sauvage AI Specialist</span>
                </div>
            </div>
            
            <div class="flex items-center gap-1 shrink-0">
                <!-- Reset conversation button -->
                <button
                    id="chat-reset-btn"
                    type="button"
                    class="p-1 text-white/80 hover:text-white hover:bg-white/15 rounded-md transition-colors cursor-pointer"
                    title="Start New Conversation"
                >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
                <!-- Minimize button -->
                <button
                    id="chat-minimize-btn"
                    type="button"
                    class="p-1 text-white/80 hover:text-white hover:bg-white/15 rounded-md transition-colors cursor-pointer"
                    title="Minimize Chat"
                >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                    </svg>
                </button>
                <!-- Close button -->
                <button
                    id="chat-close-btn"
                    type="button"
                    class="p-1 text-white/80 hover:text-white hover:bg-white/15 rounded-md transition-colors cursor-pointer"
                    title="Close Chat"
                >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Messages Body with Custom Sleek Scrollbar -->
        <div id="chat-messages" class="flex-1 p-3 overflow-y-auto space-y-2.5 bg-[#F8F9FA] text-xs sm:text-[10px] chat-scroll">
            <!-- Messages populated via JS -->
        </div>

        <!-- Quick Suggestion Chips Container (No scrollbar) -->
        <div id="chat-quick-chips" class="px-2.5 py-1.5 bg-white border-t border-gray-100 flex items-center gap-1.5 overflow-x-auto chat-chips-scroll shrink-0">
            <!-- Quick Chips dynamically rendered via JS -->
        </div>

        <!-- Chat Input Footer (Unified Single Capsule with Send Button) -->
        <form id="chat-form" class="p-2 bg-white border-t border-gray-100 shrink-0">
            <div class="flex items-stretch w-full rounded-lg border border-gray-200/90 bg-gray-50/70 focus-within:border-brand-orange focus-within:bg-white focus-within:ring-2 focus-within:ring-orange-100 transition-all overflow-hidden shadow-xs">
                <div class="flex-1 flex items-center gap-1.5 pl-2.5 py-1 min-w-0">
                    <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <input
                        type="text"
                        id="chat-input"
                        placeholder="Type your message..."
                        class="w-full bg-transparent border-0 outline-none text-[13px] sm:text-[11px] text-gray-800 placeholder-gray-400 py-0.5"
                        autocomplete="off"
                    />
                </div>
                <button
                    type="submit"
                    id="chat-send-btn"
                    class="bg-brand-orange hover:bg-orange-600 disabled:opacity-40 disabled:cursor-not-allowed text-white px-3 flex items-center justify-center transition-colors shrink-0 focus:outline-none cursor-pointer"
                    title="Send message"
                >
                    <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Beiruti:wght@400;500;600;700&display=swap');

    .font-beiruti {
        font-family: 'Beiruti', 'Segoe UI', Tahoma, sans-serif;
    }

    /* Custom sleek scrollbar for chat message body */
    .chat-scroll::-webkit-scrollbar {
        width: 4px;
    }
    .chat-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .chat-scroll::-webkit-scrollbar-thumb {
        background-color: #E2E8F0;
        border-radius: 9999px;
    }
    .chat-scroll::-webkit-scrollbar-thumb:hover {
        background-color: #CBD5E1;
    }

    /* Completely hide scrollbars from horizontal chips bar */
    .chat-chips-scroll::-webkit-scrollbar {
        display: none;
    }
    .chat-chips-scroll {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script is:inline>
(function() {
    const STORAGE_KEY_SESSION = "gionee_chat_session_id";
    const STORAGE_KEY_CONV = "gionee_chat_conv_id";
    const STORAGE_KEY_MESSAGES = "gionee_chat_history";

    let sessionId = localStorage.getItem(STORAGE_KEY_SESSION);
    if (!sessionId) {
        sessionId = "sess_" + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
        localStorage.setItem(STORAGE_KEY_SESSION, sessionId);
    }

    let conversationId = localStorage.getItem(STORAGE_KEY_CONV) || "";
    let chatConfig = null;
    let isSending = false;

    // DOM Elements
    const overlay = document.getElementById("chat-overlay");
    const widget = document.getElementById("gionee-chat-widget");
    const launcherContainer = document.getElementById("chat-launcher-container");
    const toggleBtn = document.getElementById("chat-toggle-btn");
    const chatWindow = document.getElementById("chat-window");
    const tooltip = document.getElementById("chat-launcher-tooltip");
    const messagesContainer = document.getElementById("chat-messages");
    const quickChipsContainer = document.getElementById("chat-quick-chips");
    const form = document.getElementById("chat-form");
    const input = document.getElementById("chat-input");
    const sendBtn = document.getElementById("chat-send-btn");
    const resetBtn = document.getElementById("chat-reset-btn");
    const minimizeBtn = document.getElementById("chat-minimize-btn");
    const closeBtn = document.getElementById("chat-close-btn");
    const headerTitle = document.getElementById("chat-header-title");

    function formatTime(d) {
        try {
            return (d ? new Date(d) : new Date()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        } catch (e) {
            return "";
        }
    }

    // Fetch client configuration
    async function loadConfig() {
        try {
            const res = await fetch("/api/chatbot/config/");
            if (!res.ok) return;
            chatConfig = await res.json();
            if (!chatConfig || !chatConfig.enabled) {
                if (widget) widget.classList.add("hidden");
                if (overlay) overlay.classList.add("hidden");
                return;
            }
            if (chatConfig.title && headerTitle) {
                headerTitle.textContent = chatConfig.title;
            }
            renderQuickChips(chatConfig.suggestedPrompts || []);
            initInitialMessages();
        } catch (e) {
            console.error("Failed to load chatbot configuration", e);
        }
    }

    function renderQuickChips(prompts) {
        if (!quickChipsContainer) return;
        quickChipsContainer.innerHTML = "";
        prompts.forEach((text) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "px-2.5 py-1 text-xs sm:text-[11px] bg-white hover:bg-orange-50 hover:text-brand-orange hover:border-brand-orange border border-gray-200 rounded-lg whitespace-nowrap text-gray-700 transition-all font-medium shrink-0 cursor-pointer shadow-xs";
            btn.textContent = text;
            btn.onclick = () => {
                if (text === "Track My Order") {
                    appendMessageUI("user", "Track My Order", true);
                    showTrackingForm();
                } else if (text === "Speak with Human") {
                    appendMessageUI("user", "Speak with Human", true);
                    showWhatsAppHandoverCard();
                } else {
                    sendMessage(text);
                }
            };
            quickChipsContainer.appendChild(btn);
        });
    }

    function initInitialMessages() {
        const saved = localStorage.getItem(STORAGE_KEY_MESSAGES);
        if (saved) {
            try {
                const list = JSON.parse(saved);
                if (Array.isArray(list) && list.length > 0) {
                    messagesContainer.innerHTML = "";
                    list.forEach((m) => appendMessageUI(m.role, m.text, false, m.time));
                    scrollToBottom();
                    return;
                }
            } catch (e) {}
        }

        // Default Welcome Message
        const welcome = chatConfig?.welcomeMessage || "Hello! Welcome to Dior Sauvage Pakistan. How can I assist you with our authentic perfumes today?";
        appendMessageUI("assistant", welcome, true);
    }

    function toggleChat(open) {
        const shouldOpen = open !== undefined ? open : chatWindow.classList.contains("hidden");
        if (shouldOpen) {
            chatWindow.classList.remove("hidden");
            if (launcherContainer) launcherContainer.classList.add("hidden");
            if (overlay) overlay.classList.remove("hidden");
            
            // Only auto-focus on desktop; keep mobile virtual keyboard closed until user taps input
            const isDesktop = window.innerWidth >= 768 && window.matchMedia("(hover: hover)").matches;
            if (isDesktop) {
                setTimeout(() => input?.focus(), 150);
            }
            scrollToBottom();
        } else {
            chatWindow.classList.add("hidden");
            if (launcherContainer) launcherContainer.classList.remove("hidden");
            if (overlay) overlay.classList.add("hidden");
        }
    }

    function isUrduText(text) {
        if (!text) return false;
        return /[\u0600-\u06FF\u0750-\u077F\uFB50-\uFDFF\uFE70-\uFEFF]/.test(text);
    }

    function appendMessageUI(role, text, persist = true, timeStr = null) {
        const isUser = role === "user";
        const time = timeStr || formatTime();
        const wrapper = document.createElement("div");
        const isUrdu = isUrduText(text);
        const urduAttrs = isUrdu ? 'dir="rtl"' : 'dir="ltr"';
        const urduClass = isUrdu ? 'font-beiruti text-right text-[13px] sm:text-[11.5px]' : 'text-xs sm:text-[10px]';

        if (isUser) {
            wrapper.className = "flex items-start justify-end";
            wrapper.innerHTML = `
                <div class="max-w-[84%]">
                    <div ${urduAttrs} class="bg-brand-orange text-white rounded-lg rounded-tr-xs px-3 py-1.5 shadow-xs leading-relaxed ${urduClass}">
                        ${escapeHtml(text)}
                    </div>
                    <div class="text-[10.5px] sm:text-[9px] text-gray-400 mt-0.5 pr-1 flex items-center justify-end gap-1 font-medium">
                        <span>${time}</span>
                        <svg class="w-3.5 h-3.5 text-brand-orange inline-block shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6L7 17l-5-5" />
                            <path d="m22 10-7.5 7.5L13 16" />
                        </svg>
                    </div>
                </div>
            `;
        } else {
            wrapper.className = "flex items-start gap-1.5";
            wrapper.innerHTML = `
                <img src="/chat-bot-avatar.png" alt="Gionee Bot" class="w-6 h-6 rounded-full object-contain shrink-0 mt-0.5 shadow-xs" />
                <div class="max-w-[84%]">
                    <div ${urduAttrs} class="bg-white text-gray-800 border border-gray-200/80 rounded-lg rounded-tl-xs px-3 py-2 shadow-xs leading-relaxed ${urduClass}">
                        ${formatMarkdown(text)}
                    </div>
                    <div class="text-[10.5px] sm:text-[9px] text-gray-400 mt-0.5 pl-1 font-medium">
                        ${time}
                    </div>
                </div>
            `;
        }

        messagesContainer.appendChild(wrapper);
        scrollToBottom();

        if (persist) {
            const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_MESSAGES) || "[]");
            saved.push({ role, text, time });
            localStorage.setItem(STORAGE_KEY_MESSAGES, JSON.stringify(saved.slice(-30)));
        }
    }

    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function showTypingIndicator() {
        const wrapper = document.createElement("div");
        wrapper.id = "chat-typing-indicator";
        wrapper.className = "flex items-start gap-1.5";
        wrapper.innerHTML = `
            <img src="/chat-bot-avatar.png" alt="Gionee Bot" class="w-6 h-6 rounded-full object-contain shrink-0 mt-0.5 shadow-xs" />
            <div class="bg-white border border-gray-200/80 rounded-lg rounded-tl-xs px-2.5 py-1.5 shadow-xs flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-bounce"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-bounce" style="animation-delay: 0.15s"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-bounce" style="animation-delay: 0.3s"></span>
            </div>
        `;
        messagesContainer.appendChild(wrapper);
        scrollToBottom();
    }

    function removeTypingIndicator() {
        const ind = document.getElementById("chat-typing-indicator");
        if (ind) ind.remove();
    }

    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function formatMarkdown(str) {
        if (!str) return "";
        let text = str.trim()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

        // Bold **text**
        text = text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

        // 1. Markdown links [text](url) with safe placeholders
        const linkMap = [];
        text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)\<\>]+|\/[^\s\)\<\>]+)\)/g, (match, label, url) => {
            const ph = `__LINKPH_${linkMap.length}__`;
            if (url.includes("wa.me") || url.includes("whatsapp")) {
                linkMap.push(`<a href="${url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-md font-bold text-[10px] hover:bg-emerald-100 transition-colors my-0.5 no-underline shadow-2xs">${label} &rarr;</a>`);
            } else {
                linkMap.push(`<a href="${url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-brand-orange bg-orange-50 border border-orange-200 px-2 py-0.5 rounded-md font-semibold text-[11px] sm:text-[10px] hover:bg-orange-100 hover:text-orange-700 transition-colors my-0.5 no-underline shadow-2xs">${label} &rarr;</a>`);
            }
            return ph;
        });

        // 2. Autolink bare/naked URLs so they are never plain text
        text = text.replace(/(https?:\/\/[^\s\<\>"\']+)/gi, (match, rawUrl) => {
            let cleanUrl = rawUrl.replace(/[\.,\)\;\:]+$/, "");
            let displayLabel = cleanUrl.replace(/^https?:\/\/(?:www\.)?/i, "").replace(/\/+$/, "");
            if (displayLabel.includes("gionee.com.pk/")) {
                const slugPart = displayLabel.split("gionee.com.pk/")[1] || "";
                if (slugPart) {
                    displayLabel = slugPart.replace(/-/g, " ").replace(/\b\w/g, l => l.toUpperCase());
                }
            }
            if (displayLabel.length > 35) displayLabel = displayLabel.slice(0, 32) + "...";
            return `<a href="${cleanUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-brand-orange bg-orange-50 border border-orange-200 px-2 py-0.5 rounded-md font-semibold text-[11px] sm:text-[10px] hover:bg-orange-100 hover:text-orange-700 transition-colors my-0.5 no-underline shadow-2xs">🔗 ${displayLabel} &rarr;</a>`;
        });

        // 3. Restore markdown placeholders
        linkMap.forEach((html, idx) => {
            text = text.replace(`__LINKPH_${idx}__`, html);
        });

        // Parse lines for compact, clean typography without redundant gaps
        const lines = text.split(/\r?\n/);
        const formatted = [];
        let inList = false;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line) {
                if (inList) {
                    formatted.push('</ul>');
                    inList = false;
                }
                continue;
            }

            const bulletMatch = line.match(/^[•\-\*]\s+(.*)$/);
            const numberMatch = line.match(/^(\d+)[\.\)]\s+(.*)$/);

            if (bulletMatch) {
                if (!inList) {
                    inList = true;
                    formatted.push('<ul class="my-1 space-y-0.5">');
                }
                formatted.push(`<li class="flex items-start gap-1.5"><span class="text-brand-orange font-bold text-[10px] leading-none select-none mt-0.5">•</span><span class="flex-1">${bulletMatch[1]}</span></li>`);
            } else if (numberMatch) {
                if (!inList) {
                    inList = true;
                    formatted.push('<ul class="my-1 space-y-0.5">');
                }
                formatted.push(`<li class="flex items-start gap-1.5"><span class="text-brand-orange font-semibold text-[9.5px] leading-none select-none mt-0.5">${numberMatch[1]}.</span><span class="flex-1">${numberMatch[2]}</span></li>`);
            } else {
                if (inList) {
                    formatted.push('</ul>');
                    inList = false;
                }
                formatted.push(`<p class="my-1">${line}</p>`);
            }
        }

        if (inList) {
            formatted.push('</ul>');
        }

        return formatted.join("");
    }

    async function sendMessage(text) {
        if (!text || isSending) return;

        const clean = text.toLowerCase().trim();
        if (clean === "track my order" || clean === "track order" || clean === "tracking" || clean === "track parcel" || clean === "order tracking") {
            appendMessageUI("user", text, true);
            input.value = "";
            showTrackingForm();
            return;
        }

        const isHandover = clean === "speak with human" || clean === "talk to human" || clean === "whatsapp" || clean === "human support" || clean === "contact human" || clean === "talk to agent" || clean === "speak to person";
        if (isHandover) {
            appendMessageUI("user", text, true);
            input.value = "";
            showWhatsAppHandoverCard();
            return;
        }

        isSending = true;
        sendBtn.disabled = true;
        input.value = "";

        appendMessageUI("user", text, true);
        showTypingIndicator();

        try {
            const res = await fetch("/api/chatbot/message/", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    message: text,
                    sessionId: sessionId,
                    conversationId: conversationId,
                }),
            });

            removeTypingIndicator();
            const data = await res.json();

            if (data.conversationId) {
                conversationId = data.conversationId;
                localStorage.setItem(STORAGE_KEY_CONV, conversationId);
            }

            if (data.reply) {
                appendMessageUI("assistant", data.reply, true);
            } else if (data.error) {
                appendMessageUI("assistant", "Sorry, an error occurred. " + data.error, true);
            }
        } catch (err) {
            removeTypingIndicator();
            appendMessageUI("assistant", "Connection error. Please try again or email us at support@gionee.com.pk.", true);
        } finally {
            isSending = false;
            sendBtn.disabled = false;
            const isDesktop = window.innerWidth >= 768 && window.matchMedia("(hover: hover)").matches;
            if (isDesktop) {
                setTimeout(() => input?.focus(), 100);
            }
        }
    }

    function showTrackingForm() {
        appendMessageUI("assistant", "Sure! I'd be happy to check your order details and real-time courier tracking for you. Please enter your Order ID and phone number below:", true);

        const wrapper = document.createElement("div");
        wrapper.className = "flex items-start gap-1.5";
        wrapper.innerHTML = `
            <img src="/chat-bot-avatar.png" alt="Gionee Bot" class="w-6 h-6 rounded-full object-contain shrink-0 mt-0.5 shadow-xs" />
            <div class="max-w-[92%] w-full">
                <div class="bg-white text-gray-800 border border-orange-200 rounded-lg rounded-tl-xs p-3 shadow-sm text-xs sm:text-[10px]">
                    <div class="font-bold text-gray-900 mb-1 flex items-center gap-1.5 text-sm sm:text-[11px]">
                        <svg class="w-3.5 h-3.5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span>Track Your Order</span>
                    </div>
                    <p class="text-[11.5px] sm:text-[9.5px] text-gray-500 mb-2.5 leading-relaxed">Enter your Order ID and Phone Number to check your shipment status:</p>
                    <form class="space-y-2 chat-track-form">
                        <div>
                            <label class="block text-[11px] sm:text-[9px] font-semibold text-gray-600 uppercase tracking-wider mb-0.5">Order ID</label>
                            <input type="text" class="input-track-order w-full border border-gray-200 rounded px-2.5 py-1 text-xs sm:text-[11px] focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange bg-gray-50/70" placeholder="e.g. #GPK09070" required autocomplete="off" />
                        </div>
                        <div>
                            <label class="block text-[11px] sm:text-[9px] font-semibold text-gray-600 uppercase tracking-wider mb-0.5">Phone Number</label>
                            <input type="tel" class="input-track-phone w-full border border-gray-200 rounded px-2.5 py-1 text-xs sm:text-[11px] focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange bg-gray-50/70" placeholder="e.g. 03112390620" required autocomplete="off" />
                        </div>
                        <div class="track-form-error text-[11px] sm:text-[9.5px] text-red-600 font-medium hidden"></div>
                        <button type="submit" class="track-submit-btn w-full mt-2 bg-brand-orange hover:bg-orange-600 text-white font-semibold py-1.5 px-3 rounded text-xs sm:text-[11px] transition-colors flex items-center justify-center gap-1.5 cursor-pointer shadow-xs disabled:opacity-50">
                            <span>Check Status</span>
                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </button>
                    </form>
                </div>
                <div class="text-[10.5px] sm:text-[9px] text-gray-400 mt-0.5 pl-1 font-medium">
                    ${formatTime()}
                </div>
            </div>
        `;

        const trackForm = wrapper.querySelector(".chat-track-form");
        const orderInput = wrapper.querySelector(".input-track-order");
        const phoneInput = wrapper.querySelector(".input-track-phone");
        const errorDiv = wrapper.querySelector(".track-form-error");
        const submitBtn = wrapper.querySelector(".track-submit-btn");

        trackForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const orderVal = orderInput.value.trim();
            const phoneVal = phoneInput.value.trim();
            if (!orderVal || !phoneVal) return;

            errorDiv.classList.add("hidden");
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Checking...</span>';

            try {
                const res = await fetch("/api/chatbot/track-order/", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        orderId: orderVal,
                        phone: phoneVal,
                        conversationId: conversationId,
                        sessionId: sessionId
                    })
                });

                const data = await res.json();
                if (data.conversationId) {
                    conversationId = data.conversationId;
                    localStorage.setItem(STORAGE_KEY_CONV, conversationId);
                }

                if (data.success && data.order) {
                    orderInput.disabled = true;
                    phoneInput.disabled = true;
                    submitBtn.classList.add("hidden");

                    appendTrackingResultUI(data.order);
                } else {
                    errorDiv.textContent = data.error || "Order not found. Please verify your details.";
                    errorDiv.classList.remove("hidden");
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>Check Status</span><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>';
                }
            } catch (err) {
                errorDiv.textContent = "Unable to connect. Please try again or email support@gionee.com.pk.";
                errorDiv.classList.remove("hidden");
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Check Status</span>';
            }
        });

        messagesContainer.appendChild(wrapper);
        scrollToBottom();
        setTimeout(() => orderInput?.focus(), 150);
    }

    function appendTrackingResultUI(order) {
        const wrapper = document.createElement("div");
        wrapper.className = "flex items-start gap-1.5";

        let statusColor = "bg-amber-100 text-amber-800 border-amber-200";
        if (order.status === "Delivered") statusColor = "bg-emerald-100 text-emerald-800 border-emerald-200";
        else if (order.status === "Shipped") statusColor = "bg-blue-100 text-blue-800 border-blue-200";
        else if (order.status === "Booked") statusColor = "bg-indigo-100 text-indigo-800 border-indigo-200";
        else if (order.status === "Cancelled") statusColor = "bg-rose-100 text-rose-800 border-rose-200";

        wrapper.innerHTML = `
            <img src="/chat-bot-avatar.png" alt="Gionee Bot" class="w-6 h-6 rounded-full object-contain shrink-0 mt-0.5 shadow-xs" />
            <div class="max-w-[92%] w-full">
                <div class="bg-white text-gray-800 border border-gray-200/80 rounded-lg rounded-tl-xs p-3 shadow-xs text-xs sm:text-[10px] space-y-2">
                    <div>
                        <p class="font-bold text-gray-900 text-sm sm:text-xs">Hello ${escapeHtml(order.customerName)}!</p>
                        <p class="text-[11.5px] sm:text-[9.5px] text-gray-500 mt-0.5">Here are the live tracking details for your order:</p>
                    </div>

                    <div class="bg-gray-50/80 rounded-md p-2 border border-gray-100 space-y-1.5 text-xs sm:text-[10px]">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500 font-medium">Order ID:</span>
                            <span class="font-bold text-gray-900">#${escapeHtml(order.id)}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500 font-medium">Status:</span>
                            <span class="px-2 py-0.5 rounded-full text-[11px] sm:text-[9px] font-bold border ${statusColor}">${escapeHtml(order.status)}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500 font-medium">Destination:</span>
                            <span class="font-semibold text-gray-800">${escapeHtml(order.city)}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500 font-medium">Total COD:</span>
                            <span class="font-bold text-brand-orange">PKR ${Number(order.totalAmount).toLocaleString()}</span>
                        </div>
                        ${order.trackingNo ? `
                            <div class="pt-1.5 border-t border-gray-200/60 flex items-center justify-between">
                                <span class="text-gray-500 font-medium">Courier:</span>
                                <span class="font-bold text-indigo-700">${escapeHtml(order.courierName)}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500 font-medium">Tracking ID:</span>
                                <span class="font-mono font-bold text-gray-900 bg-white px-1.5 py-0.5 rounded border border-gray-200">${escapeHtml(order.trackingNo)}</span>
                            </div>
                        ` : ''}
                    </div>

                    <p class="text-[11.5px] sm:text-[9.5px] text-gray-600 leading-relaxed">${escapeHtml(order.statusDescription)}</p>

                    <div class="pt-1 flex flex-col gap-1.5">
                        <a 
                            href="${order.internalTrackingUrl || `/track-order/${order.id}/`}" 
                            class="w-full bg-brand-orange hover:bg-orange-600 text-white font-bold py-2 px-3 rounded text-xs sm:text-[10px] transition-colors flex items-center justify-center gap-1.5 text-center shadow-xs"
                        >
                            <span>View Live Tracking & Details</span>
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="text-[10.5px] sm:text-[9px] text-gray-400 mt-0.5 pl-1 font-medium">
                    ${formatTime()}
                </div>
            </div>
        `;

        messagesContainer.appendChild(wrapper);
        scrollToBottom();

        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_MESSAGES) || "[]");
        saved.push({ role: "assistant", text: order.formattedMessage, time: formatTime() });
        localStorage.setItem(STORAGE_KEY_MESSAGES, JSON.stringify(saved.slice(-30)));
    }

    function showWhatsAppHandoverCard() {
        const waUrl = (chatConfig && chatConfig.handoverWhatsappUrl) 
            ? chatConfig.handoverWhatsappUrl 
            : "https://wa.me/923112390620?text=" + encodeURIComponent("Hello Dior Sauvage Support, I need assistance with my order/query from the store.");
        let contactUrl = (chatConfig && chatConfig.handoverContactUrl) ? chatConfig.handoverContactUrl : "/contact/";
        if (contactUrl === "/contact") contactUrl = "/contact/";

        let customMessage = (chatConfig && chatConfig.handoverMessage) ? chatConfig.handoverMessage.trim() : "";
        if (!customMessage || customMessage.toLowerCase().includes("forwarded") || customMessage.toLowerCase().includes("email shortly")) {
            customMessage = "Message our support team on WhatsApp. They will respond to your query at the earliest!";
        }

        const wrapper = document.createElement("div");
        wrapper.className = "flex items-start gap-1.5";
        wrapper.innerHTML = `
            <img src="/chat-bot-avatar.png" alt="Gionee Bot" class="w-6 h-6 rounded-full object-contain shrink-0 mt-0.5 shadow-xs" />
            <div class="max-w-[92%] w-full">
                <div class="bg-white text-gray-800 border border-emerald-200 rounded-lg rounded-tl-xs p-3.5 shadow-xs text-xs sm:text-[10px] space-y-2.5">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm sm:text-xs leading-tight">Connect with Human Support</h4>
                            <p class="text-[11px] sm:text-[9.5px] text-gray-500">Official Support via WhatsApp</p>
                        </div>
                    </div>
                    <p class="text-xs sm:text-[10.5px] text-gray-600 leading-relaxed font-normal">
                        ${escapeHtml(customMessage)}
                    </p>
                    <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="w-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold py-2 px-3 rounded-lg text-sm sm:text-xs transition-colors flex items-center justify-center gap-2 shadow-xs cursor-pointer no-underline">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z" />
                        </svg>
                        <span>Chat on WhatsApp</span>
                    </a>
                    <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] sm:text-[9.5px]">
                        <span class="text-gray-400">Prefer email?</span>
                        <a href="${contactUrl}" class="text-brand-orange font-semibold hover:underline flex items-center gap-0.5">
                            <span>Fill Contact Form</span>
                            <span>&rarr;</span>
                        </a>
                    </div>
                </div>
                <div class="text-[10.5px] sm:text-[9px] text-gray-400 mt-0.5 pl-1 font-medium">
                    ${formatTime()}
                </div>
            </div>
        `;

        messagesContainer.appendChild(wrapper);
        scrollToBottom();

        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_MESSAGES) || "[]");
        saved.push({ role: "assistant", text: "WhatsApp Human Support Card", time: formatTime() });
        localStorage.setItem(STORAGE_KEY_MESSAGES, JSON.stringify(saved.slice(-30)));

        // Record handover status in backend
        try {
            fetch("/api/chatbot/handover/", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    conversationId: conversationId,
                    sessionId: sessionId,
                    reason: "Customer requested WhatsApp human support.",
                }),
            }).then(r => r.json()).then(data => {
                if (data && data.conversationId) {
                    conversationId = data.conversationId;
                    localStorage.setItem(STORAGE_KEY_CONV, conversationId);
                }
            }).catch(() => {});
        } catch (e) {}
    }

    // Event Listeners
    if (toggleBtn) {
        toggleBtn.addEventListener("click", () => toggleChat(true));
    }
    if (minimizeBtn) {
        minimizeBtn.addEventListener("click", () => toggleChat(false));
    }
    if (closeBtn) {
        closeBtn.addEventListener("click", () => toggleChat(false));
    }
    if (overlay) {
        overlay.addEventListener("click", () => toggleChat(false));
    }
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && chatWindow && !chatWindow.classList.contains("hidden")) {
            toggleChat(false);
        }
    });
    if (resetBtn) {
        resetBtn.addEventListener("click", () => {
            if (confirm("Start a new conversation? Current chat transcript will be saved.")) {
                localStorage.removeItem(STORAGE_KEY_CONV);
                localStorage.removeItem(STORAGE_KEY_MESSAGES);
                conversationId = "";
                messagesContainer.innerHTML = "";
                initInitialMessages();
            }
        });
    }
    if (form) {
        form.addEventListener("submit", (e) => {
            e.preventDefault();
            const val = input.value.trim();
            if (val) sendMessage(val);
        });
    }

    // Auto-init on page load
    loadConfig();
})();
</script>
