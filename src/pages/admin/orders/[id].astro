---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Icon from "../../../components/ui/Icon.astro";
import { addTimelineEntry, getDefaultTimelineContent, getTimelineForOrder } from "../../../utils/timeline";
import OrderTimeline from "../../../components/admin/OrderTimeline.astro";
import { 
    createCourierOrder, 
    COURIER_PROVIDERS, 
    getCachedCourierCities, 
    normalizeDestinationCity,
    getCourierTrackingUrl,
    getCourierProviderName
} from "../../../utils/courier";
import { getAllSettings } from "../../../utils/settings";

const { id } = Astro.params;

const db = Astro.locals.runtime?.env?.DB;

let order: any = null;
let orderItems: any[] = [];
let timeline: any[] = [];
let settings: any = null;
let cachedCities: string[] = [];
let cityValidation: any = { isValid: true, normalizedCity: "" };
let errorMsg = "";
let successMsg = "";

if (!db) {
    errorMsg = "Cloudflare D1 Database binding is missing.";
} else {
    // 1. Handle POST Requests
    if (Astro.request.method === "POST") {
        try {
            const formData = await Astro.request.formData();
            const action = formData.get("action")?.toString();
            const newStatus = formData.get("status")?.toString();

            // A) Book Shipment with RS Courier
            if (action === "book_shipment" && id) {
                const selectedProvider = formData.get("courier_provider")?.toString();
                // Get order details first
                const orderForBooking: any = await db.prepare(`SELECT * FROM orders WHERE id = ?`).bind(id).first();
                if (orderForBooking) {
                    // Get items for product description
                    const { results: items } = await db.prepare(`SELECT product_name, quantity, pack_size_label FROM order_items WHERE order_id = ?`).bind(id).all();
                    const productDesc = (items || []).map((i: any) => `${i.product_name} (${i.quantity} Units)`).join(", ");

                    const result = await createCourierOrder(db, {
                        receiverName: orderForBooking.customer_name,
                        receiverPhone: orderForBooking.customer_phone,
                        receiverEmail: orderForBooking.customer_email || "",
                        receiverAddress: orderForBooking.address,
                        destinationCity: orderForBooking.city,
                        pieces: (items || []).reduce((sum: number, i: any) => sum + i.quantity, 0) || 1,
                        weight: 1,
                        collectionAmount: orderForBooking.total_amount,
                        productDescription: productDesc,
                        orderId: String(id)
                    }, selectedProvider);

                    if (result.success && result.data) {
                        const trackingNo = (result.data.thirdparty_tracking_no && result.data.thirdparty_tracking_no !== "null" && result.data.thirdparty_tracking_no !== "")
                            ? String(result.data.thirdparty_tracking_no)
                            : String(result.data.tracking_no);
                        const courierId = String(result.data.id);
                        const providerUsed = result.providerUsed || selectedProvider || "postex";
                        const providerName = (result.providerUsed && COURIER_PROVIDERS[result.providerUsed]?.name) || "RS Courier";
                        
                        // Save tracking info to order
                        await db.prepare(`UPDATE orders SET tracking_no = ?, courier_order_id = ?, courier_provider = ?, courier_status = 'New Booked' WHERE id = ?`)
                            .bind(trackingNo, courierId, providerUsed, id).run();
                        // Log to timeline
                        await addTimelineEntry(db, id, "Booked", `Shipment Booked (${providerName})`, `Tracking Number: ${trackingNo}. Courier Order ID: ${courierId}.`);
                        successMsg = `Shipment booked successfully with ${providerName}! Tracking No: ${trackingNo}`;
                    } else {
                        errorMsg = `Courier booking failed: ${result.error}`;
                    }
                } else {
                    errorMsg = "Order not found for booking.";
                }
            }
            // B) Status Update
            else if (newStatus && id) {
                let finalStatus = newStatus;
                let autoBookSuccess = false;

                if (newStatus === "Confirmed" && order && !order.tracking_no) {
                    // Try auto-booking with RS Courier
                    const { results: items } = await db.prepare(`SELECT product_name, quantity, pack_size_label FROM order_items WHERE order_id = ?`).bind(id).all();
                    const productDesc = (items || []).map((i: any) => `${i.product_name} (${i.quantity} Units)`).join(", ");

                    const result = await createCourierOrder(db, {
                        receiverName: order.customer_name,
                        receiverPhone: order.customer_phone,
                        receiverEmail: order.customer_email || "",
                        receiverAddress: order.address,
                        destinationCity: order.city,
                        pieces: (items || []).reduce((sum: number, i: any) => sum + i.quantity, 0) || 1,
                        weight: 1,
                        collectionAmount: order.total_amount,
                        productDescription: productDesc,
                        orderId: String(id)
                    });

                    if (result.success && result.data) {
                        const trackingNo = (result.data.thirdparty_tracking_no && result.data.thirdparty_tracking_no !== "null" && result.data.thirdparty_tracking_no !== "")
                            ? String(result.data.thirdparty_tracking_no)
                            : String(result.data.tracking_no);
                        const courierId = String(result.data.id);
                        const providerUsed = result.providerUsed || "postex";
                        
                        finalStatus = "Booked";
                        await db.prepare(`UPDATE orders SET tracking_no = ?, courier_order_id = ?, courier_provider = ?, courier_status = 'New Booked' WHERE id = ?`)
                            .bind(trackingNo, courierId, providerUsed, id).run();
                        
                        await addTimelineEntry(db, id, "Confirmed", "Order Confirmed Manually", "Admin manually confirmed order and triggered auto-booking.");
                        await addTimelineEntry(db, id, "Booked", "Shipment Auto-Booked with RS Courier", `Tracking Number: ${trackingNo}. Courier Order ID: ${courierId}.`);
                        autoBookSuccess = true;
                        successMsg = `Order confirmed and shipment booked successfully! Tracking No: ${trackingNo}`;
                    } else {
                        errorMsg = `Order confirmed, but Courier auto-booking failed: ${result.error}`;
                    }
                }

                if (finalStatus === "Shipped") {
                    await db.prepare(`UPDATE orders SET status = ?, shipped_at = CURRENT_TIMESTAMP WHERE id = ?`).bind(finalStatus, id).run();
                } else if (finalStatus === "Delivered") {
                    await db.prepare(`UPDATE orders SET status = ?, delivered_at = CURRENT_TIMESTAMP WHERE id = ?`).bind(finalStatus, id).run();
                } else {
                    await db.prepare(`UPDATE orders SET status = ? WHERE id = ?`).bind(finalStatus, id).run();
                }

                if (!autoBookSuccess) {
                    const { title, description } = getDefaultTimelineContent(finalStatus);
                    await addTimelineEntry(db, id, finalStatus, title, description);
                    if (!successMsg && !errorMsg) {
                        successMsg = `Order status updated to "${finalStatus}" successfully!`;
                    }
                }
                
                // Update local order object so the UI reflects changes immediately
                order = await db.prepare(`SELECT * FROM orders WHERE id = ?`).bind(id).first();

                // Chunk 6: Trigger dispatch email when status changes to Shipped
                if (newStatus === "Shipped") {
                    try {
                        const shippedOrder: any = await db.prepare(`SELECT * FROM orders WHERE id = ?`).bind(id).first();
                        
                        if (shippedOrder) {
                            const trackingUrl = `https://gionee.com.pk/track-order/${shippedOrder.id}/`;
                            const trackingNo = shippedOrder.tracking_no || "N/A";

                            const { sendShippedNotifications } = await import("../../../utils/notifications");
                            const notifResult = await sendShippedNotifications(db, Astro.locals.runtime?.env, shippedOrder, trackingNo, trackingUrl);
                            
                            if (notifResult.successMsg) successMsg += " " + notifResult.successMsg;
                            if (notifResult.errorMsg) errorMsg += " " + notifResult.errorMsg;
                        }
                    } catch (err: any) {
                        console.error("Failed to process Shipped notifications:", err);
                    }
                }
                

            } else if (action === "edit_order") {
            const customer_name = formData.get("customer_name")?.toString();
            const customer_phone = formData.get("customer_phone")?.toString();
            const customer_email = formData.get("customer_email")?.toString() || null;
            const city = formData.get("city")?.toString();
            const address = formData.get("address")?.toString();
            const tracking_no = formData.get("tracking_no")?.toString() || null;

            if (customer_name && customer_phone && city && address) {
                const order_summary = formData.get("order_summary")?.toString() || null;
                await db.prepare(`
                    UPDATE orders 
                    SET customer_name = ?, customer_phone = ?, customer_email = ?, city = ?, address = ?, order_summary = ?, tracking_no = ?
                    WHERE id = ?
                `).bind(customer_name, customer_phone, customer_email, city, address, order_summary, tracking_no, id).run();
                
                await addTimelineEntry(db, String(id), "Pending", "Order Details Updated", "Admin updated order details.");
                successMsg = `Order details successfully updated.`;
            } else {
                errorMsg = "Please fill all required fields.";
            }
        } else if (action === "cancel_label") {
            const currentOrder = await db.prepare("SELECT tracking_no FROM orders WHERE id = ?").bind(id).first();
            if (currentOrder && currentOrder.tracking_no) {
                const { cancelCourierOrder } = await import("../../../utils/courier");
                const cancelResult = await cancelCourierOrder(db, currentOrder.tracking_no);
                
                if (cancelResult.success) {
                    await db.prepare("UPDATE orders SET tracking_no = NULL, courier_order_id = NULL, courier_status = NULL, status = 'Confirmed' WHERE id = ?").bind(id).run();
                    await addTimelineEntry(db, String(id), "Confirmed", "Shipping Label Cancelled", `Admin cancelled the shipping label (${currentOrder.tracking_no}). Status reverted to Confirmed.`);
                    successMsg = "Shipping label successfully cancelled.";
                } else {
                    errorMsg = `Failed to cancel label via Courier API: ${cancelResult.error}`;
                }
            } else {
                errorMsg = "Order does not have an active shipping label.";
            }
        } else if (action === "resend_whatsapp") {
            const currentOrderForWa: any = await db.prepare(`SELECT * FROM orders WHERE id = ?`).bind(id).first();
            if (currentOrderForWa) {
                const { sendOrderConfirmationRequest } = await import("../../../utils/whatsapp");
                const waResult = await sendOrderConfirmationRequest(db, currentOrderForWa);
                if (waResult.success) {
                    await addTimelineEntry(db, String(id), currentOrderForWa.status || 'Pending', 'WhatsApp Confirmation Re-sent',
                        'Admin manually triggered WhatsApp confirmation message.');
                    successMsg = "WhatsApp confirmation message sent successfully!";
                } else {
                    errorMsg = `Failed to send WhatsApp message: ${waResult.error}`;
                }
            } else {
                errorMsg = "Order not found.";
            }
        }
        } catch (e: any) {
            errorMsg = "Failed to process action: " + e.message;
        }
    }

    // 2. Fetch Order Details & Items
    try {
        order = await db.prepare(`SELECT * FROM orders WHERE id = ?`).bind(id).first();
        if (order) {
            const { results } = await db.prepare(`SELECT * FROM order_items WHERE order_id = ?`).bind(id).all();
            orderItems = results;
            timeline = await getTimelineForOrder(db, String(id));

            settings = await getAllSettings(db);
            cachedCities = await getCachedCourierCities(db);
            if (order.city) {
                cityValidation = normalizeDestinationCity(order.city, cachedCities);
            }
        } else {
            errorMsg = `Order #${id} not found in database.`;
        }
    } catch (e: any) {
        errorMsg = "Database Error: " + e.message;
    }
}

// Function to helper status color
function getStatusStyles(status: string) {
    switch (status) {
        case "Pending":
            return "bg-amber-50 text-amber-700 border-amber-200";
        case "Confirmed":
            return "bg-blue-50 text-blue-700 border-blue-200";
        case "Booked":
            return "bg-purple-50 text-purple-700 border-purple-200";
        case "Shipped":
            return "bg-indigo-50 text-indigo-700 border-indigo-200";
        case "Delivered":
            return "bg-emerald-50 text-emerald-700 border-emerald-200";
        case "Returned":
            return "bg-rose-50 text-rose-700 border-rose-200";
        case "Cancelled":
            return "bg-gray-50 text-gray-700 border-gray-200";
        default:
            return "bg-gray-50 text-gray-700 border-gray-200";
    }
}

const ORDER_STATUSES = [
    { value: "Pending", label: "Pending", desc: "Order awaiting review", dot: "bg-amber-500", badge: "bg-amber-50 text-amber-700" },
    { value: "Confirmed", label: "Confirmed", desc: "Customer verified order", dot: "bg-blue-500", badge: "bg-blue-50 text-blue-700" },
    { value: "Booked", label: "Booked", desc: "Courier tracking assigned", dot: "bg-purple-500", badge: "bg-purple-50 text-purple-700" },
    { value: "Shipped", label: "Shipped", desc: "Dispatched with courier", dot: "bg-indigo-500", badge: "bg-indigo-50 text-indigo-700" },
    { value: "Delivered", label: "Delivered", desc: "Parcel delivered to customer", dot: "bg-emerald-500", badge: "bg-emerald-50 text-emerald-700" },
    { value: "Returned", label: "Returned", desc: "Shipment returned to origin", dot: "bg-rose-500", badge: "bg-rose-50 text-rose-700" },
    { value: "Cancelled", label: "Cancelled", desc: "Order cancelled by customer or admin", dot: "bg-gray-500", badge: "bg-gray-50 text-gray-700" },
];

const seoTitle = order ? `Manage Order #${order.id} - Gionee Pakistan` : "Order Detail - Admin Portal";
---

<AdminLayout title={seoTitle} activePage="orders">
    <!-- Back Button -->
    <a href="/admin/orders/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-brand-orange mb-6 font-semibold transition-colors">
        ← Back to Orders List
    </a>

    {/* Error Banner */}
    {errorMsg && (
        <div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg mb-8 flex items-start gap-3 shadow-sm">
            <div class="bg-red-100 text-red-800 p-1.5 rounded-full shrink-0 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <div>
                <p class="font-semibold">Error Occurred</p>
                <p class="text-sm mt-0.5">{errorMsg}</p>
            </div>
        </div>
    )}

    {/* Success Banner */}
    {successMsg && (
        <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-lg mb-8 flex items-start gap-3 shadow-sm">
            <div class="bg-green-100 text-green-800 p-1.5 rounded-full shrink-0 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
                <p class="font-semibold">Success</p>
                <p class="text-sm mt-0.5">{successMsg}</p>
            </div>
        </div>
    )}

    {order && (
        <div class="space-y-8">
            <!-- Header Block -->
            <div class="bg-white p-6 rounded-lg border border-gray-100 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">Order #{order.id}</h1>
                        <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${getStatusStyles(order.status)}`}>
                            {order.status}
                        </span>
                    </div>
                    <p class="text-xs text-gray-400 mt-2 flex items-center gap-1.5 font-medium">
                        <Icon name="calendar" class="w-3.5 h-3.5" /> Placed on {new Date(order.created_at).toLocaleString('en-US', {
                            timeZone: 'Asia/Karachi',
                            day: '2-digit',
                            month: 'long',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: true
                        })}
                    </p>
                </div>

                <!-- Status Update Panel (Unified Capsule) -->
                <div class="w-full md:w-auto flex flex-col sm:flex-row gap-3 items-stretch md:items-center">
                    <form method="POST" class="w-full sm:w-auto">
                        <input type="hidden" name="action" value="resend_whatsapp" />
                        <button type="submit" class="w-full sm:w-auto px-4 py-2.5 bg-[#25D366] hover:bg-[#128C7E] text-white font-semibold rounded-md border border-[#25D366] text-xs transition-colors shadow-sm active:scale-[0.98] flex items-center justify-center gap-2">
                            <svg class="w-4 h-4 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.045-.989-.045-.251-.064-.59-.191-1.018-.382-1.803-.787-2.96-2.617-3.053-2.738-.09-.123-.746-.992-.746-1.893 0-.9.471-1.343.64-1.526.168-.184.368-.231.492-.231.124 0 .248.002.355.008.113.006.262-.043.411.314.153.371.525 1.282.571 1.376.046.094.077.204.016.326-.062.123-.093.2-.185.308-.093.107-.196.24-.28.322-.093.093-.19.195-.082.38.108.185.481.794 1.033 1.286.711.634 1.31.83 1.495.922.185.093.293.077.401-.047.108-.123.462-.538.586-.723.123-.185.247-.154.416-.093.169.062 1.077.508 1.262.6.185.092.308.139.354.215.046.077.046.446-.098.851zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.435 5.176L2 22l4.981-1.399C8.423 21.49 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
                            <span>Resend WhatsApp</span>
                        </button>
                    </form>

                    <!-- Unified Status Capsule -->
                    <form method="POST" class="w-full sm:w-auto">
                        <input type="hidden" name="status" id="selected_order_status" value={order.status} />
                        <div class="relative flex items-stretch rounded-md border border-gray-200/90 bg-gray-50/70 focus-within:border-brand-orange focus-within:bg-white focus-within:ring-2 focus-within:ring-orange-100 transition-all p-1 shadow-xs">
                            <!-- Status Dropdown Trigger -->
                            <button
                                type="button"
                                id="status-dropdown-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                                class="flex items-center justify-between gap-2.5 pl-3.5 pr-2.5 py-1.5 text-left cursor-pointer focus:outline-none select-none rounded-l-md min-w-[140px]"
                            >
                                <div class="flex items-center gap-2 min-w-0">
                                    <span id="status-dropdown-dot" class={`w-2 h-2 rounded-full shrink-0 ${ORDER_STATUSES.find(s => s.value === order.status)?.dot || 'bg-gray-400'}`}></span>
                                    <span id="status-dropdown-label" class="text-xs font-semibold text-gray-800 truncate">
                                        {order.status}
                                    </span>
                                </div>
                                <svg id="status-dropdown-chevron" class="w-3.5 h-3.5 text-gray-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Update Button -->
                            <button
                                type="submit"
                                class="inline-flex items-center justify-center px-4 py-2 bg-brand-orange hover:bg-orange-600 text-white font-semibold rounded-md text-xs transition-colors shadow-sm active:scale-[0.98] cursor-pointer shrink-0"
                            >
                                <span>Update</span>
                            </button>

                            <!-- Custom Themed Status Dropdown Popover -->
                            <div
                                id="status-dropdown-menu"
                                role="listbox"
                                class="absolute left-0 top-full mt-2 w-56 bg-white border border-gray-100 rounded-xl shadow-xl z-50 p-1.5 hidden animate-in fade-in slide-in-from-top-2 duration-150"
                            >
                                <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider border-b border-gray-50 flex items-center justify-between">
                                    <span>Change Order Status</span>
                                </div>
                                <div class="py-1 space-y-0.5 max-h-56 overflow-y-auto admin-theme-scroll">
                                    {ORDER_STATUSES.map((s) => {
                                        const isCurrent = order.status === s.value;
                                        return (
                                            <div
                                                role="option"
                                                aria-selected={isCurrent ? "true" : "false"}
                                                data-status-value={s.value}
                                                data-status-dot={s.dot}
                                                class={`status-dropdown-item flex items-center justify-between px-3 py-2 rounded-lg text-xs cursor-pointer transition-colors ${
                                                    isCurrent
                                                        ? 'bg-orange-50 text-brand-orange font-semibold'
                                                        : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900 font-medium'
                                                }`}
                                            >
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <span class={`w-2 h-2 rounded-full shrink-0 ${s.dot}`}></span>
                                                    <span class="truncate">{s.label}</span>
                                                </div>
                                                <span class={`text-[10px] font-medium px-2 py-0.5 rounded-full shrink-0 ${s.badge}`}>
                                                    {s.value}
                                                </span>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Shipment Info / Book Shipment Panel -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center w-full">
                    <!-- Left Column (50%) -->
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 shadow-2xs">
                            <Icon name="truck" class="w-6 h-6" />
                        </div>
                        <div>
                            <h2 class="font-bold text-gray-900 text-sm">Shipment Details</h2>
                            {order.tracking_no ? (
                                <div class="flex flex-wrap items-center gap-2 mt-1">
                                    <span class="text-xs font-bold text-gray-500">Tracking No:</span>
                                    <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100 flex items-center gap-1.5 shadow-2xs">
                                        <a 
                                            href={getCourierTrackingUrl(settings?.courier_default_provider, order.tracking_no)} 
                                            target="_blank" 
                                            rel="noopener noreferrer" 
                                            class="hover:underline flex items-center gap-1 font-mono"
                                            title={`Track on ${getCourierProviderName(settings?.courier_default_provider, order.tracking_no)}`}
                                        >
                                            <span id="tracking-number-text">{order.tracking_no}</span>
                                            <svg class="w-3 h-3 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                        </a>
                                        <button type="button" class="text-indigo-400 hover:text-indigo-700 focus:outline-none transition-colors ml-0.5 cursor-pointer" onclick={`navigator.clipboard.writeText('${order.tracking_no}'); this.innerHTML='<svg class=\\'w-3.5 h-3.5\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M5 13l4 4L19 7\\'></path></svg>'; setTimeout(() => this.innerHTML='<svg class=\\'w-3.5 h-3.5\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z\\'></path></svg>', 2000);`} title="Copy Tracking ID">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                        </button>
                                        <button type="button" onclick="document.getElementById('editOrderModal').classList.remove('hidden')" class="text-indigo-400 hover:text-indigo-700 focus:outline-none transition-colors ml-1 cursor-pointer" title="Edit Tracking Number">
                                            <Icon name="edit" class="w-3.5 h-3.5" />
                                        </button>
                                    </span>
                                    {order.courier_status && <span class="text-xs font-semibold text-gray-500 bg-gray-50 px-3 py-1 rounded-full border border-gray-200 shadow-2xs">{order.courier_status}</span>}
                                </div>
                            ) : (
                                <p class="text-xs text-gray-400 mt-0.5 font-medium leading-relaxed">No shipment booked yet. Click "Book Shipment" to generate a tracking ID via RS Courier.</p>
                            )}
                        </div>
                    </div>

                    <!-- Right Column (50%) -->
                    <div class="flex items-center justify-start md:justify-end w-full">
                        {!order.tracking_no && (order.status === "Confirmed" || order.status === "Pending") && (
                            <form method="POST" class="w-full md:max-w-md">
                                <input type="hidden" name="action" value="book_shipment" />
                                <input 
                                    type="hidden" 
                                    name="courier_provider" 
                                    id="selected_courier_provider" 
                                    value={settings?.courier_default_provider || 'postex'} 
                                />
                                
                                <div class="relative flex items-stretch w-full rounded-md border border-gray-200/90 bg-gray-50/70 focus-within:border-brand-orange focus-within:bg-white focus-within:ring-2 focus-within:ring-orange-100 transition-all p-1 shadow-xs">
                                    <!-- Custom Dropdown Trigger Button -->
                                    <button
                                        type="button"
                                        id="courier-dropdown-trigger"
                                        aria-haspopup="listbox"
                                        aria-expanded="false"
                                        class="flex-1 flex items-center justify-between min-w-0 pl-3.5 pr-2.5 py-1.5 text-left cursor-pointer focus:outline-none select-none rounded-l-md"
                                    >
                                        <div class="flex items-center gap-2 min-w-0 truncate">
                                            <span id="courier-dropdown-label" class="text-xs text-gray-800 font-semibold truncate">
                                                {COURIER_PROVIDERS[settings?.courier_default_provider || 'postex']?.name || 'PostEx'}
                                            </span>
                                            <span id="courier-dropdown-badge" class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-orange-100/80 text-brand-orange shrink-0">
                                                {COURIER_PROVIDERS[settings?.courier_default_provider || 'postex']?.serviceType || 'Overnight'}
                                            </span>
                                        </div>
                                        <svg id="courier-dropdown-chevron" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                        </svg>
                                    </button>

                                    <!-- Action Button -->
                                    <button
                                        type="submit"
                                        class="inline-flex items-center gap-2 px-5 py-2 bg-brand-orange hover:bg-orange-600 text-white font-semibold rounded-md text-xs transition-colors shadow-sm active:scale-[0.98] cursor-pointer shrink-0"
                                    >
                                        <Icon name="package" class="w-4 h-4" />
                                        <span>Book Shipment</span>
                                    </button>

                                    <!-- Custom Themed Dropdown Menu Popover -->
                                    <div
                                        id="courier-dropdown-menu"
                                        role="listbox"
                                        class="absolute left-0 right-0 top-full mt-2 bg-white border border-gray-100 rounded-xl shadow-xl z-50 p-1.5 hidden animate-in fade-in slide-in-from-top-2 duration-150"
                                    >
                                        <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider border-b border-gray-50 flex items-center justify-between">
                                            <span>Select Courier Provider</span>
                                            <span>Active RS Tariff</span>
                                        </div>
                                        <div class="py-1 space-y-0.5 max-h-64 overflow-y-auto admin-theme-scroll">
                                            {Object.values(COURIER_PROVIDERS).map((p) => {
                                                const isCurrent = (settings?.courier_default_provider || 'postex') === p.id;
                                                return (
                                                    <div
                                                        role="option"
                                                        aria-selected={isCurrent ? "true" : "false"}
                                                        data-provider-id={p.id}
                                                        data-provider-name={p.name}
                                                        data-provider-service={p.serviceType}
                                                        class={`courier-dropdown-item flex items-center justify-between px-3 py-2 rounded-lg text-xs cursor-pointer transition-colors ${
                                                            isCurrent 
                                                                ? 'bg-orange-50 text-brand-orange font-semibold' 
                                                                : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900 font-medium'
                                                        }`}
                                                    >
                                                        <div class="flex items-center gap-2.5 min-w-0">
                                                            <div class={`w-2 h-2 rounded-full shrink-0 ${isCurrent ? 'bg-brand-orange' : 'bg-gray-300'}`}></div>
                                                            <div class="flex flex-col min-w-0">
                                                                <span class="truncate">{p.name}</span>
                                                                <span class="text-[10px] text-gray-400 font-mono font-normal">Vendor {p.vendorId}</span>
                                                            </div>
                                                        </div>
                                                        <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full shrink-0 ${
                                                            isCurrent ? 'bg-orange-100 text-brand-orange font-semibold' : 'bg-gray-100 text-gray-500'
                                                        }`}>
                                                            {p.serviceType}
                                                        </span>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </div>
                                </div>
                            </form>
                        )}
                        {order.tracking_no && (
                            <div class="flex flex-wrap items-center gap-2.5">
                                <a
                                    href={`https://portal.rscourier.pk/invoicehtml.php?order_id=${order.courier_order_id}&booking=1`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-md text-xs transition-colors border border-gray-200 shadow-2xs"
                                >
                                    <Icon name="image" class="w-3.5 h-3.5" />
                                    <span>Print Shipping Label</span>
                                </a>
                                <form method="POST" onsubmit="return confirm('Are you sure you want to cancel this shipping label? This action cannot be undone and will void the current tracking number.');">
                                    <input type="hidden" name="action" value="cancel_label" />
                                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-semibold rounded-md text-xs transition-colors border border-red-200 shadow-2xs cursor-pointer">
                                        <Icon name="x" class="w-3.5 h-3.5" />
                                        <span>Cancel Label</span>
                                    </button>
                                </form>
                            </div>
                        )}
                    </div>
                </div>
            </div>

            <!-- Split Panel (Customer Info & Items) -->
            <div class="grid md:grid-cols-3 gap-8 items-start">
                <!-- Left Split - Items List (span 2) -->
                <div class="md:col-span-2 space-y-6">
                    <!-- Items List -->
                    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
                            <h2 class="text-xl font-semibold text-gray-900 flex items-center gap-2">
                                <Icon name="shopping-cart" class="w-5 h-5 text-brand-orange" />
                                Order Items
                            </h2>
                            <span class="text-xs font-semibold bg-orange-100 text-brand-orange px-2.5 py-1 rounded">
                                {orderItems.reduce((sum, item) => sum + item.quantity, 0)} Units Total
                            </span>
                        </div>
                        <div class="divide-y divide-gray-100">
                            {orderItems.length > 0 ? orderItems.map((item) => {
                                const subtotal = item.unit_price * item.quantity;
                                return (
                                    <div class="p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:bg-gray-50/50 transition-colors">
                                        <div>
                                            <h3 class="font-semibold text-gray-900 text-base">{item.product_name}</h3>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-xs font-semibold text-gray-500">Unit Price: PKR {item.unit_price.toLocaleString()}</span>
                                                <span class="text-gray-300">•</span>
                                                <span class="text-xs font-semibold text-brand-orange">Bundle Option: {item.pack_size_label}</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between w-full sm:w-auto gap-8 border-t sm:border-t-0 pt-3 sm:pt-0">
                                            <div class="text-left sm:text-right">
                                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Qty</span>
                                                <span class="font-semibold text-gray-800 text-sm">{item.quantity} Units</span>
                                            </div>
                                            <div class="text-right">
                                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Total</span>
                                                <span class="font-semibold text-gray-900 text-base">PKR {subtotal.toLocaleString()}</span>
                                            </div>
                                        </div>
                                    </div>
                                );
                            }) : (
                                <div class="p-6 text-gray-600 text-sm">
                                    {order.order_summary ? (
                                        <div>
                                            <span class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Manual Order Summary</span>
                                            <p class="whitespace-pre-wrap font-medium">{order.order_summary}</p>
                                        </div>
                                    ) : (
                                        <span class="italic text-gray-400">No items found for this order.</span>
                                    )}
                                </div>
                            )}
                        </div>
                    </div>

                    <!-- Financial Breakdown -->
                    <div class="bg-white p-6 rounded-lg border border-gray-100 shadow-sm">
                        <h2 class="text-xl font-semibold text-gray-900 mb-6">Payment Summary</h2>
                        <div class="space-y-4 text-sm font-semibold text-gray-600">
                            <div class="flex justify-between">
                                <span>Subtotal</span>
                                <span class="text-gray-900 font-semibold">PKR {(order.total_amount - order.delivery_fee).toLocaleString()}</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Shipping & Delivery Charges</span>
                                <span class={order.delivery_fee === 0 ? "text-green-600 font-semibold" : "text-gray-900 font-semibold"}>
                                    {order.delivery_fee === 0 ? "FREE" : `PKR ${order.delivery_fee}`}
                                </span>
                            </div>
                            <div class="flex justify-between text-lg font-semibold text-gray-900 pt-4 border-t border-gray-100">
                                <span>Final Total Amount</span>
                                <span class="text-brand-orange text-xl font-semibold">PKR {order.total_amount.toLocaleString()}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Details -->
                    <div class="bg-white p-6 rounded-lg border border-gray-100 shadow-sm">
                        <div class="flex justify-between items-center mb-6 border-b border-gray-100 pb-3">
                            <h2 class="text-xl font-semibold text-gray-900 flex items-center gap-2">
                                <Icon name="user" class="w-5 h-5 text-brand-orange" />
                                Customer Details
                            </h2>
                            <button onclick="document.getElementById('editOrderModal').classList.remove('hidden')" class="text-xs font-semibold text-brand-orange hover:text-brand-orange/80 flex items-center gap-1 transition-colors">
                                <Icon name="edit" class="w-3.5 h-3.5" /> Edit
                            </button>
                        </div>
                        <div class="space-y-5 text-sm">
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Full Name</span>
                                <span class="font-semibold text-gray-900 block mt-1">{order.customer_name}</span>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Phone Number</span>
                                <a href={`tel:${order.customer_phone}`} class="font-semibold text-brand-orange hover:underline flex items-center gap-1.5 mt-1">
                                    <Icon name="phone" class="w-3.5 h-3.5" /> {order.customer_phone}
                                </a>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Email Address</span>
                                {order.customer_email ? (
                                    <a href={`mailto:${order.customer_email}`} class="font-semibold text-brand-orange hover:underline flex items-center gap-1.5 mt-1">
                                        <Icon name="mail" class="w-3.5 h-3.5" /> {order.customer_email}
                                    </a>
                                ) : (
                                    <span class="text-gray-400 italic block mt-1">N/A</span>
                                )}
                            </div>
                            <div class="border-t border-gray-100 pt-4">
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Shipping Address</span>
                                <div class="mt-2 text-gray-750 bg-gray-50 p-3 rounded border border-gray-200 leading-relaxed font-medium">
                                    {order.address}<br />
                                    <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-gray-200">
                                        <span class="text-gray-900 font-semibold flex items-center gap-1">
                                            <Icon name="truck" class="w-3.5 h-3.5 text-gray-500" /> {order.city}
                                        </span>
                                        {cityValidation.isValid ? (
                                            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 inline-flex items-center gap-1">
                                                <Icon name="check" class="w-3 h-3 text-emerald-600" /> Verified RS City
                                            </span>
                                        ) : (
                                            <span class="text-[11px] font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 inline-flex items-center gap-1" title="May require spell check before booking">
                                                <Icon name="alert-triangle" class="w-3 h-3 text-amber-600" /> Unverified City
                                            </span>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Split - Timeline (span 1) -->
                <div class="space-y-6">
                    <!-- Order Progress Timeline -->
                    <div class="bg-white p-6 rounded-lg border border-gray-100 shadow-sm">
                        <h2 class="text-xl font-semibold text-gray-900 mb-6 flex items-center gap-2 border-b border-gray-100 pb-3">
                            <Icon name="git-commit" class="w-5 h-5 text-brand-orange" />
                            Order History Timeline
                        </h2>
                        <OrderTimeline events={timeline} currentStatus={order.status} />
                    </div>
                </div>              </div>
            </div>
        </div>
    )}

    {/* Edit Order Modal */}
    {order && (
        <div id="editOrderModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto shadow-xl">
                <h2 class="text-xl font-bold mb-4 text-gray-900">Edit Order Details</h2>
                <form method="POST" class="space-y-4">
                    <input type="hidden" name="action" value="edit_order" />
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Customer Name</label>
                        <input type="text" name="customer_name" value={order.customer_name} required class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Phone</label>
                        <input type="text" name="customer_phone" value={order.customer_phone} required class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                        <input type="email" name="customer_email" value={order.customer_email || ''} class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">City</label>
                        <input type="text" name="city" list="rsCitiesList" value={order.city} required class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" />
                        <datalist id="rsCitiesList">
                            {cachedCities.map((c) => (
                                <option value={c} />
                            ))}
                        </datalist>
                        <span class="text-[10px] text-gray-400 mt-0.5 block">Start typing to select a verified RS Courier delivery city.</span>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
                        <textarea name="address" required class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" rows="3">{order.address}</textarea>
                    </div>
                    {order.order_summary !== undefined && (
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1 mt-2">Order Summary (Manual Booking)</label>
                        <textarea name="order_summary" class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" rows="2">{order.order_summary || ''}</textarea>
                    </div>
                    )}
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1 mt-2">Tracking Number</label>
                        <input type="text" name="tracking_no" value={order.tracking_no || ''} class="w-full border border-gray-300 rounded p-2 focus:ring-brand-orange focus:border-brand-orange text-sm font-medium text-gray-800" />
                    </div>
                    <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
                        <button type="button" onclick="document.getElementById('editOrderModal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50 font-semibold text-sm transition-colors">Cancel</button>
                        <button type="submit" class="px-4 py-2 bg-brand-orange text-white rounded hover:bg-brand-orange/90 font-semibold text-sm transition-colors">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    )}

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const trigger = document.getElementById('courier-dropdown-trigger');
            const menu = document.getElementById('courier-dropdown-menu');
            const hiddenInput = document.getElementById('selected_courier_provider');
            const labelEl = document.getElementById('courier-dropdown-label');
            const badgeEl = document.getElementById('courier-dropdown-badge');
            const chevron = document.getElementById('courier-dropdown-chevron');
            const items = document.querySelectorAll('.courier-dropdown-item');

            // Setup Courier Dropdown
            if (trigger && menu) {
                const toggleMenu = (open) => {
                    const isOpen = open !== undefined ? open : menu.classList.contains('hidden');
                    if (isOpen) {
                        menu.classList.remove('hidden');
                        trigger.setAttribute('aria-expanded', 'true');
                        if (chevron) chevron.classList.add('rotate-180');
                    } else {
                        menu.classList.add('hidden');
                        trigger.setAttribute('aria-expanded', 'false');
                        if (chevron) chevron.classList.remove('rotate-180');
                    }
                };

                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleMenu();
                });

                items.forEach((item) => {
                    item.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const providerId = item.getAttribute('data-provider-id');
                        const providerName = item.getAttribute('data-provider-name');
                        const providerService = item.getAttribute('data-provider-service');

                        if (hiddenInput && providerId) {
                            hiddenInput.value = providerId;
                        }
                        if (labelEl && providerName) {
                            labelEl.textContent = providerName;
                        }
                        if (badgeEl && providerService) {
                            badgeEl.textContent = providerService;
                        }

                        items.forEach((it) => {
                            const isMatch = it === item;
                            it.setAttribute('aria-selected', isMatch ? 'true' : 'false');
                            if (isMatch) {
                                it.className = 'courier-dropdown-item flex items-center justify-between px-3 py-2 rounded-lg text-xs cursor-pointer transition-colors bg-orange-50 text-brand-orange font-semibold';
                                const dot = it.querySelector('.w-2.h-2');
                                if (dot) dot.className = 'w-2 h-2 rounded-full shrink-0 bg-brand-orange';
                                const badge = it.querySelector('.text-\\[10px\\]');
                                if (badge && !badge.classList.contains('text-gray-400')) {
                                    badge.className = 'text-[10px] font-mono px-2 py-0.5 rounded-full shrink-0 bg-orange-100 text-brand-orange font-semibold';
                                }
                            } else {
                                it.className = 'courier-dropdown-item flex items-center justify-between px-3 py-2 rounded-lg text-xs cursor-pointer transition-colors text-gray-700 hover:bg-gray-50 hover:text-gray-900 font-medium';
                                const dot = it.querySelector('.w-2.h-2');
                                if (dot) dot.className = 'w-2 h-2 rounded-full shrink-0 bg-gray-300';
                                const badge = it.querySelector('.text-\\[10px\\]');
                                if (badge && !badge.classList.contains('text-gray-400')) {
                                    badge.className = 'text-[10px] font-mono px-2 py-0.5 rounded-full shrink-0 bg-gray-100 text-gray-500';
                                }
                            }
                        });

                        toggleMenu(false);
                    });
                });

                document.addEventListener('click', (e) => {
                    if (!menu.contains(e.target) && !trigger.contains(e.target)) {
                        toggleMenu(false);
                    }
                });
            }

            // Setup Status Dropdown
            const statusTrigger = document.getElementById('status-dropdown-trigger');
            const statusMenu = document.getElementById('status-dropdown-menu');
            const statusHiddenInput = document.getElementById('selected_order_status');
            const statusLabelEl = document.getElementById('status-dropdown-label');
            const statusDotEl = document.getElementById('status-dropdown-dot');
            const statusChevron = document.getElementById('status-dropdown-chevron');
            const statusItems = document.querySelectorAll('.status-dropdown-item');

            if (statusTrigger && statusMenu) {
                const toggleStatusMenu = (open) => {
                    const isOpen = open !== undefined ? open : statusMenu.classList.contains('hidden');
                    if (isOpen) {
                        statusMenu.classList.remove('hidden');
                        statusTrigger.setAttribute('aria-expanded', 'true');
                        if (statusChevron) statusChevron.classList.add('rotate-180');
                    } else {
                        statusMenu.classList.add('hidden');
                        statusTrigger.setAttribute('aria-expanded', 'false');
                        if (statusChevron) statusChevron.classList.remove('rotate-180');
                    }
                };

                statusTrigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleStatusMenu();
                });

                statusItems.forEach((item) => {
                    item.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const statusVal = item.getAttribute('data-status-value');
                        const statusDotClass = item.getAttribute('data-status-dot');

                        if (statusHiddenInput && statusVal) {
                            statusHiddenInput.value = statusVal;
                        }
                        if (statusLabelEl && statusVal) {
                            statusLabelEl.textContent = statusVal;
                        }
                        if (statusDotEl && statusDotClass) {
                            statusDotEl.className = 'w-2 h-2 rounded-full shrink-0 ' + statusDotClass;
                        }

                        statusItems.forEach((it) => {
                            const isMatch = it === item;
                            it.setAttribute('aria-selected', isMatch ? 'true' : 'false');
                            if (isMatch) {
                                it.className = 'status-dropdown-item flex items-center justify-between px-3 py-2 rounded-xl text-xs cursor-pointer transition-colors bg-orange-50 text-brand-orange font-semibold';
                            } else {
                                it.className = 'status-dropdown-item flex items-center justify-between px-3 py-2 rounded-xl text-xs cursor-pointer transition-colors text-gray-700 hover:bg-gray-50 hover:text-gray-900 font-medium';
                            }
                        });

                        toggleStatusMenu(false);
                    });
                });

                document.addEventListener('click', (e) => {
                    if (!statusMenu.contains(e.target) && !statusTrigger.contains(e.target)) {
                        toggleStatusMenu(false);
                    }
                });
            }

            // Close all dropdowns on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (menu) menu.classList.add('hidden');
                    if (trigger) trigger.setAttribute('aria-expanded', 'false');
                    if (chevron) chevron.classList.remove('rotate-180');
                    if (statusMenu) statusMenu.classList.add('hidden');
                    if (statusTrigger) statusTrigger.setAttribute('aria-expanded', 'false');
                    if (statusChevron) statusChevron.classList.remove('rotate-180');
                }
            });
        });
    </script>
</AdminLayout>
