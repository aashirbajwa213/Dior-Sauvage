                )}
            </div>
            <div id="custom-date-inputs" class={`md:col-span-4 flex items-center gap-2 ${period === 'custom' ? '' : 'hidden'}`}>
                <input type="date" name="start" value={customStart} class="text-sm border border-gray-200 rounded-md py-1.5 px-3" required={period === 'custom'} />
                <span class="text-gray-400 text-sm">to</span>
                <input type="date" name="end" value={customEnd} class="text-sm border border-gray-200 rounded-md py-1.5 px-3" required={period === 'custom'} />
            </div>
        </form>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">{totalItems} Orders Found</span>
            <ColumnSelector tableId="orders-table" storageKey="admin_orders_cols" columns={orderColumns} />
        </div>
        <div class="overflow-x-auto">
            <table id="orders-table" class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-xs font-medium text-gray-500 uppercase tracking-wider">
                        <th class="p-4 w-12 text-center">
                            <input type="checkbox" id="selectAll" class="rounded border-gray-300 text-brand-orange focus:ring-brand-orange cursor-pointer w-4 h-4" />
                        </th>
                        <th data-col="order_id" class="p-4">Order ID</th>
                        <th data-col="customer" class="p-4">Customer Details</th>
                        <th data-col="date" class="p-4">Date & Time</th>
                        <th data-col="amount" class="p-4">Total Amount</th>
                        <th data-col="risk" class="p-4">Health / Risk</th>
                        <th data-col="status" class="p-4">Status</th>
                        <th data-col="tracking" class="p-4">Tracking ID</th>
                        <th data-col="action" class="p-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm text-gray-800">
                    {orders.length === 0 ? (
                        <tr>
                            <td colspan="9" class="p-8 text-center text-gray-500">
                                <div class="max-w-sm mx-auto flex flex-col items-center">
                                    <div class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center text-gray-400 mb-2">
                                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                    <p class="font-semibold text-gray-800">No Orders Found</p>
                                    <p class="text-xs text-gray-400 mt-1">There are no orders that match your criteria. Try adjusting your search term or filter settings.</p>
                                </div>
                            </td>
                        </tr>
                    ) : (
                        orders.map((order) => {
                            const formattedDate = new Date(order.created_at).toLocaleString('en-US', {
                                timeZone: 'Asia/Karachi',
                                day: '2-digit',
                                month: 'short',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                            return (
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="p-4 text-center">
