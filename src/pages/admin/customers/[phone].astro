---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Icon from "../../../components/ui/Icon.astro";
import { actions } from "astro:actions";

const phone = Astro.params.phone;

if (!phone) {
    return Astro.redirect("/admin/customers/");
}

const seoTitle = `Customer: ${phone} - Gionee Pakistan`;
const db = Astro.locals.runtime?.env?.DB;

let customer: any = null;
let orders: any[] = [];
let errorMsg = "";
let successMsg = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();

    if (action === "update_customer") {
        try {
            const oldPhone = formData.get("oldPhone")?.toString() || "";
            const newPhone = formData.get("newPhone")?.toString() || "";
            const name = formData.get("name")?.toString() || "";
            const email = formData.get("email")?.toString() || "";
            const city = formData.get("city")?.toString() || "";
            const address = formData.get("address")?.toString() || "";

            const { data, error } = await Astro.callAction(actions.updateCustomer, {
                oldPhone,
                newPhone,
                name,
                email,
                city,
                address
            });

            if (error) {
                errorMsg = "Failed to update customer: " + error.message;
            } else {
                successMsg = "Customer details updated successfully across all past orders.";
                // If phone changed, redirect to the new phone URL
                if (oldPhone !== newPhone) {
                    return Astro.redirect(`/admin/customers/${encodeURIComponent(newPhone)}/?success=true`);
                }
            }
        } catch (e: any) {
            errorMsg = "An error occurred: " + e.message;
        }
    }
}

if (!db) {
    errorMsg = "Cloudflare D1 Database binding is missing.";
} else {
    try {
        // Fetch customer info
        const customerResult: any = await db.prepare(`
            SELECT 
                customer_phone as phone,
                MAX(customer_name) as name, 
                MAX(customer_email) as email,
                MAX(city) as city, 
                MAX(address) as address,
                SUM(CASE WHEN status != 'Cancelled' THEN total_amount ELSE 0 END) as lifetime_value,
                COUNT(id) as total_orders
            FROM orders
            WHERE customer_phone = ?
            GROUP BY customer_phone
        `).bind(phone).first();

        if (customerResult) {
            customer = customerResult;
        } else {
            errorMsg = "Customer not found.";
        }

        // Fetch customer orders
        const { results } = await db.prepare(`
            SELECT id, total_amount, status, return_status, tracking_no, created_at, city
            FROM orders
            WHERE customer_phone = ?
            ORDER BY created_at DESC
        `).bind(phone).all();
        
        orders = results || [];

    } catch (e: any) {
        errorMsg = "Database error: " + e.message;
    }
}

const url = new URL(Astro.request.url);
if (url.searchParams.get("success") === "true") {
    successMsg = "Customer details updated successfully.";
}
---

<AdminLayout title={seoTitle} activePage="customers">
    <!-- Back Button -->
    <a href="/admin/customers/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-brand-orange mb-6 font-semibold transition-colors">
        ← Back to Customers List
    </a>

    <!-- Header -->
    <div class="mb-6 md:mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-semibold text-gray-900 tracking-tight flex items-center gap-3">
                    {customer ? customer.name : phone}
                </h1>
                <p class="text-xs text-gray-400 mt-2 flex items-center gap-1.5 font-medium font-mono">{phone}</p>
            </div>
            {customer && (
                <div class="bg-brand-orange/10 border border-brand-orange/20 px-4 py-2 rounded-lg text-right">
                    <p class="text-xs font-medium text-brand-orange uppercase tracking-wider">Lifetime Value</p>
                    <p class="text-lg font-bold text-gray-900">
                        PKR {customer.lifetime_value?.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
                    </p>
                </div>
            )}
        </div>
    </div>

    {/* Error Banner */}
    {errorMsg && (
        <div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg mb-8 flex items-start gap-3 shadow-sm">
            <div class="bg-red-100 text-red-800 p-1 rounded-full shrink-0">⚠️</div>
            <div>
                <p class="font-semibold">Error Occurred</p>
                <p class="text-sm mt-0.5">{errorMsg}</p>
            </div>
        </div>
    )}

    {/* Success Banner */}
    {successMsg && (
        <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-lg mb-8 flex items-start gap-3 shadow-sm">
            <div class="bg-green-100 text-green-800 p-1 rounded-full shrink-0">✓</div>
            <div>
                <p class="font-semibold">Success</p>
                <p class="text-sm mt-0.5">{successMsg}</p>
            </div>
        </div>
    )}

    {customer && (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Edit Form -->
            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 sticky top-24">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                            <Icon name="user" class="w-5 h-5 text-gray-400" />
                            Customer Details
                        </h2>
                        <button type="button" onclick="unlockForm()" class="p-1.5 text-gray-400 hover:text-brand-orange hover:bg-orange-50 rounded transition-colors" title="Edit Details">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                        </button>
                    </div>
                    
                    <form method="POST" id="customerForm" class="space-y-4">
                        <input type="hidden" name="action" value="update_customer" />
                        <input type="hidden" name="oldPhone" value={customer.phone} />
                        
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
                            <input 
                                type="text" 
                                name="name" 
                                value={customer.name} 
                                required disabled
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition-colors disabled:bg-gray-50 disabled:text-gray-500"
                            />
                        </div>
                        
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Phone Number <span class="text-red-500">*</span></label>
                            <input 
                                type="text" 
                                name="newPhone" 
                                value={customer.phone} 
                                required disabled
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition-colors font-mono disabled:bg-gray-50 disabled:text-gray-500"
                            />
                            <p class="text-[10px] text-gray-500 mt-1">Changing this updates the phone number on all past orders.</p>
                        </div>
                        
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Email Address</label>
                            <input 
                                type="email" 
                                name="email" 
                                value={customer.email || ""} 
                                disabled
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition-colors disabled:bg-gray-50 disabled:text-gray-500"
                            />
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">City <span class="text-red-500">*</span></label>
                            <input 
                                type="text" 
                                name="city" 
                                value={customer.city} 
                                required disabled
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition-colors disabled:bg-gray-50 disabled:text-gray-500"
                            />
                        </div>
                        
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Address <span class="text-red-500">*</span></label>
                            <textarea 
                                name="address" 
                                rows="3" 
                                required disabled
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition-colors disabled:bg-gray-50 disabled:text-gray-500"
                            >{customer.address}</textarea>
                        </div>

                        <div class="pt-2 hidden" id="saveBtnContainer">
                            <button 
                                type="submit" 
                                class="w-full bg-gray-900 hover:bg-black text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors flex justify-center items-center gap-2"
                            >
                                <Icon name="save" class="w-4 h-4" /> Save Changes
                            </button>
                        </div>
                    </form>

                    <script is:inline>
                        function unlockForm() {
                            const form = document.getElementById('customerForm');
                            const inputs = form.querySelectorAll('input:not([type="hidden"]), textarea');
                            inputs.forEach(input => {
                                input.removeAttribute('disabled');
                            });
                            document.getElementById('saveBtnContainer').classList.remove('hidden');
                            
                            const firstInput = form.querySelector('input[name="name"]');
                            if(firstInput) firstInput.focus();
                        }
                    </script>
                </div>
            </div>

            <!-- Right Column: Order History -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Orders Table -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                            <Icon name="shopping-bag" class="w-5 h-5 text-gray-400" />
                            Order History ({customer.total_orders})
                        </h2>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-gray-50 text-gray-600 font-medium border-b border-gray-200">
                                <tr>
                                    <th class="px-6 py-3">Order ID</th>
                                    <th class="px-6 py-3">Date</th>
                                    <th class="px-6 py-3">Status</th>
                                    <th class="px-6 py-3">Return Status</th>
                                    <th class="px-6 py-3 text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-gray-700">
                                {orders.map((order) => (
                                    <tr class="hover:bg-gray-50 transition-colors group cursor-pointer" onclick={`window.location.href='/admin/orders/${order.id}/'`}>
                                        <td class="px-6 py-3">
                                            <div class="font-mono text-brand-orange group-hover:underline">#{order.id}</div>
                                            {order.tracking_no && <div class="text-[10px] text-gray-400 mt-0.5">Trk: {order.tracking_no}</div>}
                                        </td>
                                        <td class="px-6 py-3 text-gray-500">
                                            {new Date(order.created_at.replace(' ', 'T') + "Z").toLocaleDateString('en-PK', { year: 'numeric', month: 'short', day: 'numeric' })}
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border
                                                ${order.status === 'Pending' ? 'bg-yellow-50 text-yellow-700 border-yellow-200' : 
                                                  order.status === 'Shipped' ? 'bg-blue-50 text-blue-700 border-blue-200' : 
                                                  order.status === 'Delivered' ? 'bg-green-50 text-green-700 border-green-200' : 
                                                  order.status === 'Returned' ? 'bg-red-50 text-red-700 border-red-200' : 
                                                  'bg-gray-50 text-gray-700 border-gray-200'}`}
                                            >
                                                {order.status}
                                            </span>
                                        </td>
                                        <td class="px-6 py-3">
                                            <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border
                                                ${order.return_status === 'Pending' ? 'bg-gray-50 text-gray-600 border-gray-200' : 
                                                  order.return_status === 'RTS' ? 'bg-orange-50 text-orange-700 border-orange-200' : 
                                                  order.return_status === 'Returned' ? 'bg-red-50 text-red-700 border-red-200' : 
                                                  'bg-gray-50 text-gray-700 border-gray-200'}`}
                                            >
                                                {order.return_status}
                                            </span>
                                        </td>
                                        <td class="px-6 py-3 text-right font-medium">
                                            PKR {order.total_amount.toLocaleString()}
                                        </td>
                                    </tr>
                                ))}
                                {orders.length === 0 && (
                                    <tr>
                                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                            No orders found for this customer.
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    )}
</AdminLayout>
