---
import Icon from "./ui/Icon.astro";

interface Props {
    data: {
        feature: string;
        optionA: string; // 3.5mm
        optionB: string; // Type-C
        highlight?: "A" | "B" | "Both" | "None";
    }[];
}

const { data } = Astro.props;
---

<div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
    <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="px-6 py-4 font-bold text-gray-900 w-1/3">Feature</th>
                <th class="px-6 py-4 font-bold text-blue-600 w-1/3"
                    >3.5mm Handsfree</th
                >
                <th class="px-6 py-4 font-bold text-green-600 w-1/3"
                    >Type-C Handsfree</th
                >
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {
                data.map((row, index) => (
                    <tr
                        class:list={[
                            "hover:bg-gray-50/50 transition-colors",
                            index % 2 === 0 ? "bg-white" : "bg-gray-50/30",
                        ]}
                    >
                        <td class="px-6 py-4 font-medium text-gray-900">
                            {row.feature}
                        </td>

                        <td
                            class:list={[
                                "px-6 py-4",
                                row.highlight === "A"
                                    ? "font-semibold text-blue-700 bg-blue-50/50"
                                    : "text-gray-600",
                            ]}
                        >
                            {row.optionA}
                            {row.highlight === "A" && (
                                <Icon
                                    name="check"
                                    class="inline w-4 h-4 ml-1 text-blue-500"
                                />
                            )}
                        </td>

                        <td
                            class:list={[
                                "px-6 py-4",
                                row.highlight === "B"
                                    ? "font-semibold text-green-700 bg-green-50/50"
                                    : "text-gray-600",
                            ]}
                        >
                            {row.optionB}
                            {row.highlight === "B" && (
                                <Icon
                                    name="check"
                                    class="inline w-4 h-4 ml-1 text-green-500"
                                />
                            )}
                        </td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>
