                                <p class="font-semibold text-gray-800">No Orders Found</p>
                                <p class="text-xs text-gray-400 mt-1">There are no orders matching this tab right now.</p>
                            </td>
                        </tr>
                    ) : (
                        orders.map((order) => (
                            <tr class="hover:bg-gray-50/50 transition-colors group">
                                <td class="p-4"><input type="checkbox" class="row-checkbox rounded text-brand-orange focus:ring-brand-orange cursor-pointer" value={order.id} /></td>
                                <td class="p-4 font-semibold text-brand-orange tracking-wider" data-col="order_num">
                                    <a href={`/admin/orders/${order.id}/`} class="hover:underline">#{order.id}</a>
                                </td>
                                <td class="p-4" data-col="customer">
                                    <div class="font-medium text-gray-900">{order.customer_name}</div>
                                    <div class="text-xs text-gray-500">{order.customer_phone}</div>
                                </td>
                                <td class="p-4" data-col="tracking">
                                    {order.tracking_no ? (
                                        <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">{order.tracking_no}</span>
                                    ) : (
                                        <span class="text-xs text-gray-400 font-medium">-</span>
                                    )}
                                </td>
                                <td class="p-4 font-medium text-gray-900" data-col="amount">
                                    PKR {order.total_amount.toLocaleString()}
                                </td>
                                <td class="p-4" data-col="order_status">
                                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${getOrderBadge(order.status)}`}>
                                        {order.status}
                                    </span>
                                </td>
                                <td class="p-4" data-col="status">
                                    {currentTab === 'payments' ? (
                                        <form method="POST" class="inline-block relative">
                                            <input type="hidden" name="action" value="update_payment" />
                                            <input type="hidden" name="order_id" value={order.id} />
                                            <select 
                                                name="payment_status" 
                                                onchange="this.form.submit()" 
                                                class={`inline-flex items-center pl-3 pr-8 py-1.5 rounded-md text-xs font-semibold border focus:outline-none focus:ring-2 focus:ring-brand-orange/20 cursor-pointer appearance-none ${getPaymentBadge(order.payment_status)}`}
                                                style="background-position: right 0.4rem center; background-size: 1rem 1rem;"
                                            >
                                                <option value="Pending" selected={order.payment_status === 'Pending' || !order.payment_status}>Pending</option>
                                                <option value="Invoiced" selected={order.payment_status === 'Invoiced'}>Invoiced</option>
                                                <option value="Receiving in Bank" selected={order.payment_status === 'Receiving in Bank'}>Receiving in Bank</option>
                                                <option value="Sent to Vendor" selected={order.payment_status === 'Sent to Vendor'}>Sent to Vendor</option>
                                            </select>
                                        </form>
                                    ) : (
                                        <form method="POST" class="inline-block relative">
                                            <input type="hidden" name="action" value="update_return" />
                                            <input type="hidden" name="order_id" value={order.id} />
                                            <select 
                                                name="return_status" 
                                                onchange="this.form.submit()" 
                                                class={`inline-flex items-center pl-3 pr-8 py-1.5 rounded-md text-xs font-semibold border focus:outline-none focus:ring-2 focus:ring-brand-orange/20 cursor-pointer appearance-none ${getReturnBadge(order.return_status)}`}
                                                style="background-position: right 0.4rem center; background-size: 1rem 1rem;"
                                            >
                                                <option value="Pending" selected={order.return_status === 'Pending' || !order.return_status}>Pending</option>
                                                <option value="Received" selected={order.return_status === 'Received'}>Received</option>
                                            </select>
                                        </form>
                                    )}
                                </td>
                                <td class="p-4" data-col="summary">
                                    <div class="text-[11px] text-gray-500 font-medium whitespace-pre-wrap leading-relaxed max-w-[150px]">
                                        {order.items_summary}
                                    </div>
                                </td>
                                <td class="p-4" data-col="notes">
                                    <form method="POST" class="flex gap-2">
                                        <input type="hidden" name="action" value="update_notes" />
                                        <input type="hidden" name="order_id" value={order.id} />
                                        <input 
                                            type="text" 
                                            name="tracking_notes" 
                                            value={order.tracking_notes || ""} 
                                            placeholder="Add notes..."
                                            class="flex-1 w-full text-xs px-2.5 py-1.5 border border-transparent bg-gray-50 hover:border-gray-300 focus:bg-white focus:border-brand-orange focus:ring-1 focus:ring-brand-orange rounded transition-all"
                                            onblur="if(this.value !== this.defaultValue) this.form.submit()"
                                        />
                                        <button type="submit" class="hidden">Save</button>
                                    </form>
                                </td>
                            </tr>
                        ))
                    )}
                </tbody>
            </table>
        </div>
        
        {totalItems > 0 && (
            <Pagination 
                currentPage={page} 
                totalPages={totalPages} 
                totalItems={totalItems}
                limit={limit} 
            />
        )}
    </div>

    <!-- Bulk Action Bar -->
    <div id="bulkActionBar" class="fixed bottom-0 left-0 right-0 md:left-64 bg-white border-t border-gray-200 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)] p-4 flex items-center justify-between z-50 transform translate-y-full transition-transform duration-300">
        <div class="flex items-center gap-4">
            <span class="bg-brand-orange text-white font-bold px-3 py-1 rounded-full text-sm"><span id="selectedCount">0</span> Selected</span>
            <span class="text-sm text-gray-500 font-medium hidden sm:inline">Bulk Actions:</span>
        </div>
        
        <form method="POST" id="bulkForm" class="flex items-center gap-3">
            <input type="hidden" name="action" id="bulkActionType" value="" />
            <input type="hidden" name="order_ids" id="bulkOrderIds" value="" />
            
            {currentTab === 'payments' ? (
                <>
                    <select name="payment_status" class="text-sm border-gray-300 rounded-md focus:ring-brand-orange focus:border-brand-orange py-2 pl-3 pr-8 appearance-none" required style="background-position: right 0.4rem center; background-size: 1rem 1rem;">
                        <option value="" disabled selected>Select Status...</option>
                        <option value="Pending">Pending</option>
                        <option value="Invoiced">Invoiced</option>
                        <option value="Receiving in Bank">Receiving in Bank</option>
                        <option value="Sent to Vendor">Sent to Vendor</option>
                    </select>
                    <button type="button" onclick="submitBulk('bulk_update_payment')" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-black transition-colors">Apply</button>
                </>
            ) : (
                <>
                    <select name="return_status" class="text-sm border-gray-300 rounded-md focus:ring-brand-orange focus:border-brand-orange py-2 pl-3 pr-8 appearance-none" required style="background-position: right 0.4rem center; background-size: 1rem 1rem;">
                        <option value="" disabled selected>Select Status...</option>
                        <option value="Pending">Pending</option>
                        <option value="Received">Received</option>
                    </select>
                    <button type="button" onclick="submitBulk('bulk_update_return')" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-black transition-colors">Apply</button>
                </>
            )}
        </form>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const selectAll = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulkActionBar');
            const selectedCount = document.getElementById('selectedCount');
            const bulkOrderIds = document.getElementById('bulkOrderIds');
            const bulkActionType = document.getElementById('bulkActionType');
            const bulkForm = document.getElementById('bulkForm');
            const periodSelect = document.getElementById('period-select');
            const customDateInputs = document.getElementById('custom-date-inputs');

            if (periodSelect && customDateInputs) {
                periodSelect.addEventListener('change', (e) => {
                    if (e.target.value === 'custom') {
                        customDateInputs.classList.remove('hidden');
                        customDateInputs.classList.add('flex');
                        customDateInputs.querySelectorAll('input').forEach(i => i.required = true);
                    } else {
                        customDateInputs.classList.add('hidden');
                        customDateInputs.classList.remove('flex');
                        customDateInputs.querySelectorAll('input').forEach(i => i.required = false);
                        e.target.form.submit();
                    }
                });
            }

            function updateBulkActionUI() {
                const selected = Array.from(rowCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
                if (selected.length > 0) {
                    bulkActionBar.classList.remove('translate-y-full');
                    bulkActionBar.classList.add('translate-y-0');
                    selectedCount.textContent = selected.length;
                    bulkOrderIds.value = selected.join(',');
                } else {
                    bulkActionBar.classList.add('translate-y-full');
                    bulkActionBar.classList.remove('translate-y-0');
                }
                
                if (selectAll && rowCheckboxes.length > 0) {
                    selectAll.checked = selected.length === rowCheckboxes.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', (e) => {
                    rowCheckboxes.forEach(cb => cb.checked = e.target.checked);
                    updateBulkActionUI();
                });
            }

            rowCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkActionUI);
            });

            window.submitBulk = function(actionType) {
                bulkActionType.value = actionType;
                const selectEl = bulkForm.querySelector('select');
                if (!selectEl.value) {
                    alert('Please select a status to apply.');
                    return;
                }
                bulkForm.submit();
            }
        });
    </script>
</AdminLayout>
