---
interface Props {
    title: string;
    tagline?: string;
}

const { title, tagline } = Astro.props;
---

<section
    class="bg-gradient-to-r from-gray-900 to-gray-800 py-16 relative overflow-hidden"
>
    <!-- Brand Color Glow/Accent -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-4xl opacity-20 pointer-events-none"
    >
        <div
            class="absolute inset-0 bg-gradient-to-b from-brand-orange to-transparent blur-3xl"
        >
        </div>
    </div>

    <div class="container mx-auto px-4 max-w-4xl relative z-10 text-center">
        <h1
            class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight"
        >
            {title}
        </h1>
        {
            tagline && (
                <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
                    {tagline}
                </p>
            )
        }
    </div>
</section>
