import Icon from "./ui/Icon.astro";
import { actions } from "astro:actions";

interface Review {
    rating: number;
    title: string;
    text: string;
    author: string;
    location: string;
}

interface Props {
    productId?: number;
    title?: string;
    reviews: Review[];
    bgClass?: string;
    totalCount?: number;
    rating?: number;
}

const {
    productId,
    title = "What Our Customers Say",
    reviews = [],
    bgClass = "bg-slate-50",
    totalCount,
    rating = 4.8,
} = Astro.props;

// Calculate stats
const totalReviews = totalCount || reviews.length;
const averageRating = (rating || 4.8).toFixed(1);

// Generate mathematically authentic, realistic star distribution breakdown
function getNaturalBreakdown(R: number, N: number) {
    if (N <= 0) {
        return {
            counts: [0, 0, 0, 0, 0],
            percentages: [0, 0, 0, 0, 0]
        };
    }
    
    // Calculate standard deviation based on R (lower rating = more spread)
    const sigma = 0.45 + 0.15 * (5 - R);
    
    // Compute ideal weights using a Gaussian distribution + small organic baseline noise
    let idealProps = [];
    let sumWeights = 0;
    for (let i = 1; i <= 5; i++) {
        const diff = i - R;
        const gaussian = Math.exp(-(diff * diff) / (2 * sigma * sigma));
        
        let noise = 0.01;
        if (i === 5) noise = 0.04; // slightly boost 5 stars
        if (i === 4) noise = 0.02; // slightly boost 4 stars
        if (i === 1 && R > 4.2) noise = 0.002; // 1-star is very rare for top products
        
        const w = gaussian + noise;
        idealProps.push(w);
        sumWeights += w;
    }
    
    // Ideal proportions
    idealProps = idealProps.map(w => w / sumWeights);
    
    // Initialize counts using these ideal proportions
    let counts = idealProps.map(p => Math.round(p * N));
    
    // First, adjust the counts so they sum EXACTLY to N
    let currentSum = counts.reduce((a, b) => a + b, 0);
    let diff = N - currentSum;
    if (diff !== 0) {
        const step = diff > 0 ? 1 : -1;
        const absDiff = Math.abs(diff);
        for (let k = 0; k < absDiff; k++) {
            let bestIndex = -1;
            let minErr = Infinity;
            for (let i = 0; i < 5; i++) {
                if (step < 0 && counts[i] <= 0) continue;
                let tempCounts = [...counts];
                tempCounts[i] += step;
                let err = 0;
                for (let j = 0; j < 5; j++) {
                    const pCurrent = tempCounts[j] / N;
                    err += Math.pow(pCurrent - idealProps[j], 2);
                }
                if (err < minErr) {
                    minErr = err;
                    bestIndex = i;
                }
            }
            if (bestIndex !== -1) {
                counts[bestIndex] += step;
            }
        }
    }
    
    // Now, balance the rating score so the average is EXACTLY R (or as close as possible)
    const targetScoreSum = Math.round(R * N);
    let currentScoreSum = counts.reduce((sum, count, idx) => sum + count * (idx + 1), 0);
    
    let scoreDiff = targetScoreSum - currentScoreSum;
    
    const maxIterations = 500;
    let iterations = 0;
    while (scoreDiff !== 0 && iterations < maxIterations) {
        iterations++;
        const step = scoreDiff > 0 ? 1 : -1;
        let bestShift = null;
        let minErr = Infinity;
        
        for (let i = 0; i < 5; i++) {
            if (counts[i] <= 0) continue;
            const targetIdx = i + step;
            if (targetIdx < 0 || targetIdx > 4) continue;
            
            let tempCounts = [...counts];
            tempCounts[i] -= 1;
            tempCounts[targetIdx] += 1;
            
            let err = 0;
            for (let j = 0; j < 5; j++) {
                const pCurrent = tempCounts[j] / N;
                err += Math.pow(pCurrent - idealProps[j], 2);
            }
            if (err < minErr) {
                minErr = err;
                bestShift = { fromIdx: i, toIdx: targetIdx };
            }
        }
        
        if (bestShift) {
            counts[bestShift.fromIdx] -= 1;
            counts[bestShift.toIdx] += 1;
            scoreDiff -= step;
        } else {
            break;
        }
    }
    
    // Recalculate final percentages based on balanced counts
    let percentages = counts.map(c => Math.round((c / N) * 100));
    
    let percentSum = percentages.reduce((a, b) => a + b, 0);
    let percentDiff = 100 - percentSum;
    if (percentDiff !== 0) {
        const maxIdx = percentages.indexOf(Math.max(...percentages));
        if (maxIdx !== -1) {
            percentages[maxIdx] += percentDiff;
        }
    }
    
    return { counts, percentages };
}

const { counts: starCounts, percentages: starPercentages } = getNaturalBreakdown(Number(averageRating), totalReviews);

const displayedReviews = reviews.slice(0, 6);

// Helper function to format date nicely
function getFormattedDate(review: any, index: number) {
    if (review.created_at) {
        try {
            const d = new Date(review.created_at);
            return d.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric"
            });
        } catch(e) {
            // fallback below
        }
    }
    // Static fallback dates matching the design screenshot
    // index 0 -> May 30, 2026
    // index 1 -> May 29, 2026
    // index 2 -> May 28, 2026
    // etc.
    const baseDate = new Date(2026, 4, 30); // May 30, 2026
    baseDate.setDate(baseDate.getDate() - index);
    return baseDate.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
    });
}

// Helper to get beautiful, premium background/text colors for initials deterministically
function getAvatarStyle(name: string) {
    const colors = [
        { bg: "bg-amber-100", text: "text-amber-800" },
        { bg: "bg-blue-100", text: "text-blue-800" },
        { bg: "bg-emerald-100", text: "text-emerald-800" },
        { bg: "bg-indigo-100", text: "text-indigo-800" },
        { bg: "bg-rose-100", text: "text-rose-800" },
        { bg: "bg-purple-100", text: "text-purple-800" }
    ];
    let hash = 0;
    const cleanName = name || "Anonymous";
    for (let i = 0; i < cleanName.length; i++) {
        hash = cleanName.charCodeAt(i) + ((hash << 5) - hash);
    }
    const index = Math.abs(hash) % colors.length;
    return colors[index];
}

// Helper to get initials
function getInitials(name: string) {
    if (!name) return "?";
    const parts = name.trim().split(/\s+/);
    if (parts.length >= 2) {
        return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
    }
    return parts[0].substring(0, 2).toUpperCase();
}
---

<section class={`py-16 lg:py-20 ${bgClass} transition-colors duration-300`}>
    <div class="container mx-auto px-4 max-w-6xl">
        {/* Section Header */}
        <div class="text-center mb-8 lg:mb-16">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-4 tracking-tight">{title}</h2>
            <p class="text-gray-500 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
                Real feedback from verified buyers across Pakistan. We are committed to showing 100% genuine experiences.
            </p>
        </div>

        {/* Two-Column Layout */}
        <div class="grid lg:grid-cols-3 gap-12 items-start relative">
            {/* Left Column: Sticky Rating Summary Card */}
            <div class="lg:col-span-1 lg:sticky lg:top-28 bg-white border border-slate-100 rounded-xl p-6 sm:p-8 shadow-sm">
                <h3 class="text-xl font-semibold text-gray-900 mb-4">Client Reviews</h3>
                
                {/* Average Rating Block */}
                <div class="flex items-center gap-3 mb-6">
                    <span class="text-5xl font-extrabold text-gray-900 leading-none tracking-tight">{averageRating}</span>
                    <div>
                        <div class="flex text-[#FFC107] mb-1">
                            {Array.from({ length: 5 }).map((_, i) => (
                                <Icon
                                    name="star"
                                    class={`w-4.5 h-4.5 ${i < Math.round(Number(averageRating)) ? "fill-current text-[#FFC107]" : "text-gray-300"}`}
                                />
                            ))}
                        </div>
                        <span class="text-xs text-gray-500 font-medium">Based on {totalReviews} reviews</span>
                    </div>
                </div>

                {/* Rating Distribution Bars */}
                <div class="space-y-2.5 mb-8">
                    {[5, 4, 3, 2, 1].map((star) => {
                        const percentage = starPercentages[star - 1];
                        return (
                            <div class="flex items-center text-sm">
                                <span class="w-3 text-gray-500 font-semibold mr-2">{star}</span>
                                <Icon name="star" class="w-3.5 h-3.5 text-[#FFC107] fill-current mr-2.5" />
                                <div class="flex-1 h-2 bg-gray-200/70 rounded-full overflow-hidden">
                                    <div class="h-full bg-[#FFC107] rounded-full transition-all duration-500" style={`width: ${percentage}%`}></div>
                                </div>
                                <span class="w-8 text-right text-xs text-gray-500 font-semibold ml-3">{percentage}%</span>
                            </div>
                        );
                    })}
                </div>

                {/* CTA / Action Block */}
                {productId && (
                    <div class="border-t border-gray-200/60 pt-6">
                        <p class="font-semibold text-gray-900 mb-2 text-base">We value your opinion</p>
                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed mb-6">
                            Your honest feedback helps thousands of shoppers make the right decision. Let us know how your experience was!
                        </p>
                        <button
                            id="toggle-review-form-btn"
                            class="w-full py-3.5 px-6 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-xl text-sm transition-all duration-300 shadow-md flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
                        >
                            <span id="cta-btn-text">Write a review</span>
                        </button>
                    </div>
                )}
            </div>

            {/* Right Column: Reviews List OR Submission Form */}
            <div class="lg:col-span-2 relative min-h-[350px]">
                {/* 1. Reviews List */}
                <div id="reviews-list-container" class="space-y-8 transition-opacity duration-300">
                    <p class="text-sm font-bold tracking-wider text-gray-900 uppercase mb-8">{totalReviews} REVIEWS</p>
                    
                    {displayedReviews.length > 0 ? (
                        displayedReviews.map((review, index) => (
                            <div class="grid grid-cols-[auto_1fr] gap-x-3 sm:gap-x-4 gap-y-2 border-b border-slate-200 pb-8 last:border-b-0 last:pb-0">
                                {/* Circular Avatar with beautiful deterministic initials */}
                                {(() => {
                                    const avatarColor = getAvatarStyle(review.author);
                                    const initials = getInitials(review.author);
                                    return (
                                        <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-full shrink-0 flex items-center justify-center font-bold text-sm tracking-wider select-none mt-1 md:mt-0 ${avatarColor.bg} ${avatarColor.text}`}>
                                            {initials}
                                        </div>
                                    );
                                })()}
                                
                                {/* Top Metadata & Stars Row */}
                                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                                    {/* Left aligned: Name | City | Verified Buyer */}
                                    <div class="flex items-center flex-wrap text-sm gap-2 text-gray-500 font-medium">
                                        <span class="font-semibold text-gray-900">{review.author}</span>
                                        <span class="text-gray-300">|</span>
                                        <span>{review.location || "Pakistan"}</span>
                                        <span class="text-gray-300 hidden sm:inline">|</span>
                                        <span class="hidden sm:inline-flex items-center gap-1 text-[10px] font-bold text-white bg-gradient-to-r from-emerald-700 to-emerald-800 px-2.5 py-1 rounded-full shadow-sm shadow-emerald-700/20 uppercase tracking-wider">
                                            <Icon name="check" class="w-2.5 h-2.5" /> Verified Buyer
                                        </span>
                                    </div>
                                    
                                    {/* Right aligned: Stars & Mobile Badge */}
                                    <div class="flex items-center shrink-0">
                                        <div class="flex items-center gap-0.5 text-[#FFC107]">
                                            {Array.from({ length: 5 }).map((_, i) => (
                                                <Icon
                                                    name="star"
                                                    class={`w-4 h-4 ${i < Math.round(review.rating) ? "text-[#FFC107] fill-current" : "text-gray-300"}`}
                                                />
                                            ))}
                                        </div>
                                        <span class="sm:hidden ml-3 inline-flex items-center gap-1 text-[10px] font-bold text-white bg-gradient-to-r from-emerald-700 to-emerald-800 px-2.5 py-1 rounded-full shadow-sm shadow-emerald-700/20 uppercase tracking-wider">
                                            <Icon name="check" class="w-2.5 h-2.5" /> Verified Buyer
                                        </span>
                                    </div>
                                </div>
                                
                                {/* Review Comment Details */}
                                <div class="col-span-2 md:col-span-1 md:col-start-2 mt-2 md:mt-0">
                                    {review.title && (
                                        <h4 class="text-sm font-semibold text-gray-900 mb-1">{review.title}</h4>
                                    )}
                                    <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
                                        "{review.text}"
                                    </p>
                                </div>
                            </div>
                        ))
                    ) : (
                        <div class="text-center py-12 bg-white rounded-xl border border-dashed border-gray-200">
                            <Icon name="message-circle" class="w-8 h-8 text-gray-400 mx-auto mb-3" />
                            <p class="text-gray-500 text-sm font-medium">No reviews yet. Be the first to write one!</p>
                        </div>
                    )}
                </div>

                {/* 2. Review Submission Form (Hidden by default) */}
                {productId && (
                    <div id="review-form-container" class="hidden transition-opacity duration-300">
                        <h3 class="text-2xl font-semibold text-gray-900 mb-2">Share Your Experience</h3>
                        <p class="text-gray-500 text-sm mb-6">Your feedback helps thousands of shoppers across Pakistan make better choices.</p>

                        <form id="review-submission-form" class="space-y-6">
                            <input type="hidden" name="productId" value={productId} />

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Full Name</label>
                                    <input
                                        type="text"
                                        name="author"
                                        required
                                        placeholder="e.g. Muhammad Ali"
                                        class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all text-sm text-gray-900 shadow-sm"
                                    />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">City / Location</label>
                                    <input
                                        type="text"
                                        name="location"
                                        required
                                        placeholder="e.g. Lahore"
                                        class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all text-sm text-gray-900 shadow-sm"
                                    />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Your Rating</label>
                                <div class="flex items-center gap-2">
                                    <div class="flex flex-row-reverse justify-end gap-1">
                                        {[5, 4, 3, 2, 1].map((num) => (
                                            <button
                                                type="button"
                                                class="star-btn w-8 h-8 text-gray-300 hover:text-[#FFC107] transition-colors cursor-pointer"
                                                data-val={num}
                                            >
                                                <Icon name="star" class="w-8 h-8 fill-current" />
                                            </button>
                                        ))}
                                    </div>
                                    <input type="hidden" name="rating" id="review-rating" value="5" />
                                    <span id="rating-label" class="text-sm font-semibold text-gray-700 ml-2">Excellent (5/5)</span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Review Title</label>
                                <input
                                    type="text"
                                    name="title"
                                    required
                                    placeholder="Summarize your experience..."
                                    class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all text-sm text-gray-900 shadow-sm"
                                />
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Detailed Comments</label>
                                <textarea
                                    name="text"
                                    rows="4"
                                    required
                                    placeholder="What did you like or dislike? How is the sound quality and bass?"
                                    class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all text-sm text-gray-900 shadow-sm"
                                ></textarea>
                            </div>

                            <div id="review-message" class="hidden text-sm rounded-xl p-4"></div>

                            <div class="flex justify-start">
                                <button
                                    type="submit"
                                    id="submit-review-btn"
                                    class="px-8 py-3.5 bg-brand-orange text-white font-semibold rounded-xl hover:bg-brand-orange/95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer"
                                >
                                    Submit Review
                                </button>
                            </div>
                        </form>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>

<script>
    import { actions } from "astro:actions";

    // 1. Toggle Review Form Logic
    const toggleBtn = document.getElementById("toggle-review-form-btn");
    const ctaBtnText = document.getElementById("cta-btn-text");
    const listContainer = document.getElementById("reviews-list-container");
    const formContainer = document.getElementById("review-form-container");

    if (toggleBtn && listContainer && formContainer) {
        toggleBtn.addEventListener("click", () => {
            const isFormVisible = !formContainer.classList.contains("hidden");
            if (isFormVisible) {
                // Form is visible -> hide it, show reviews list
                formContainer.classList.add("hidden");
                listContainer.classList.remove("hidden");
                if (ctaBtnText) ctaBtnText.textContent = "Write a review";
                toggleBtn.classList.remove("bg-brand-orange", "hover:bg-brand-orange/90");
                toggleBtn.classList.add("bg-gray-900", "hover:bg-gray-800");
                // Scroll back to top of review section smoothly
                listContainer.scrollIntoView({ behavior: "smooth", block: "nearest" });
            } else {
                // Form is hidden -> show it, hide reviews list
                formContainer.classList.remove("hidden");
                listContainer.classList.add("hidden");
                if (ctaBtnText) ctaBtnText.textContent = "View Reviews";
                toggleBtn.classList.remove("bg-gray-900", "hover:bg-gray-800");
                toggleBtn.classList.add("bg-brand-orange", "hover:bg-brand-orange/90");
                // Scroll to form container smoothly
                formContainer.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
        });
    }

    // 2. Star Rating Selector Logic
    const starBtns = document.querySelectorAll(".star-btn");
    const ratingInput = document.getElementById("review-rating") as HTMLInputElement;
    const ratingLabel = document.getElementById("rating-label");
    const form = document.getElementById("review-submission-form") as HTMLFormElement;
    const msg = document.getElementById("review-message");
    const submitBtn = document.getElementById("submit-review-btn") as HTMLButtonElement;

    const ratingTexts: Record<number, string> = {
        1: "Terrible (1/5)",
        2: "Poor (2/5)",
        3: "Average (3/5)",
        4: "Good (4/5)",
        5: "Excellent (5/5)"
    };

    function updateStars(val: number) {
        if (!ratingInput) return;
        ratingInput.value = String(val);
        if (ratingLabel) {
            ratingLabel.textContent = ratingTexts[val];
        }

        starBtns.forEach(btn => {
            const btnVal = Number(btn.getAttribute("data-val"));
            if (btnVal <= val) {
                btn.classList.add("text-[#FFC107]");
                btn.classList.remove("text-gray-300");
            } else {
                btn.classList.add("text-gray-300");
                btn.classList.remove("text-[#FFC107]");
            }
        });
    }

    // Initialize with 5 stars
    updateStars(5);

    starBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            const val = Number(btn.getAttribute("data-val"));
            updateStars(val);
        });

        // Hover support
        btn.addEventListener("mouseenter", () => {
            const val = Number(btn.getAttribute("data-val"));
            starBtns.forEach(b => {
                const bVal = Number(b.getAttribute("data-val"));
                if (bVal <= val) {
                    b.classList.add("text-[#FFC107]");
                    b.classList.remove("text-gray-300");
                } else {
                    b.classList.add("text-gray-300");
                    b.classList.remove("text-[#FFC107]");
                }
            });
        });
    });

    const ratingContainer = document.querySelector(".flex-row-reverse");
    ratingContainer?.addEventListener("mouseleave", () => {
        const currentVal = Number(ratingInput?.value || 5);
        updateStars(currentVal);
    });

    // 3. Form Submission Logic
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn || !msg) return;

        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting Review...";

        try {
            const formData = new FormData(form);
            const { data, error } = await actions.submitReview(formData);

            if (error) {
                msg.className = "text-sm rounded-xl p-4 bg-red-50 text-red-700 border border-red-100";
                msg.textContent = error.message || "Failed to submit review. Please try again.";
                msg.classList.remove("hidden");
                submitBtn.disabled = false;
                submitBtn.textContent = "Submit Review";
            } else {
                msg.className = "text-sm rounded-xl p-4 bg-green-50 text-green-700 border border-green-100";
                msg.textContent = "Thank you! Your review has been submitted successfully.";
                msg.classList.remove("hidden");
                form.reset();
                updateStars(5);
                submitBtn.textContent = "Review Submitted!";
                setTimeout(() => {
                    location.reload(); // Reload to show the new review in real-time
                }, 1500);
            }
        } catch (err: any) {
            msg.className = "text-sm rounded-xl p-4 bg-red-50 text-red-700 border border-red-100";
            msg.textContent = "An unexpected error occurred.";
            msg.classList.remove("hidden");
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit Review";
        }
    });
</script>
