                            <tbody class="divide-y divide-gray-50">
                                {oldestPendingPayments.length === 0 ? (
                                    <tr>
                                        <td colspan="4" class="p-6 text-center text-gray-400">No overdue pending invoices. Great job!</td>
                                    </tr>
                                ) : (
                                    oldestPendingPayments.map(op => (
                                        <tr class="hover:bg-gray-50/50">
                                            <td class="py-2.5 px-4 font-bold text-brand-orange">
                                                <a href={`/admin/orders/${op.id}/`} class="hover:underline">#{op.id}</a>
                                            </td>
                                            <td class="py-2.5 px-4 text-gray-600">{new Date(op.delivered_date).toISOString().split('T')[0]}</td>
                                            <td class="py-2.5 px-4">
                                                <span class="bg-rose-50 text-rose-700 px-2 py-0.5 rounded font-bold border border-rose-100">
                                                    {op.days_old} Days
                                                </span>
                                            </td>
                                            <td class="py-2.5 px-4 text-right font-semibold text-gray-900">PKR {op.total_amount.toLocaleString()}</td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    ) : (
        <div class="mb-6 space-y-6">
            <!-- Return Financial & Volume KPI Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white border-2 border-rose-400 p-4 rounded-xl shadow-sm flex flex-col justify-center relative overflow-hidden bg-rose-50/20">
                    <div class="flex items-center justify-between mb-1">
                        <p class="text-xs font-bold text-rose-600 uppercase tracking-wider">Pending Pickup</p>
                        <span class="text-[10px] font-bold bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded border border-rose-200">
                            {pendingPieces} Pcs
                        </span>
                    </div>
                    <p class="text-2xl font-bold text-gray-900">{returnKpis.pending} <span class="text-xs text-gray-400 font-normal">Orders</span></p>
                    <p class="text-sm font-bold text-rose-600 mt-1">PKR {returnKpis.pending_value.toLocaleString()}</p>
                </div>
                <div class="bg-white border border-emerald-200 p-4 rounded-xl shadow-sm flex flex-col justify-center">
                    <div class="flex items-center justify-between mb-1">
                        <p class="text-xs font-semibold text-emerald-500 uppercase tracking-wider">Received Back</p>
                        <span class="text-[10px] font-bold bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded border border-emerald-200">
                            {receivedPieces} Pcs
                        </span>
                    </div>
                    <p class="text-2xl font-bold text-gray-900">{returnKpis.received} <span class="text-xs text-gray-400 font-normal">Orders</span></p>
                    <p class="text-sm font-semibold text-emerald-600 mt-1">PKR {returnKpis.received_value.toLocaleString()}</p>
                </div>
                <div class="bg-white border border-gray-200 p-4 rounded-xl shadow-sm flex flex-col justify-center">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Total Return Pipeline</p>
                    <p class="text-2xl font-bold text-gray-900">{returnKpis.pending + returnKpis.received} <span class="text-xs text-gray-400 font-normal">Orders</span></p>
                    <p class="text-sm font-semibold text-gray-700 mt-1">PKR {returnKpis.total_value.toLocaleString()} <span class="text-xs font-normal text-gray-500">locked</span></p>
                </div>
                <div class="bg-gradient-to-br from-gray-900 to-gray-800 text-white p-4 rounded-xl shadow-sm flex flex-col justify-center">
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Pieces</p>
                    <p class="text-2xl font-bold text-brand-orange">{totalPieces} <span class="text-xs text-gray-300 font-normal">Pieces</span></p>
                    <p class="text-xs text-gray-300 mt-1">Pending: <span class="font-bold text-rose-300">{pendingPieces} pcs</span> · Received: <span class="font-bold text-emerald-300">{receivedPieces} pcs</span></p>
                </div>
            </div>

            <!-- Analytics Split: Returned Product Pieces Breakdown & Oldest Pending Returns -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Returned Product Breakdown (Which items are returning and how many pieces) -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
                    <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50/70 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <Icon name="package" class="w-4 h-4 text-rose-500" />
                            <h3 class="font-bold text-gray-800 text-sm">Returned Pieces by Product</h3>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[11px] font-bold bg-rose-50 border border-rose-200 px-2 py-0.5 rounded text-rose-700">
                                {pendingPieces} Pcs Pending
                            </span>
                            <span class="text-[11px] font-medium bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded text-emerald-700">
                                {receivedPieces} Pcs Received
                            </span>
                        </div>
                    </div>
                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="text-gray-400 uppercase bg-white border-b border-gray-50">
