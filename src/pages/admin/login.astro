---
import { loginUser } from "../../utils/auth";

const db = (Astro.locals as any).runtime?.env?.DB;

let errorMsg = "";
let isLoading = false;

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString().trim() || "";
    const password = formData.get("password")?.toString() || "";
    const remember = formData.get("remember") === "on";

    if (!email || !password) {
        errorMsg = "Please enter both email and password.";
    } else if (!db) {
        errorMsg = "Database connection unavailable. Please try again.";
    } else {
        const sessionId = await loginUser(db, email, password);
        if (sessionId) {
            Astro.cookies.set("gionee_admin_session", sessionId, {
                path: "/",
                httpOnly: true,
                secure: true,
                sameSite: "lax",
                ...(remember ? { maxAge: 60 * 60 * 24 * 30 } : {})
            });
            return Astro.redirect("/admin/dashboard/");
        } else {
            errorMsg = "Invalid email or password. Please try again.";
        }
    }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Dior Pakistan</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Lato', 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            position: relative;
            overflow: hidden;
        }

        /* Animated background gradient orbs */
        body::before {
            content: '';
            position: fixed;
            top: -30%;
            left: -20%;
            width: 60%;
            height: 60%;
            border-radius: 50%;
            animation: orb1 8s ease-in-out infinite alternate;
            background: radial-gradient(circle, rgba(2, 39, 79, 0.20) 0%, transparent 70%);
        }
        body::after {
            content: '';
            position: fixed;
            bottom: -30%;
            right: -20%;
            width: 70%;
            height: 70%;
            background: radial-gradient(circle, rgba(2, 39, 79, 0.16) 0%, transparent 70%);
            border-radius: 50%;
            animation: orb2 10s ease-in-out infinite alternate;
            pointer-events: none;
        }
        @keyframes orb1 { from { transform: translate(0, 0) scale(1); } to { transform: translate(5%, 5%) scale(1.1); } }
        @keyframes orb2 { from { transform: translate(0, 0) scale(1); } to { transform: translate(-5%, -5%) scale(1.15); } }

        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
            padding: 1.5rem;
        }

        /* Card */
        .login-card {
            background: rgba(255,255,255,0.95);
            border: 1px solid #f1f5f9;
            border-radius: 1rem;
            padding: 2.5rem;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
        }

        /* Logo area */
        .logo-area {
            text-align: center;
            margin-bottom: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .logo-image {
            height: 48px;
            width: auto;
            margin-bottom: 1rem;
            filter: drop-shadow(0 4px 6px rgba(2, 39, 79, 0.08));
        }
        .logo-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #111827;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }
        .logo-subtitle {
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 0.25rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* Checkbox */
        .remember-me { margin-top: -0.5rem; margin-bottom: 1.5rem; }
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: #4b5563;
            cursor: pointer;
            text-transform: none;
            letter-spacing: normal;
            font-weight: 500;
        }
        .checkbox-label input {
            accent-color: #02274F;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        /* Form */
        .form-group {
            margin-bottom: 1.25rem;
        }
        label {
            display: block;
            font-size: 0.78rem;
            font-weight: 600;
            color: #4b5563;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .input-wrapper {
            position: relative;
        }
        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: #9ca3af;
        }
        .input-icon svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 0.85rem 1rem 0.85rem 2.75rem;
            background: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 0.75rem;
            color: #111827;
            font-size: 0.9rem;
            font-family: 'Lato', 'Inter', sans-serif;
            transition: all 0.2s ease;
            outline: none;
        }
        input::placeholder { color: #9ca3af; }
        input:focus {
            border-color: #02274F;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(2, 39, 79, 0.15);
        }

        /* Error message */
        .error-banner {
            background: rgba(225, 29, 72, 0.1);
            border: 1px solid rgba(225, 29, 72, 0.2);
            border-radius: 0.75rem;
            padding: 0.85rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1.25rem;
            animation: fadeSlideIn 0.3s ease;
        }
        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .error-icon { font-size: 1rem; flex-shrink: 0; }
        .error-text { font-size: 0.84rem; color: #be123c; font-weight: 500; }

        /* Submit button */
        .submit-btn {
            width: 100%;
            padding: 0.9rem 1rem;
            background: #02274F;
            border: none;
            border-radius: 0.75rem;
            color: white;
            font-size: 0.95rem;
            font-weight: 700;
            font-family: 'Lato', 'Inter', sans-serif;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 0.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(2, 39, 79, 0.25);
            letter-spacing: 0.01em;
        }
        .submit-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            opacity: 0;
            transition: opacity 0.2s ease;
        }
        .submit-btn:hover {
            transform: translateY(-1px);
            background: #011d3b;
            box-shadow: 0 8px 24px rgba(2, 39, 79, 0.35);
        }
        .submit-btn:hover::before { opacity: 1; }
        .submit-btn:active { transform: translateY(0); }
        .submit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }



        /* Loading spinner */
        .spinner {
            display: none;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            margin-right: 0.5rem;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-content { display: flex; align-items: center; justify-content: center; gap: 0.4rem; }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Logo -->
            <div class="logo-area">
                <img src="/logo.png" alt="Dior Pakistan" class="logo-image" />
                <div class="logo-subtitle">Admin Panel</div>
            </div>

            <!-- Error Banner -->
            {errorMsg && (
                <div class="error-banner">
                    <span class="error-icon">⚠️</span>
                    <span class="error-text">{errorMsg}</span>
                </div>
            )}

            <!-- Login Form -->
            <form method="POST" id="login-form" autocomplete="on">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </span>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            autocomplete="email"
                        />
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            autocomplete="current-password"
                        />
                    </div>
                </div>

                <div class="form-group remember-me">
                    <label class="checkbox-label">
                        <input type="checkbox" name="remember" id="remember" checked />
                        Keep me logged in
                    </label>
                </div>

                <button type="submit" class="submit-btn" id="submit-btn">
                    <div class="btn-content">
                        <div class="spinner" id="spinner"></div>
                        <span id="btn-text">Sign In to Admin</span>
                    </div>
                </button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('login-form')?.addEventListener('submit', function() {
            const btn = document.getElementById('submit-btn') as HTMLButtonElement;
            const spinner = document.getElementById('spinner') as HTMLElement;
            const btnText = document.getElementById('btn-text') as HTMLElement;
            if (btn) btn.disabled = true;
            if (spinner) spinner.style.display = 'block';
            if (btnText) btnText.textContent = 'Signing in…';
        });
    </script>
</body>
</html>
